+const looped_config =
+    \\{"model_type": "sensenova_loop", "tie_word_embeddings": true,
+    \\ "quantization": {"group_size": 32, "bits": 4, "mode": "affine"},
+    \\ "loop_settings": {"start": 0, "end": 2, "eval_count": 2, "counts": [2]},
+    \\ "mhc": {"start": 0, "end": 2, "streams": 2, "iterations": 2},
+    \\ "text_config": {"hidden_size": 64, "intermediate_size": 32, "num_hidden_layers": 2,
+    \\  "num_attention_heads": 2, "num_key_value_heads": 1, "head_dim": 32, "linear_num_key_heads": 1,
+    \\  "linear_num_value_heads": 2, "linear_key_head_dim": 32, "linear_value_head_dim": 16,
+    \\  "linear_conv_kernel_dim": 4, "vocab_size": 16, "full_attention_interval": 2,
+    \\  "layer_types": ["linear_attention", "full_attention"], "eos_token_id": 1}}
+;
+
+/// The dense two-layer model with both layers inside a two-stream window: a 4-execution looped checkpoint.
+fn loopedFiles(img: *Image, dir: std.Io.Dir) !void {
+    var side = Image.init();
+    defer side.deinit();
+    try denseTensors(img, &side);
+    var buf: [160]u8 = undefined;
+    inline for (.{ "layers.0.", "layers.1." }) |l| for ([_][]const u8{ "mhc_attn", "mhc_ffn" }) |site| {
+        try img.put(try std.fmt.bufPrint(&buf, "{s}{s}{s}.weight", .{ L, l, site }), "F32", &.{ 8, 128 });
+        try img.put(try std.fmt.bufPrint(&buf, "{s}{s}{s}.bias", .{ L, l, site }), "F32", &.{8});
+    };
+    try img.write(dir, "model.safetensors");
+    try dir.writeFile(io, .{ .sub_path = "config.json", .data = looped_config });
+}
+
+test "a looped model's mHC routers load as the window's own fp32 tensors" {
+    var img = Image.init();
+    defer img.deinit();
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    try loopedFiles(&img, tmp.dir);
+    const root = try std.fmt.allocPrint(gpa, ".zig-cache/tmp/{s}", .{tmp.sub_path});
+    defer gpa.free(root);
+
+    var ck = try checkpoint.Checkpoint.open(gpa, io, root);
+    defer ck.close();
+    const plan = @import("../loop_plan.zig");
+    try std.testing.expectEqual(@as(usize, 4), plan.steps(ck.spec()));
+    try std.testing.expectEqual(@as(usize, 2), ck.spec().mhc.?.streams);
+    var buf: [160]u8 = undefined;
+    for (0..2) |i| {
+        var layer = try ck.layer(i);
+        defer layer.deinit();
+        const m = layer.mhc.?;
+        try std.testing.expect(m.attn.is(.f32, &.{ 8, 128 }));
+        try std.testing.expect(m.ffn.is(.f32, &.{ 8, 128 }));
+        try std.testing.expect(m.attn_b.is(.f32, &.{8}));
+        try std.testing.expect(m.ffn_b.is(.f32, &.{8}));
+        try std.testing.expectEqualSlices(u8, img.find(try std.fmt.bufPrint(&buf, "{s}layers.{d}.mhc_attn.weight", .{ L, i })), m.attn.bytes);
+    }
+}
+
+test "a windowed layer is refused when one of its routers has a wrong shape" {
+    var shaped = Image.init();
+    defer shaped.deinit();
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    try loopedFiles(&shaped, tmp.dir);
+    var buf: [160]u8 = undefined;
+    const name = try std.fmt.bufPrint(&buf, "{s}layers.0.mhc_attn.weight", .{L});
+    for (shaped.entries.items) |*e| {
+        if (std.mem.eql(u8, e.name, name)) {
+            const a = shaped.arena.allocator();
+            e.shape = try a.dupe(usize, &.{ 6, 128 });
+            e.bytes = try a.alloc(u8, 6 * 128 * 4);
+        }
+    }
+    try shaped.write(tmp.dir, "model.safetensors");
+    const root = try std.fmt.allocPrint(gpa, ".zig-cache/tmp/{s}", .{tmp.sub_path});
+    defer gpa.free(root);
+    var ck = try checkpoint.Checkpoint.open(gpa, io, root);
+    defer ck.close();
+    try std.testing.expectError(error.UnexpectedTensor, ck.layer(0));
+    var good = try ck.layer(1);
+    defer good.deinit();
+    try std.testing.expect(good.mhc != null); // the other windowed layer's routers keep their shape
+}
