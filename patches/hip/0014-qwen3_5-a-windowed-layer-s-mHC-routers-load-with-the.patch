@@ -204,6 +205,20 @@ fn subFloat(a: std.mem.Allocator, t: *const Table, base: []const u8, name: []con
     return projection.float(a, t, projection.join(&buf, &.{ base, name }));
 }
 
+/// A windowed layer's two mHC routers under its own prefix: fp32 [outputs, streams * hidden] rows and [outputs] biases.
+fn routers(a: std.mem.Allocator, t: *const Table, base: []const u8, m: @import("../loop_plan.zig").Mhc, s: config.Spec) !host.Mhc {
+    const k = m.streams * s.hidden;
+    const attn = try subFloat(a, t, base, "mhc_attn.weight");
+    if (attn.dtype != .f32 or attn.rank != 2 or attn.dim(0) != m.outputs() or attn.dim(1) != k) return error.UnexpectedTensor;
+    const attn_b = try subFloat(a, t, base, "mhc_attn.bias");
+    if (attn_b.dtype != .f32 or attn_b.rank != 1 or attn_b.dim(0) != m.outputs()) return error.UnexpectedTensor;
+    const ffn = try subFloat(a, t, base, "mhc_ffn.weight");
+    if (ffn.dtype != .f32 or ffn.rank != 2 or ffn.dim(0) != m.outputs() or ffn.dim(1) != k) return error.UnexpectedTensor;
+    const ffn_b = try subFloat(a, t, base, "mhc_ffn.bias");
+    if (ffn_b.dtype != .f32 or ffn_b.rank != 1 or ffn_b.dim(0) != m.outputs()) return error.UnexpectedTensor;
+    return .{ .attn = attn, .attn_b = attn_b, .ffn = ffn, .ffn_b = ffn_b };
+}
+
 /// A trunk RMS weight by its role: torch's `1 + w` in a bf16 checkpoint (stored centred), else as stored.
 fn norm(a: std.mem.Allocator, t: *const Table, key: []const u8) !Tensor {
     return if (t.quant == .bf16) projection.centred(a, t, key) else projection.float(a, t, key);
