From 87c48b046c57805ffbafa13e8843d2c9897a747a Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Thu, 19 Nov 2026 21:40:49 +0800
Subject: [PATCH 20/20] contract: gate-5 records for the mHC image and the YaRN
 rope pair

Measured from the code objects ROCm 7.2.4 (clang 22) builds for every
served RDNA chip: the router peaks at 139 VGPRs and 6 KiB of LDS with
no spills, the three moves stay under 24, and the YaRN pair follows
the plain rope kernels it was cut from. The mhc file joins the records
table with its count pinned.
---
 zig/src/core/contract/hip_records.zig         |  2 +-
 .../core/contract/hip_records_families.zig    |  1 +
 zig/src/core/contract/hip_records_mhc.zig     | 60 +++++++++++++++++++
 3 files changed, 62 insertions(+), 1 deletion(-)
 create mode 100644 zig/src/core/contract/hip_records_mhc.zig

diff --git a/zig/src/core/contract/hip_records.zig b/zig/src/core/contract/hip_records.zig
index a6e23c8..c7d224f 100644
--- a/zig/src/core/contract/hip_records.zig
+++ b/zig/src/core/contract/hip_records.zig
@@ -496,7 +496,7 @@ const own_records = [own_count]Record{
 } ++ @import("hip_records_pair.zig").records ++ @import("hip_records_prompt.zig").records ++ @import("hip_records_draft.zig").records ++
     @import("hip_records_score.zig").records ++ @import("hip_records_embed.zig").records ++ @import("hip_records_tail.zig").records ++ @import("hip_records_tap.zig").records ++ @import("hip_records_sparse.zig").records;
 
-pub const records = own_records ++ @import("hip_records_stream.zig").records ++ @import("hip_records_router.zig").records ++
+pub const records = own_records ++ @import("hip_records_mhc.zig").records ++ @import("hip_records_stream.zig").records ++ @import("hip_records_router.zig").records ++
     @import("hip_records_item.zig").records ++ @import("hip_records_qwen3.zig").records ++ @import("hip_records_columns.zig").records ++
     @import("hip_records_vision.zig").records ++ @import("hip_records_dense_text.zig").records ++ @import("hip_records_families.zig").all ++ @import("hip_records_skew.zig").records ++ @import("hip_records_gdn.zig").records;
 
diff --git a/zig/src/core/contract/hip_records_families.zig b/zig/src/core/contract/hip_records_families.zig
index a944ff0..753b647 100644
--- a/zig/src/core/contract/hip_records_families.zig
+++ b/zig/src/core/contract/hip_records_families.zig
@@ -27,6 +27,7 @@ test "HIP record counts stay pinned in their owning files" {
         @import("hip_records_glm_ocr.zig").records.len,
         @import("hip_records_item.zig").records.len,
         @import("hip_records_joint.zig").records.len,
