+//! SenseNova-Loop's mHC: a window's streams on the arena, and the four launches a forward makes.
+
+const hip = @import("hip");
+const view = @import("model/view.zig");
+const fwd = @import("forward/forward.zig");
+const loop = @import("../../loop_plan.zig");
+
+const Ops = hip.ops.Ops;
+const Tensor = hip.ops.Tensor;
+const Error = hip.ops.Error;
+
+/// A window's streams over `rows` rows: the residual planes, and the router's per-row state.
+pub const Streams = struct {
+    hs: Tensor,
+    state: u64,
+};
+
+/// The streams and their router state, taken from the round's arena: they live until the round's forward ends.
+pub fn take(o: Ops, m: *const view.Model, rows: usize) Error!Streams {
+    const s = m.spec;
+    const mh = s.mhc orelse return error.BadShape;
+    return .{
+        .hs = try fwd.take(o, m.act, rows * mh.streams * s.hidden),
+        .state = try o.arena.of(f32, rows * mh.outputs()),
+    };
+}
+
+/// h into every stream at the window's entry; the folded residual is already in `h` (the eager add_rms chain).
+pub fn enter(o: Ops, m: *const view.Model, st: *const Streams, rows: usize, h: Tensor) Error!void {
+    const s = m.spec;
+    const mh = s.mhc orelse return error.BadShape;
+    try o.l.mhcEnter(p(h.ptr), null, pm(st.hs.ptr), @intCast(rows), @intCast(mh.streams), @intCast(s.hidden), o.stream);
+}
+
+/// A sublayer's branch out of the streams: its routers' weights and biases name the site (attn or ffn).
+pub fn branch(o: Ops, m: *const view.Model, st: *const Streams, routers: view.Mhc, rows: usize, out: Tensor) Error!void {
+    const s = m.spec;
+    const mh = s.mhc orelse return error.BadShape;
+    try o.l.mhcBranch(
+        p(st.hs.ptr),
+        p(routers.attn),
+        p(routers.attn_b),
+        pm(out.ptr),
+        pm(st.state),
+        @intCast(rows),
+        @intCast(mh.streams),
+        @intCast(s.hidden),
+        @intCast(mh.iterations),
+        mh.pre_scale,
+        o.stream,
+    );
+}
+
+/// The sublayer's output back into the streams: its branch and the streams mix, each read as bf16.
+pub fn merge(o: Ops, m: *const view.Model, st: *const Streams, sub: Tensor, rows: usize) Error!void {
+    const s = m.spec;
+    const mh = s.mhc orelse return error.BadShape;
+    try o.l.mhcMerge(p(sub.ptr), p(st.state), pm(st.hs.ptr), @intCast(rows), @intCast(mh.streams), @intCast(s.hidden), o.stream);
+}
+
+/// The streams' mean into `h`: the window's last execution, on every visit as the reference collapses the seam.
+pub fn leave(o: Ops, m: *const view.Model, st: *const Streams, rows: usize, h: Tensor) Error!void {
+    const s = m.spec;
+    const mh = s.mhc orelse return error.BadShape;
+    try o.l.mhcLeave(p(st.hs.ptr), pm(h.ptr), @intCast(rows), @intCast(mh.streams), @intCast(s.hidden), o.stream);
+}
+
+/// The streams collapse after `physical`: at the window's end every visit (`carry` keeps them for an A/B).
+pub fn leaves(mh: loop.Mhc, physical: usize, next: usize, carry: bool) bool {
+    return !mh.holds(next) or (!carry and physical + 1 == mh.end);
+}
+
+/// A device address as the kernel argument it is: the const face the streams and routers read.
+fn p(x: u64) ?*const anyopaque {
+    return @ptrFromInt(x);
+}
+
+/// A device address as the kernel argument it is: the face the launches write through.
+fn pm(x: u64) ?*anyopaque {
+    return @ptrFromInt(x);
+}
