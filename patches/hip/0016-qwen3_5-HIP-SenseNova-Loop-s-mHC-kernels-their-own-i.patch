diff --git a/zig/kernels/hip/ops/mhc.hip b/zig/kernels/hip/ops/mhc.hip
new file mode 100644
index 0000000..24fb03f
--- /dev/null
+++ b/zig/kernels/hip/ops/mhc.hip
@@ -0,0 +1,183 @@
+
+#include <hip/hip_bfloat16.h>
+
+#include <cmath>
+
+// SenseNova-Loop's manifold-constrained hyper-connections: two or four residual streams over a looped range.
+
+namespace tf {
+namespace rocm {
+
+__device__ inline float widen(hip_bfloat16 v) { return static_cast<float>(v); }
+__device__ inline hip_bfloat16 narrow(float v) { return hip_bfloat16(v); }
+
+// A state coefficient read back as the reference's bf16 weights: rounded to bf16, then widened.
+__device__ inline float rbf(float x) { return static_cast<float>(hip_bfloat16(x)); }
+
+
+__device__ inline float warp_sum(float x) {
+#pragma unroll
+    for (int mask = 16; mask > 0; mask >>= 1) x += __shfl_xor(x, mask, 32);
+    return __shfl(x, 0, 32);
+}
+
+// The router: a block routes 16/S rows; STATE holds a row's S pre, S post and S*S mix coefficients as f32.
+template <int S>
+__device__ void mhc_branch_rows(const hip_bfloat16* __restrict__ hs, const float* __restrict__ w,
+                                const float* __restrict__ b, hip_bfloat16* __restrict__ branch,
+                                float* __restrict__ state, int rows, int hidden, int iters, float pre_scale) {
+    constexpr int RB = 16 / S, N = 2 * S + S * S, V = N + 1, WARPS = 8;
+    const int d = S * hidden, r0 = (int)blockIdx.x * RB;
+    const int nr = min(RB, rows - r0);
+    if (nr <= 0) return;
+    __shared__ float part[WARPS][RB * V];
+    __shared__ float sums[RB * V];
+    float acc[RB][V];
+#pragma unroll
+    for (int r = 0; r < RB; r++)
+#pragma unroll
+        for (int v = 0; v < V; v++) acc[r][v] = 0.f;
+    for (int i = threadIdx.x; i < d; i += blockDim.x) {
+        float row_w[N];
+#pragma unroll
+        for (int n = 0; n < N; n++) row_w[n] = w[(size_t)n * d + i];
+#pragma unroll
+        for (int r = 0; r < RB; r++) {
+            if (r < nr) {
+                const float x = widen(hs[(size_t)(r0 + r) * d + i]);
+                acc[r][N] += x * x;
+#pragma unroll
+                for (int n = 0; n < N; n++) acc[r][n] += row_w[n] * x;
+            }
+        }
+    }
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+#pragma unroll
+    for (int r = 0; r < RB; r++)
+#pragma unroll
+        for (int v = 0; v < V; v++) {
+            float a = acc[r][v];
+            for (int mask = 16; mask > 0; mask >>= 1) a += __shfl_xor(a, mask, 32);
+            if (lane == 0) part[warp][r * V + v] = a;
+        }
+    __syncthreads();
+    for (int k = threadIdx.x; k < RB * V; k += blockDim.x) {
+        float a = 0.f;
+        for (int p = 0; p < WARPS; p++) a += part[p][k];
+        sums[k] = a;
+    }
+    __syncthreads();
+    if ((int)threadIdx.x < nr) {
+        const int r = threadIdx.x;
+        const float inv = rsqrtf(sums[r * V + N] / (float)d + 1e-6f);
+        float logits[N];
+        for (int n = 0; n < N; n++) logits[n] = sums[r * V + n] * inv + (b == nullptr ? 0.f : b[n]);
+        float* st = state + (size_t)(r0 + r) * N;
+        for (int s = 0; s < S; s++) {
+            st[s] = 1.f / (1.f + expf(-logits[s]));
+            st[S + s] = 2.f / (1.f + expf(-logits[S + s]));
+        }
+        // twenty Sinkhorn iterations in the log space, rows then columns, as the reference runs them
+        float m[S * S];
+        for (int i = 0; i < S * S; i++) m[i] = logits[2 * S + i];
+        for (int it = 0; it < iters; it++) {
+            for (int row = 0; row < S; row++) {
+                float mx = -INFINITY;
+                for (int c = 0; c < S; c++) mx = fmaxf(mx, m[row * S + c]);
+                float sum = 0.f;
+                for (int c = 0; c < S; c++) sum += expf(m[row * S + c] - mx);
+                const float lz = mx + logf(sum);
+                for (int c = 0; c < S; c++) m[row * S + c] -= lz;
+            }
+            for (int c = 0; c < S; c++) {
+                float mx = -INFINITY;
+                for (int row = 0; row < S; row++) mx = fmaxf(mx, m[row * S + c]);
+                float sum = 0.f;
+                for (int row = 0; row < S; row++) sum += expf(m[row * S + c] - mx);
+                const float lz = mx + logf(sum);
+                for (int row = 0; row < S; row++) m[row * S + c] -= lz;
+            }
+        }
+        for (int i = 0; i < S * S; i++) st[2 * S + i] = expf(m[i]);
+    }
+    __syncthreads();
+    for (int r = 0; r < nr; r++) {
+        const size_t base = (size_t)(r0 + r) * d;
+        const float* st = state + (size_t)(r0 + r) * N;
+        for (int h = threadIdx.x; h < hidden; h += blockDim.x) {
+            float out = 0.f;
+            for (int s = 0; s < S; s++) out += rbf(st[s]) * widen(hs[base + (size_t)s * hidden + h]);
+            if (pre_scale != 1.f) out *= pre_scale;
+            branch[(size_t)(r0 + r) * hidden + h] = narrow(out);
+        }
+    }
+}
+
+}  // namespace rocm
+}  // namespace tf
+
+// The router's branch out of the streams, with its pre, post and mix kept for the merge.
+extern "C" __global__ void __launch_bounds__(256)
+    tf_mhc_branch(const void* __restrict__ hs, const void* __restrict__ w, const void* __restrict__ b,
+                  void* __restrict__ branch, float* __restrict__ state, int rows, int streams, int hidden,
+                  int iters, float pre_scale) {
+    const hip_bfloat16* streams_in = static_cast<const hip_bfloat16*>(hs);
+    const float* weights = static_cast<const float*>(w);
+    const float* bias = static_cast<const float*>(b);
+    hip_bfloat16* out = static_cast<hip_bfloat16*>(branch);
+    if (streams == 2) {
+        tf::rocm::mhc_branch_rows<2>(streams_in, weights, bias, out, state, rows, hidden, iters, pre_scale);
+    } else {
+        tf::rocm::mhc_branch_rows<4>(streams_in, weights, bias, out, state, rows, hidden, iters, pre_scale);
+    }
+}
+
+// streams = mix @ streams + post * branch, a thread a (row, column), so no row reads what another thread rewrote.
+extern "C" __global__ void __launch_bounds__(256)
+    tf_mhc_merge(const void* __restrict__ branch, const float* __restrict__ state, void* __restrict__ hs,
+                 long long rows, int streams, int hidden) {
+    const hip_bfloat16* sub = static_cast<const hip_bfloat16*>(branch);
+    hip_bfloat16* streams_io = static_cast<hip_bfloat16*>(hs);
+    const int N = 2 * streams + streams * streams;
+    const size_t work = (size_t)rows * hidden;
+    for (size_t i = (size_t)blockIdx.x * blockDim.x + threadIdx.x; i < work; i += (size_t)gridDim.x * blockDim.x) {
+        const int r = (int)(i / hidden), h = (int)(i % hidden);
+        const float* st = state + (size_t)r * N;
+        const hip_bfloat16* row = streams_io + (size_t)r * streams * hidden + h;
+        const float mixed = tf::rocm::widen(sub[(size_t)r * hidden + h]);
+        float out[4];
+        for (int s = 0; s < streams; s++) {
+            float a = 0.f;
+            for (int t = 0; t < streams; t++) a += tf::rocm::rbf(st[2 * streams + s * streams + t]) * tf::rocm::widen(row[(size_t)t * hidden]);
+            out[s] = a + tf::rocm::rbf(st[streams + s]) * mixed;
+        }
+        for (int s = 0; s < streams; s++) streams_io[(size_t)r * streams * hidden + (size_t)s * hidden + h] = tf::rocm::narrow(out[s]);
+    }
+}
+
+// h into every stream at the window's entry (folding the previous layer's pending output), and its exit.
+extern "C" __global__ void __launch_bounds__(256)
+    tf_mhc_enter(const void* __restrict__ h, const void* __restrict__ r, void* __restrict__ hs,
+                 long long rows, int streams, int hidden) {
+    const hip_bfloat16* residual = static_cast<const hip_bfloat16*>(h);
+    const hip_bfloat16* pending = static_cast<const hip_bfloat16*>(r);
+    hip_bfloat16* streams_out = static_cast<hip_bfloat16*>(hs);
+    const size_t work = (size_t)rows * hidden;
+    for (size_t i = (size_t)blockIdx.x * blockDim.x + threadIdx.x; i < work; i += (size_t)gridDim.x * blockDim.x) {
+        const float v = tf::rocm::widen(residual[i]) + (pending == nullptr ? 0.f : tf::rocm::widen(pending[i]));
+        const hip_bfloat16 o = tf::rocm::narrow(v);
+        for (int s = 0; s < streams; s++) streams_out[(size_t)i / hidden * streams * hidden + (size_t)s * hidden + i % hidden] = o;
+    }
+}
+
+extern "C" __global__ void __launch_bounds__(256)
+    tf_mhc_leave(const void* __restrict__ hs, void* __restrict__ h, long long rows, int streams, int hidden) {
+    const hip_bfloat16* streams_in = static_cast<const hip_bfloat16*>(hs);
+    hip_bfloat16* residual = static_cast<hip_bfloat16*>(h);
+    const size_t work = (size_t)rows * hidden;
+    for (size_t i = (size_t)blockIdx.x * blockDim.x + threadIdx.x; i < work; i += (size_t)gridDim.x * blockDim.x) {
+        float a = 0.f;
+        for (int s = 0; s < streams; s++) a += tf::rocm::widen(streams_in[(size_t)i / hidden * streams * hidden + (size_t)s * hidden + i % hidden]);
+        residual[i] = tf::rocm::narrow(a / (float)streams);
+    }
+}
