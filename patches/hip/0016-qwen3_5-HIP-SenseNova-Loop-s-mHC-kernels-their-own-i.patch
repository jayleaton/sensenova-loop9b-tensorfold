diff --git a/zig/tests/hip/contract_q35_mhc.zig b/zig/tests/hip/contract_q35_mhc.zig
new file mode 100644
index 0000000..c461824
--- /dev/null
+++ b/zig/tests/hip/contract_q35_mhc.zig
@@ -0,0 +1,378 @@
+//! SenseNova-Loop's mHC under gates 1-4, against the host's FP64 arithmetic of the same definition.
+const std = @import("std");
+const hip = @import("hip");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+
+const contract = core.contract;
+const c = contract.spec;
+const g = contract.gates;
+const rows_ = contract.rows;
+const bf = core.bf16_round;
+
+/// The router's two outputs (its branch and its pre/post/mix state), then the three stream moves.
+pub const Which = enum { branch, state, merge, enter, leave };
+/// The checkpoint's own settings: two streams over a 4096-wide residual, twenty log-space Sinkhorn passes.
+pub const streams = 2;
+pub const iterations = 20;
+const hidden = 4096;
+const width = streams * hidden;
+const outs = 2 * streams + streams * streams;
+/// The rows one router block takes (ops/mhc.hip, launches/mhc.zig).
+pub const per = 16 / streams;
+
+fn router(which: Which) bool {
+    return which == .branch or which == .state;
+}
+
+/// A router dot: each thread's k/256 terms, a 32-lane shuffle, then the block's eight warps.
+fn routerDepth(shape: c.Shape) usize {
+    return shape.k / 256 + 5 + 8;
+}
+
+fn moveDepth(_: c.Shape) usize {
+    return streams + 1;
+}
+
+const served = [_]c.Shape{
+    .{ .rows = 1, .n = outs, .k = width },
+    .{ .rows = 9, .n = outs, .k = width },
+    .{ .rows = 129, .n = outs, .k = width },
+    .{ .rows = 4096, .n = outs, .k = width },
+};
+
+pub fn spec(which: Which, control: bool) c.Spec {
+    return .{
+        .name = if (control) switch (which) {
+            .branch => "control q35 mhc branch: no row normalisation",
+            .state => "control q35 mhc state: no Sinkhorn passes",
+            .merge => "control q35 mhc merge: identity map",
+            .enter => "control q35 mhc enter: no pending output folded",
+            .leave => "control q35 mhc leave: the first stream only",
+        } else switch (which) {
+            .branch => "hip tf_mhc_branch (branch)",
+            .state => "hip tf_mhc_branch (pre/post/mix)",
+            .merge => "hip tf_mhc_merge",
+            .enter => "hip tf_mhc_enter",
+            .leave => "hip tf_mhc_leave",
+        },
+        .accum = .f32,
+        .depth = if (router(which)) routerDepth else moveDepth,
+        .ops = if (which == .state) 64 * iterations else 8,
+        .out = if (which == .state) .f32 else .bf16,
+        .in_place = which == .merge,
+        .tiles = .{ .{ .size = per }, .{}, .{} },
+        .served = &served,
+        .sums = .{ .f16 = 0, .bf16 = 0, .why = "the router's logits pass a sigmoid and twenty Sinkhorn passes; the moves sum two streams" },
+    };
+}
+
+pub const Case = struct {
+    rig: rig_.Rig,
+    l: *const hip.Launcher,
+    arena: std.heap.ArenaAllocator,
+    which: Which,
+    control: bool,
+    shape: c.Shape = .{ .rows = 0, .n = 0, .k = 0 },
+    hs: []u16 = &.{},
+    branch: []u16 = &.{},
+    res: []u16 = &.{},
+    w: []f32 = &.{},
+    bias: []f32 = &.{},
+    state: []f32 = &.{},
+    in0: u64 = 0,
+    in1: u64 = 0,
+    in2: u64 = 0,
+    out0: u64 = 0,
+    out1: u64 = 0,
+
+    pub fn init(a: std.mem.Allocator, r: *const hip.Runtime, s: hip.Stream, l: *const hip.Launcher, which: Which, control: bool) Case {
+        return .{ .rig = .{ .a = a, .r = r, .s = s }, .l = l, .arena = .init(a), .which = which, .control = control };
+    }
+
+    pub fn deinit(self: *Case) void {
+        self.rig.deinit();
+        self.arena.deinit();
+    }
+
+    pub fn kernel(self: *Case) g.Kernel {
+        return .{ .spec = spec(self.which, self.control), .ctx = self, .vt = &vt, .control = if (self.control) .shapes else null };
+    }
+
+    const vt = g.hooks(Case);
+
+    fn random(rng: std.Random, out: []u16, scale: f32) void {
+        for (out) |*x| x.* = bf.bits((rng.float(f32) * 2 - 1) * scale);
+    }
+
+    fn integers(rng: std.Random, out: []u16) void {
+        for (out) |*x| x.* = bf.bits(@as(f32, @floatFromInt(@as(i32, @intCast(rng.uintLessThan(u32, 33))) - 16)));
+    }
+
+    pub fn prepare(self: *Case, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.rows > 4096 or shape.n != outs or shape.k != width) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.retain_capacity);
+        const a = self.arena.allocator();
+        self.shape = shape;
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        self.hs = try a.alloc(u16, shape.rows * width);
+        self.branch = try a.alloc(u16, shape.rows * hidden);
+        self.res = try a.alloc(u16, shape.rows * hidden);
+        self.w = try a.alloc(f32, outs * width);
+        self.bias = try a.alloc(f32, outs);
+        self.state = try a.alloc(f32, shape.rows * outs);
+        for (self.state, 0..) |*st, i| st.* = switch (i % outs) {
+            0, 1 => 0.25,
+            2, 3 => 1.0,
+            else => 0.5,
+        };
+        if (fill == .stress) {
+            // integers and halves: every product and sum is exact in fp32, in any order
+            integers(rng, self.hs);
+            integers(rng, self.branch);
+            integers(rng, self.res);
+            for (self.w) |*wt| wt.* = if (rng.boolean()) 0.5 else -0.5;
+            @memset(self.bias, 0);
+        } else {
+            random(rng, self.hs, 2);
+            random(rng, self.branch, 2);
+            random(rng, self.res, 2);
+            for (self.w) |*wt| wt.* = (rng.float(f32) * 2 - 1) * 0.05;
+            for (self.bias) |*bias| bias.* = (rng.float(f32) * 2 - 1) * 0.5;
+        }
+        if (fill == .nonfinite) {
+            // rows 0 and 2 only, so finite rows remain beside them
+            self.hs[3] = bf.bits(std.math.nan(f32));
+            self.hs[2 * width + hidden + 5] = bf.bits(std.math.inf(f32));
+            self.branch[2 * hidden + 7] = bf.bits(-std.math.inf(f32));
+            self.res[9] = bf.bits(std.math.inf(f32));
+        }
+        const r = shape.rows;
+        switch (self.which) {
+            .branch, .state => {
+                self.in0 = try self.rig.input(std.mem.sliceAsBytes(self.hs));
+                self.in1 = try self.rig.input(std.mem.sliceAsBytes(self.w));
+                self.in2 = try self.rig.input(std.mem.sliceAsBytes(self.bias));
+                const b_len = r * hidden * 2;
+                const s_len = r * outs * 4;
+                self.out0 = if (self.which == .branch) try self.rig.output(b_len) else try self.rig.scratch(b_len);
+                self.out1 = if (self.which == .state) try self.rig.output(s_len) else try self.rig.scratch(s_len);
+            },
+            .merge => {
+                self.in0 = try self.rig.input(std.mem.sliceAsBytes(self.branch));
+                self.in1 = try self.rig.input(std.mem.sliceAsBytes(self.state));
+                self.in2 = try self.rig.input(std.mem.sliceAsBytes(self.hs));
+                self.out0 = try self.rig.output(r * width * 2);
+            },
+            .enter => {
+                self.in0 = try self.rig.input(std.mem.sliceAsBytes(self.hs[0 .. r * hidden]));
+                self.in1 = try self.rig.input(std.mem.sliceAsBytes(self.res));
+                self.out0 = try self.rig.output(r * width * 2);
+            },
+            .leave => {
+                self.in0 = try self.rig.input(std.mem.sliceAsBytes(self.hs));
+                self.out0 = try self.rig.output(r * hidden * 2);
+            },
+        }
+        return true;
+    }
+
+    pub fn run(self: *Case) !void {
+        const rows: c_longlong = @intCast(self.shape.rows);
+        const s = self.rig.s.handle;
+        switch (self.which) {
+            .branch, .state => try self.l.mhcBranch(
+                p(self.in0),
+                p(self.in1),
+                p(self.in2),
+                pm(self.out0),
+                pm(self.out1),
+                @intCast(self.shape.rows),
+                streams,
+                hidden,
+                iterations,
+                1.0,
+                s,
+            ),
+            .merge => {
+                // the merge rewrites the streams in place: the run starts from the input's own bytes
+                try self.rig.put(self.out0, std.mem.sliceAsBytes(self.hs));
+                try self.l.mhcMerge(p(self.in0), p(self.in1), pm(self.out0), rows, streams, hidden, s);
+            },
+            .enter => try self.l.mhcEnter(p(self.in0), p(self.in1), pm(self.out0), rows, streams, hidden, s),
+            .leave => try self.l.mhcLeave(p(self.in0), pm(self.out0), rows, streams, hidden, s),
+        }
+        try self.rig.s.synchronize();
+    }
+
+    pub fn count(self: *Case) usize {
+        const r = self.shape.rows;
+        return switch (self.which) {
+            .branch, .leave => r * hidden,
+            .state => r * outs,
+            .merge, .enter => r * width,
+        };
+    }
+
+    /// The 2x2 map Sinkhorn-normalised as the definition does: log space, a row pass then a column pass.
+    fn sinkhorn(m: *[streams * streams]f64) void {
+        for (0..iterations) |_| {
+            for (0..streams) |row| {
+                var mx = -std.math.inf(f64);
+                for (0..streams) |col| mx = @max(mx, m[row * streams + col]);
+                var sum: f64 = 0;
+                for (0..streams) |col| sum += @exp(m[row * streams + col] - mx);
+                const lz = mx + @log(sum);
+                for (0..streams) |col| m[row * streams + col] -= lz;
+            }
+            for (0..streams) |col| {
+                var mx = -std.math.inf(f64);
+                for (0..streams) |row| mx = @max(mx, m[row * streams + col]);
+                var sum: f64 = 0;
+                for (0..streams) |row| sum += @exp(m[row * streams + col] - mx);
+                const lz = mx + @log(sum);
+                for (0..streams) |row| m[row * streams + col] -= lz;
+            }
+        }
+    }
+
+    fn sumAll(t: []const f64) f64 {
+        var s: f64 = 0;
+        for (t) |v| s += v;
+        return s;
+    }
+
+    /// One row's router: pre, post, mix, and the logits' magnitude (what an fp32 dot's error scales with).
+    fn route(self: *Case, acc: c.Accum, order: g.Order, r: usize, terms: []f64, st: *[outs]f64) f64 {
+        const row = self.hs[r * width ..][0..width];
+        for (terms, row) |*t, x| t.* = @as(f64, bf.value(x)) * bf.value(x);
+        const sq = if (acc == .none) sumAll(terms) else rows_.sumIn(acc, order, terms);
+        const inv = if (self.control and self.which == .branch) 1.0 else 1.0 / @sqrt(sq / @as(f64, width) + 1e-6);
+        var logits: [outs]f64 = undefined;
+        var mag: f64 = 0;
+        for (0..outs) |o| {
+            var size: f64 = 0;
+            for (terms, row, 0..) |*t, x, i| {
+                t.* = @as(f64, self.w[o * width + i]) * bf.value(x);
+                size += @abs(t.*);
+            }
+            const dot = if (acc == .none) sumAll(terms) else rows_.sumIn(acc, order, terms);
+            logits[o] = dot * inv + self.bias[o];
+            mag = @max(mag, size * @abs(inv));
+        }
+        var m: [streams * streams]f64 = logits[2 * streams ..][0 .. streams * streams].*;
+        if (!(self.control and self.which == .state)) sinkhorn(&m);
+        for (0..streams) |s| {
+            st[s] = 1.0 / (1.0 + @exp(-logits[s]));
+            st[streams + s] = 2.0 / (1.0 + @exp(-logits[streams + s]));
+        }
+        for (m, 0..) |v, i| st[2 * streams + i] = @exp(v);
+        return mag;
+    }
+
+    fn outputs(self: *Case, acc: c.Accum, order: g.Order, want: []f64, mag: ?[]f64) !void {
+        const terms = try self.arena.allocator().alloc(f64, width);
+        defer self.arena.allocator().free(terms);
+        for (0..self.shape.rows) |r| {
+            const hs = self.hs[r * width ..][0..width];
+            switch (self.which) {
+                .branch, .state => {
+                    var st: [outs]f64 = undefined;
+                    const size = self.route(acc, order, r, terms, &st);
+                    if (self.which == .state) {
+                        for (st, 0..) |v, o| {
+                            want[r * outs + o] = v;
+                            if (mag) |m| m[r * outs + o] = size;
+                        }
+                    } else for (0..hidden) |col| {
+                        var b: f64 = 0;
+                        var sz: f64 = 0;
+                        for (0..streams) |s| {
+                            const x: f64 = bf.value(hs[s * hidden + col]);
+                            b += st[s] * x;
+                            sz += @abs(st[s] * x);
+                        }
+                        want[r * hidden + col] = b;
+                        if (mag) |m| m[r * hidden + col] = sz;
+                    }
+                },
+                .leave => for (0..hidden) |col| {
+                    var sum: f64 = 0;
+                    for (0..streams) |s| sum += bf.value(hs[s * hidden + col]);
+                    const v = if (self.control) @as(f64, bf.value(hs[col])) else sum / @as(f64, streams);
+                    want[r * hidden + col] = v;
+                    if (mag) |m| m[r * hidden + col] = @abs(v);
+                },
+                .enter => for (0..hidden) |col| {
+                    const fold: f64 = if (self.control) 0 else bf.value(self.res[r * hidden + col]);
+                    const v = bf.bf16(@as(f64, bf.value(self.hs[r * hidden + col])) + fold);
+                    for (0..streams) |s| {
+                        want[r * width + s * hidden + col] = v;
+                        if (mag) |m| m[r * width + s * hidden + col] = @abs(v);
+                    }
+                },
+                .merge => {
+                    const st = self.state[r * outs ..][0..outs];
+                    var mix: [streams * streams]f64 = undefined;
+                    for (&mix, 0..) |*v, i| v.* = st[2 * streams + i];
+                    if (self.control) mix = .{ 1, 0, 0, 1 };
+                    for (0..hidden) |col| for (0..streams) |s| {
+                        var v: f64 = @as(f64, st[streams + s]) * bf.value(self.branch[r * hidden + col]);
+                        var sz: f64 = @abs(v);
+                        for (0..streams) |t| {
+                            const term = mix[s * streams + t] * bf.value(hs[t * hidden + col]);
+                            v += term;
+                            sz += @abs(term);
+                        }
+                        want[r * width + s * hidden + col] = v;
+                        if (mag) |m| m[r * width + s * hidden + col] = sz;
+                    };
+                },
+            }
+        }
+    }
+
+    pub fn reference(self: *Case, want: []f64, mag: []f64) !void {
+        try self.outputs(.none, .sequential, want, mag);
+    }
+
+    pub fn simulate(self: *Case, acc: c.Accum, order: g.Order, out: []f64) !void {
+        try self.outputs(acc, order, out, null);
+    }
+
+    /// The branch mixes with pre rounded to bf16 (as the reference model does): a bf16 ulp of each term.
+    pub fn bounds(self: *Case, _: []const f64, mag: []const f64, allow: []f64) !void {
+        if (self.which == .branch) for (allow, mag) |*l, m| {
+            l.* += 0x1p-7 * m;
+        };
+    }
+};
+
+/// A device address as the kernel argument it is: the const face the kernels read.
+fn p(x: u64) ?*const anyopaque {
+    return @ptrFromInt(x);
+}
+
+/// A device address as the kernel argument it is: the face the launches write through.
+fn pm(x: u64) ?*anyopaque {
+    return @ptrFromInt(x);
+}
+
+test "the mHC contract's own settings match the checkpoint's window" {
+    try std.testing.expectEqual(@as(usize, 2), streams);
+    try std.testing.expectEqual(@as(usize, 8), outs);
+    try std.testing.expectEqual(@as(usize, 8), per);
+    try std.testing.expectEqual(@as(usize, 8192), width);
+    for (served) |shape| {
+        try std.testing.expect(shape.rows <= 4096);
+        try std.testing.expectEqual(outs, shape.n);
+        try std.testing.expectEqual(width, shape.k);
+    }
+    // every planted control names its own plant, and no real case carries a control's name
+    for (std.enums.values(Which)) |which| {
+        try std.testing.expect(!std.mem.eql(u8, spec(which, false).name, spec(which, true).name));
+        try std.testing.expect(std.mem.indexOf(u8, spec(which, true).name, "control") != null);
+    }
+}
