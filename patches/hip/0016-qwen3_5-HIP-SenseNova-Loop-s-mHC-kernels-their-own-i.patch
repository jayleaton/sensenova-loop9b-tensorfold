diff --git a/zig/src/hip/launches/mhc.zig b/zig/src/hip/launches/mhc.zig
new file mode 100644
index 0000000..d49676c
--- /dev/null
+++ b/zig/src/hip/launches/mhc.zig
@@ -0,0 +1,81 @@
+//! The mHC launches: a window's streams entered and left, a sublayer's branch out of them, and its merge back.
+
+const Launcher = @import("../launches.zig").Launcher;
+const util = @import("util.zig");
+const Function = @import("../module.zig").Function;
+const S = util.S;
+const P = util.P;
+const C = util.C;
+const Args = util.Args;
+const Error = util.Error;
+const ad = util.ad;
+const dim = util.dim;
+const cdiv = util.cdiv;
+const invalid = util.invalid;
+
+pub const Fns = struct {
+    branch: Function,
+    merge: Function,
+    enter: Function,
+    leave: Function,
+};
+
+/// The rows one block of the router's launch covers: 16 a window's streams (ops/mhc.hip).
+pub fn blockRows(streams: c_int) usize {
+    return 16 / @as(usize, @intCast(streams));
+}
+
+/// The streams' router: `state` takes a row's pre, post and mix coefficients, `branch` the sublayer's input.
+pub fn mhcBranch(l: *const Launcher, hs: C, w: C, b: C, out: P, state: P, rows: c_int, streams: c_int, hidden: c_int, iters: c_int, pre_scale: f32, s: S) Error!void {
+    if ((streams != 2 and streams != 4) or rows < 1 or hidden < 1 or iters < 1 or iters > 64) return invalid("mhc branch");
+    var a: Args = .{};
+    try a.add(ad(hs));
+    try a.add(ad(w));
+    try a.add(ad(b));
+    try a.add(ad(out));
+    try a.add(ad(state));
+    try a.add(rows);
+    try a.add(streams);
+    try a.add(hidden);
+    try a.add(iters);
+    try a.add(pre_scale);
+    try l.go(l.mhc.branch, dim(cdiv(rows, blockRows(streams)), 1, 1), dim(256, 1, 1), 0, s, &a);
+}
+
+/// streams = mix @ streams + post * branch, a thread a (row, column), so no row reads what another rewrote.
+pub fn mhcMerge(l: *const Launcher, sub: C, state: C, hs: P, rows: c_longlong, streams: c_int, hidden: c_int, s: S) Error!void {
+    if ((streams != 2 and streams != 4) or rows < 1 or hidden < 1) return invalid("mhc merge");
+    var a: Args = .{};
+    try a.add(ad(sub));
+    try a.add(ad(state));
+    try a.add(ad(hs));
+    try a.add(rows);
+    try a.add(streams);
+    try a.add(hidden);
+    try l.go(l.mhc.merge, dim(cdiv(rows * hidden, 256), 1, 1), dim(256, 1, 1), 0, s, &a);
+}
+
+/// h into every stream at the window's entry, folding the previous layer's output when it is still pending.
+pub fn mhcEnter(l: *const Launcher, h: C, pending: C, hs: P, rows: c_longlong, streams: c_int, hidden: c_int, s: S) Error!void {
+    if ((streams != 2 and streams != 4) or rows < 1 or hidden < 1) return invalid("mhc enter");
+    var a: Args = .{};
+    try a.add(ad(h));
+    try a.add(ad(pending));
+    try a.add(ad(hs));
+    try a.add(rows);
+    try a.add(streams);
+    try a.add(hidden);
+    try l.go(l.mhc.enter, dim(cdiv(rows * hidden, 256), 1, 1), dim(256, 1, 1), 0, s, &a);
+}
+
+/// The streams' mean into h: the window's last execution.
+pub fn mhcLeave(l: *const Launcher, hs: C, h: P, rows: c_longlong, streams: c_int, hidden: c_int, s: S) Error!void {
+    if ((streams != 2 and streams != 4) or rows < 1 or hidden < 1) return invalid("mhc leave");
+    var a: Args = .{};
+    try a.add(ad(hs));
+    try a.add(ad(h));
+    try a.add(rows);
+    try a.add(streams);
+    try a.add(hidden);
+    try l.go(l.mhc.leave, dim(cdiv(rows * hidden, 256), 1, 1), dim(256, 1, 1), 0, s, &a);
+}
