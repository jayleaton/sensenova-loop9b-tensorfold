diff --git a/zig/src/families/qwen3_5/rope.zig b/zig/src/families/qwen3_5/rope.zig
new file mode 100644
index 0000000..a5ee744
--- /dev/null
+++ b/zig/src/families/qwen3_5/rope.zig
@@ -0,0 +1,114 @@
+//! A Qwen text tower's rope: plain within its trained window, or the static YaRN its config declares.
+
+const std = @import("std");
+const config = @import("config.zig");
+const checks = config.checks;
+const rope_config = @import("rope_config");
+const rope_yarn = @import("core").rope_yarn;
+
+/// A static YaRN: its factor and trained window, with the table the rope kernels read.
+pub const Yarn = struct {
+    factor: f64,
+    trained: usize,
+    /// The attention factor, then 32 frequencies: what the rope kernels read.
+    table: [33]f32,
+};
+
+/// The tower's rope and window: plain rope stays within the trained 262,144, a yarn block names factor and window.
+pub fn resolve(spec: *config.Spec, tower: std.json.ObjectMap, rope: std.json.ObjectMap) config.Error!void {
+    if (rope_config.scaled(tower, rope) == null) {
+        spec.max_position = try checks.maxPosition(tower);
+        if (spec.max_position > 262144) return error.InvalidConfig; // past the trained window only with scaled rope
+        return;
+    }
+    const from = rope_config.block(tower, rope) catch return error.InvalidRotary;
+    const kind = from.map.get("rope_type") orelse from.map.get("type") orelse return error.InvalidRotary;
+    if (kind != .string or !std.mem.eql(u8, kind.string, "yarn")) return error.InvalidRotary;
+    // transformers' own defaults: anything else in the block changes the table this engine does not compute
+    for ([_][]const u8{ "mscale", "mscale_all_dim", "attention_factor" }) |key| if (from.map.get(key)) |v| if (v != .null) return error.InvalidRotary;
+    for ([_]struct { []const u8, f64 }{ .{ "beta_fast", 32 }, .{ "beta_slow", 1 } }) |b| if (from.map.get(b[0])) |v| {
+        if (v != .null and (try number(v)) != b[1]) return error.InvalidRotary;
+    };
+    if (from.map.get("truncate")) |v| if (v != .null and !(v == .bool and v.bool)) return error.InvalidRotary;
+    const factor = try number(from.map.get("factor") orelse return error.InvalidRotary);
+    if (!std.math.isFinite(factor) or !(factor > 1)) return error.InvalidRotary;
+    const trained = try positive(from.map, "original_max_position_embeddings");
+    const ceiling = try checks.maxPosition(tower);
+    if (@as(f64, @floatFromInt(trained)) * factor != @as(f64, @floatFromInt(ceiling))) return error.InvalidRotary;
+    spec.max_position = ceiling;
+    const y = rope_yarn.yarn(spec.rope_theta, factor, trained);
+    spec.yarn = .{ .factor = factor, .trained = trained, .table = .{y.scale} ++ y.freq };
+}
+
+fn number(v: std.json.Value) config.Error!f64 {
+    return switch (v) {
+        .integer => |i| @floatFromInt(i),
+        .float => |f| f,
+        else => error.InvalidRotary,
+    };
+}
+
+fn positive(o: std.json.ObjectMap, key: []const u8) config.Error!usize {
+    const v = o.get(key) orelse return error.InvalidRotary;
+    if (v != .integer or v.integer < 1 or v.integer > std.math.maxInt(u32)) return error.InvalidRotary;
+    return @intCast(v.integer);
+}
+
+const sensenova =
+    \\{"hidden_size": 4096, "intermediate_size": 12288, "num_hidden_layers": 8,
+    \\ "num_attention_heads": 16, "num_key_value_heads": 4, "head_dim": 256,
+    \\ "linear_num_key_heads": 16, "linear_num_value_heads": 32, "linear_key_head_dim": 128,
+    \\ "linear_value_head_dim": 128, "linear_conv_kernel_dim": 4, "vocab_size": 248320,
+    \\ "rms_norm_eps": 1e-06, "full_attention_interval": 4, "max_position_embeddings": 524288,
+    \\ "rope_parameters": {"rope_type": "yarn", "factor": 2.0, "original_max_position_embeddings": 262144,
+    \\  "rope_theta": 10000000, "partial_rotary_factor": 0.25, "mrope_interleaved": true, "mrope_section": [11, 11, 10]}}
+;
+
+fn specOf(a: std.mem.Allocator, text: []const u8) !config.Spec {
+    const doc = try std.json.parseFromSliceLeaky(std.json.Value, a, text, .{});
+    return try config.geometry(doc.object, 4, 64);
+}
+
+test "a yarn block resolves its factor, its window and transformers' exact table" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const spec = try specOf(a, sensenova);
+    try std.testing.expectEqual(@as(usize, 524288), spec.max_position);
+    const y = spec.yarn.?;
+    try std.testing.expectEqual(@as(f64, 2), y.factor);
+    try std.testing.expectEqual(@as(usize, 262144), y.trained);
+    const table = rope_yarn.yarn(10000000, 2, 262144);
+    try std.testing.expectEqual(table.scale, y.table[0]);
+    try std.testing.expectEqualSlices(f32, &table.freq, y.table[1..]);
+    try std.testing.expectEqual(@as(f32, @floatCast(0.1 * @log(2.0) + 1)), y.table[0]);
+}
+
+test "plain rope keeps its trained window, and a yarn block without its fields is refused" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const plain = try std.mem.replaceOwned(u8, a, sensenova, "\"rope_type\": \"yarn\", \"factor\": 2.0, \"original_max_position_embeddings\": 262144,", "");
+    // plain rope with the window a yarn block would have allowed: past the trained window, refused as before
+    try std.testing.expectError(error.InvalidConfig, specOf(a, plain));
+    const over = try std.mem.replaceOwned(u8, a, plain, "\"max_position_embeddings\": 524288,", "");
+    const within = try specOf(a, over);
+    try std.testing.expect(within.yarn == null);
+    try std.testing.expectEqual(@as(usize, 262144), within.max_position);
+    const cases = [_]struct { []const u8, []const u8, anyerror }{
+        .{ "\"factor\": 2.0", "\"factor\": 1.0", error.InvalidRotary },
+        .{ "\"factor\": 2.0", "\"factor\": 2.5", error.InvalidRotary },
+        .{ "\"original_max_position_embeddings\": 262144", "\"original_max_position_embeddings\": 131072", error.InvalidRotary },
+        .{ "\"rope_type\": \"yarn\", \"factor\": 2.0", "\"rope_type\": \"yarn\", \"attention_factor\": 1.25, \"factor\": 2.0", error.InvalidRotary },
+        .{ "\"rope_type\": \"yarn\", \"factor\": 2.0", "\"rope_type\": \"yarn\", \"beta_fast\": 16, \"factor\": 2.0", error.InvalidRotary },
+        .{ "\"rope_type\": \"yarn\", \"factor\": 2.0", "\"rope_type\": \"yarn\", \"truncate\": false, \"factor\": 2.0", error.InvalidRotary },
+        .{ "\"rope_type\": \"yarn\"", "\"rope_type\": \"longrope\"", error.InvalidRotary },
+    };
+    for (cases) |c| {
+        const bad = try std.mem.replaceOwned(u8, a, sensenova, c[0], c[1]);
+        try std.testing.expectError(c[2], specOf(a, bad));
+    }
+    // the ceiling a yarn block names without the fields that pin it down
+    const bare = try std.mem.replaceOwned(u8, a, sensenova, "\"original_max_position_embeddings\": 262144,", "");
+    try std.testing.expectError(error.InvalidRotary, specOf(a, bare));
+}
