+
+test "copy width: a shared stream starts at three copies, grows to 2 w + 1 while they land, narrows on a miss" {
+    const cw = @import("copy_width.zig");
+    var cfg = try Config.init(gpa, .{ .exact_width = 16, .hidden_rows = true, .batch_rows = 32 }, 16, 15);
+    defer cfg.deinit(gpa);
+    var target: fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var clock: fake.FixedClock = .{};
+    var e = Engine.init(gpa, &cfg, target.backend(), clock.clock());
+    defer e.deinit();
+    var s = try sm.Stream.init(gpa, .{ .id = "s", .prompt = &.{ 1, 2 }, .max_new = 64 });
+    defer s.deinit(gpa);
+    e.alone = false;
+    var widths: [5]u32 = undefined;
+    for (&widths) |*w| {
+        w.* = cw.current(&e, &s);
+        cw.observe(&e, &s, true);
+    }
+    try std.testing.expectEqualSlices(u32, &.{ 3, 7, 15, 15, 15 }, &widths);
+    cw.observe(&e, &s, false);
+    try std.testing.expectEqual(@as(u32, 3), cw.current(&e, &s));
+    // a lone round keeps its own width, from cfg.first_copy
+    e.alone = true;
+    try std.testing.expectEqual(cfg.first_copy, cw.current(&e, &s));
+}
+
+/// Copies the fake target's own continuation, as many tokens as the window allows, so every copy lands whole.
+const Echo = struct {
+    out: [16]u32 = undefined,
+
+    fn propose(ptr: *anyopaque, context: []const u32, most: i64) anyerror![]const u32 {
+        const c: *Echo = @ptrCast(@alignCast(ptr));
+        if (most < 2) return &.{};
+        var history: [128]u32 = undefined;
+        @memcpy(history[0..context.len], context);
+        const n: usize = @intCast(@min(c.out.len, most));
+        for (c.out[0..n], 0..) |*t, k| {
+            t.* = fake.next(history[0 .. context.len + k], null, 0);
+            history[context.len + k] = t.*;
+        }
+        return c.out[0..n];
+    }
+
+    fn lastMatch(_: *anyopaque) i64 {
+        return 100;
+    }
+
+    const vtable: Proposer.VTable = .{ .propose = propose, .last_match = lastMatch };
+};
+
+/// Each stream's copy windows verified in shared forwards, in order.
+const SharedCopies = struct {
+    var inner: *const fn (*anyopaque, []const be.Window, []be.Verified) anyerror!void = undefined;
+    var streams: [2]?*sm.Stream = @splat(null);
+    var widths: [2][64]usize = undefined;
+    var lens: [2]usize = @splat(0);
+
+    fn slot(s: *sm.Stream) usize {
+        for (&streams, 0..) |*x, i| if (x.* == null or x.* == s) {
+            x.* = s;
+            return i;
+        };
+        unreachable;
+    }
+
+    fn verify(ptr: *anyopaque, windows: []const be.Window, out: []be.Verified) anyerror!void {
+        if (windows.len >= 2) for (windows) |w| {
+            if (w.held > 0 or w.tokens.len == 0) continue;
+            const i = slot(w.stream);
+            widths[i][lens[i]] = w.tokens.len;
+            lens[i] += 1;
+        };
+        return inner(ptr, windows, out);
+    }
+};
+
+fn echoRun(drafts: bool, tokens: *[2][64]u32, lens: *[2]usize) !void {
+    SharedCopies.streams = @splat(null);
+    SharedCopies.lens = @splat(0);
+    var target: fake.Fake = .{ .gpa = gpa };
+    defer target.deinit();
+    var seen = target.backend();
+    var verified = seen.vtable.*;
+    SharedCopies.inner = verified.verify;
+    verified.verify = SharedCopies.verify;
+    seen.vtable = &verified;
+    var cfg = try Config.init(gpa, .{ .exact_width = 16, .hidden_rows = true, .batch_rows = 32, .max_streams = 4 }, 16, 15);
+    defer cfg.deinit(gpa);
+    var clock: fake.FixedClock = .{};
+    var engine = Engine.init(gpa, &cfg, seen, clock.clock());
+    defer engine.deinit();
+    var echoes: [2]Echo = @splat(.{});
+    var streams: [2]sm.Stream = undefined;
+    for (&streams, &echoes, 0..) |*s, *c, i| s.* = try sm.Stream.init(gpa, .{ .id = "s", .prompt = dt.long[0 .. 12 + i], .max_new = 40, .eos = &.{96}, .drafts = drafts, .proposer = .{ .ptr = c, .vtable = &Echo.vtable } });
+    defer for (&streams) |*s| s.deinit(gpa);
+    for (&streams) |*s| try engine.addStream(s);
+    while (engine.activeCount() > 0) try engine.step();
+    for (&streams, 0..) |*s, i| {
+        lens[i] = s.emitted().len;
+        @memcpy(tokens[i][0..lens[i]], s.emitted());
+    }
+}
+
+test "shared rounds: copy windows start at three rows and widen as copies land; replies equal one-token decode" {
+    var plain: [2][64]u32 = undefined;
+    var plain_lens: [2]usize = undefined;
+    try echoRun(false, &plain, &plain_lens);
+    var drafted: [2][64]u32 = undefined;
+    var drafted_lens: [2]usize = undefined;
+    try echoRun(true, &drafted, &drafted_lens);
+    for (0..2) |i| try std.testing.expectEqualSlices(u32, plain[i][0..plain_lens[i]], drafted[i][0..drafted_lens[i]]);
+    var widest: usize = 0;
+    var windows: usize = 0;
+    for (&SharedCopies.widths, SharedCopies.lens) |*widths, n| {
+        if (n == 0) continue;
+        try std.testing.expectEqual(@as(usize, 3), widths[0]);
+        widest = @max(widest, std.mem.max(usize, widths[0..n]));
+        windows += n;
+    }
+    try std.testing.expect(windows >= 2 and widest > 3);
+}
