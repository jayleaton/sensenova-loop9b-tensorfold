@@ -0,0 +1,25 @@
+//! A stream's copy window: narrow at first, 2 w + 1 while every copied row lands, narrow again on a miss.
+const Engine = @import("engine.zig").Engine;
+const Stream = @import("stream.zig").Stream;
+
+/// The current width for lone rounds and for rounds shared with other streams, kept apart (null: the first).
+pub const Widths = struct { lone: ?u32 = null, shared: ?u32 = null };
+
+/// A shared round's first copy rows at most, as the narrow families' first_copy_rows (4 rows: 3 copies).
+const shared_first = 3;
+
+/// The first width: a lone stream's cfg.first_copy; a shared stream's no wider than shared_first.
+pub fn first(e: *const Engine) u32 {
+    return if (e.alone) e.cfg.first_copy else @min(e.cfg.first_copy, shared_first);
+}
+
+/// The copies this round may propose.
+pub fn current(e: *const Engine, s: *const Stream) u32 {
+    return (if (e.alone) s.copy_width.lone else s.copy_width.shared) orelse first(e);
+}
+
+/// After a copy window: widen it when all its own rows landed, else back to the first width.
+pub fn observe(e: *const Engine, s: *Stream, whole: bool) void {
+    const next = if (whole) @min(e.cfg.max_copy, 2 * current(e, s) + 1) else first(e);
+    if (e.alone) s.copy_width.lone = next else s.copy_width.shared = next;
+}
