+/// Resolve this module's handles; a model without streams never reaches the image.
+pub fn install(e: *E.Engine, fns: *Fns) !void {
+    if (e.g.mhc == null) return;
+    inline for (@typeInfo(Fns).@"struct".field_names) |name| @field(fns, name) = try e.mods[19].function("tf_q35_" ++ name);
