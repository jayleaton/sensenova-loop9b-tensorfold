+/// A whole field, zero included (a loop may start at layer 0).
+fn whole(o: std.json.ObjectMap, key: []const u8) !usize {
+    const v = o.get(key) orelse return error.UnsupportedQwenGeometry;
+    if (v != .integer or v.integer < 0 or v.integer > geometry.max_layers) return error.UnsupportedQwenGeometry;
+    return @intCast(v.integer);
+}
+
 /// A positive whole field.
 fn integer(o: std.json.ObjectMap, key: []const u8) !usize {
     const v = o.get(key) orelse return error.UnsupportedQwenGeometry;
@@ -32,8 +39,8 @@ pub fn read(g: *geometry.Geometry, root: std.json.ObjectMap) !void {
 fn loopPlan(g: *geometry.Geometry, root: std.json.ObjectMap) !void {
     const v = root.get("loop_settings") orelse return;
     const o = try object(v);
-    const start = try integer(o, "start");
-    const end = try integer(o, "end");
+    const start = try whole(o, "start");
+    const end = try whole(o, "end");
     const count = try integer(o, "eval_count");
     if (start >= end or end > g.layers or count < 1) return error.UnsupportedQwenGeometry;
     // the reference runs fixed-count loop checkpoints only: `counts` is exactly [eval_count] when present
@@ -52,8 +59,8 @@ fn loopPlan(g: *geometry.Geometry, root: std.json.ObjectMap) !void {
