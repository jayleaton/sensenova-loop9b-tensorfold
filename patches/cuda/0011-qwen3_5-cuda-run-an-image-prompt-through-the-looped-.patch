+//! An image prompt end to end on CUDA: the tower's rows spliced at the prompt's placeholders, then greedy steps.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const q = @import("qwen35");
+const lanes = @import("lanes");
+const E = q.engine;
+const vl = core.qwen_vl;
+
+/// The picture spliced into the prompt at its placeholders, in chunks at its t, h, w, then `steps` greedy tokens.
+pub fn run(init: std.process.Init, a: std.mem.Allocator, model: []const u8, ids_path: []const u8, out: []const u8, p: vl.geometry.Prepared, tokens: u32, steps: usize) !u8 {
+    const io = init.io;
+    var ids: std.ArrayList(u32) = .empty;
+    var it = std.mem.tokenizeAny(u8, try std.Io.Dir.cwd().readFileAlloc(io, ids_path, a, .limited(64 << 20)), ", \n");
+    while (it.next()) |t| try ids.append(a, try std.fmt.parseInt(u32, t, 10));
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(ctx.d, true);
+    defer stream.deinit();
+    const e = try E.Engine.init(init.gpa, io, &ctx, model, false, null, E.max_rows);
+    defer e.deinit();
+    // the tower beside the decoder, as --vision opens it: the merger's width must be the text's hidden
+    const v = try q.vision.Vision.open(init.gpa, io, ctx.d, stream, model, e.g.hidden, .{ .image_tokens = tokens, .max_images = 1 });
+    defer v.deinit();
+    const at = std.mem.indexOfScalar(u32, ids.items, v.ids().image) orelse return error.NoImagePlaceholders;
+    var images = [_]lanes.stream.Image{.{ .pixels = p.pixels, .gh = p.gh, .gw = p.gw, .at = @intCast(at), .tokens = p.tokens, .hash = p.hash }};
+    var m = try q.vision_prompt.Media.init(init.gpa, v, ids.items, &images);
+    defer m.deinit();
+    // the prompt in chunks, every one at the same image tables: src and pos are prompt-indexed, cut at cache.len
+    var cache = try E.Cache.init(init.gpa, e, ids.items.len + steps + 64);
+    defer cache.deinit(init.gpa);
+    const im: E.Images = .{ .features = m.features.ptr, .src = m.src, .pos = m.pos };
+    var row: usize = 0;
+    while (row < ids.items.len) {
+        const n = @min(E.max_rows, ids.items.len - row);
+        try e.forward(&.{.{ .cache = &cache, .rows = n, .images = &im }}, ids.items[row..][0..n], .last);
+        row += n;
+    }
+    // the reply's rows rotate past the image's positions, exactly as cuda_prefill sets it
+    cache.delta = m.delta;
+    const last = try a.alloc(u8, std.mem.sliceAsBytes(cache.logits).len);
+    @memcpy(last, std.mem.sliceAsBytes(cache.logits));
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = try std.fmt.allocPrint(a, "{s}.logits.bf16", .{out}), .data = last });
+    var toks: std.ArrayList(u32) = .empty;
+    if (steps > 0) {
+        var next = top1(cache.logits);
+        try toks.append(a, next);
+        for (1..steps) |_| {
+            try e.forward(&.{.{ .cache = &cache, .rows = 1 }}, &.{next}, .logits);
+            next = top1(e.rowLogits(0));
+            try toks.append(a, next);
+        }
+    }
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = out, .data = std.mem.sliceAsBytes(toks.items) });
+    std.debug.print("image: grid {d} x {d}, {d} rows at {d} of a {d}-row prompt, delta {d}, {d} tokens\n", .{ p.gh, p.gw, p.tokens, at, ids.items.len, m.delta, toks.items.len });
+    for (toks.items) |t| std.debug.print(" {d}", .{t});
+    std.debug.print("\n", .{});
+    return 0;
+}
+
+/// The argmax of a row of bf16 logits.
+fn top1(row: []const u16) u32 {
+    var best: usize = 0;
+    var top: f32 = -std.math.inf(f32);
+    for (row, 0..) |h, i| {
+        const x: f32 = @bitCast(@as(u32, h) << 16);
+        if (x > top) {
+            top = x;
+            best = i;
+        }
+    }
+    return @intCast(best);
+}
