From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Thu, 19 Nov 2026 10:09:51 +0700
Subject: [PATCH 26/27] qwen3_5: TF_QWEN_PREFILL_TUNE keeps only the dropped
 barrier (integer widening measured slower)

---
 zig/kernels/cuda/prefill_attention.cu       |  2 +-
 zig/kernels/cuda/prefill_attention.cuh      |  2 +-
 zig/kernels/cuda/prefill_attention_rows.cuh | 17 +++--------------
 3 files changed, 5 insertions(+), 16 deletions(-)

diff --git a/zig/kernels/cuda/prefill_attention.cu b/zig/kernels/cuda/prefill_attention.cu
index 5bcfe4651..29c4c747a 100644
--- a/zig/kernels/cuda/prefill_attention.cu
+++ b/zig/kernels/cuda/prefill_attention.cu
@@ -117,7 +117,7 @@ hpattn8_whole_kernel(const __nv_bfloat16* __restrict__ q, const uint8_t* __restr
 #include "prefill_attention_rows.cuh"
 }
 
-// hpattn8_whole_kernel with TUNE: the same bits, one barrier an item and integer widening (TF_QWEN_PREFILL_TUNE=1).
+// hpattn8_whole_kernel with TUNE: the same bits, one barrier an item (TF_QWEN_PREFILL_TUNE=1).
 template <int D, int WARPS, int HPC, int NS>
 __global__ void __launch_bounds__(32 * WARPS, 1)
 hpattn8_whole_tune_kernel(const __nv_bfloat16* __restrict__ q, const uint8_t* __restrict__ kc, const uint8_t* __restrict__ vc,
diff --git a/zig/kernels/cuda/prefill_attention.cuh b/zig/kernels/cuda/prefill_attention.cuh
index a9e4e3966..06d286d08 100644
--- a/zig/kernels/cuda/prefill_attention.cuh
+++ b/zig/kernels/cuda/prefill_attention.cuh
@@ -21,7 +21,7 @@ using qmm_frag::mma0;
 constexpr int BN = 64, HALF = 32;             // keys a tile (the fold's unit), keys a staging slot
 constexpr float LOG2E = 1.4426950408889634f;
 constexpr int SMEM_MAX = 96 * 1024;
-constexpr int TUNE = 0;  // a kernel's own TUNE = 1: one barrier an fp8 item, e4m3 widened on integer lanes (same bits)
+constexpr int TUNE = 0;  // a kernel's own TUNE = 1: one barrier an fp8 item (same bits)
 
 using tf_common::cp_wait;
 
diff --git a/zig/kernels/cuda/prefill_attention_rows.cuh b/zig/kernels/cuda/prefill_attention_rows.cuh
index a4670f792..077f256d6 100644
--- a/zig/kernels/cuda/prefill_attention_rows.cuh
+++ b/zig/kernels/cuda/prefill_attention_rows.cuh
@@ -61,21 +61,10 @@
                 uint4 w;
                 const __nv_fp8x2_storage_t* e = reinterpret_cast<const __nv_fp8x2_storage_t*>(&pre[j]);
                 uint32_t* o = reinterpret_cast<uint32_t*>(&w);
-                if constexpr (TUNE) {
-                    const uint32_t* b = reinterpret_cast<const uint32_t*>(&pre[j]);
 #pragma unroll
-                    for (int k = 0; k < 4; ++k) {
-                        const int w = b[k / 2] >> (16 * (k % 2));
-                        const float lo = __uint_as_float((uint32_t)((w << 24) >> 4) & 0x87f00000u);
-                        const float hi = __uint_as_float((uint32_t)((w << 16) >> 4) & 0x87f00000u);
-                        o[k] = pack(__fmul_rn(__fmul_rn(lo, 0x1p120f), pre_s[j]), __fmul_rn(__fmul_rn(hi, 0x1p120f), pre_s[j]));
-                    }
-                } else {
-#pragma unroll
-                    for (int k = 0; k < 4; ++k) {
-                        const float2 x = __half22float2(__half2(__nv_cvt_fp8x2_to_halfraw2(e[k], __NV_E4M3)));
-                        o[k] = pack(__fmul_rn(x.x, pre_s[j]), __fmul_rn(x.y, pre_s[j]));
-                    }
+                for (int k = 0; k < 4; ++k) {
+                    const float2 x = __half22float2(__half2(__nv_cvt_fp8x2_to_halfraw2(e[k], __NV_E4M3)));
+                    o[k] = pack(__fmul_rn(x.x, pre_s[j]), __fmul_rn(x.y, pre_s[j]));
                 }
                 dst[sw<8 * CS>(i / C, i % C)] = w;
             }
