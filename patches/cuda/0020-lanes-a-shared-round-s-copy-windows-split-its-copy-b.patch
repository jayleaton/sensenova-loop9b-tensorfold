-//! A stream's copy window: narrow at first, 2 w + 1 while every copied row lands, narrow again on a miss.
+//! A stream's copy window: alone, 2 w + 1 while copies land; shared, its rate-weighted part of the round's budget.
+const std = @import("std");
 const Engine = @import("engine.zig").Engine;
 const Stream = @import("stream.zig").Stream;
 
-/// The current width for lone rounds and for rounds shared with other streams, kept apart (null: the first).
-pub const Widths = struct { lone: ?u32 = null, shared: ?u32 = null };
+/// The lone width (null: cfg.first_copy), this round's shared part, and the copied rows' decayed landed and offered.
+pub const Widths = struct { lone: ?u32 = null, share: ?u32 = null, landed: f64 = 0, offered: f64 = 0 };
 
-/// A shared round's first copy rows at most, as the narrow families' first_copy_rows (4 rows: 3 copies).
-const shared_first = 3;
+/// Rows of cfg.copy_rate's prior in a landing rate, the weight its history keeps a copy, and a round without one.
+const prior_rows = 4;
+const copy_decay = 0.9;
+const round_decay = 0.98;
 
-/// Which width a round grows: none for a priced proposer (a drafter) or allocate_shared_drafts rows.
 const Kind = enum { lone, shared, priced };
 
+/// None for a priced proposer (a drafter) or where allocate_shared_drafts prices the rows: they keep cfg.first_copy.
 fn kind(e: *const Engine, s: *const Stream) Kind {
     if (s.proposer) |p| if (p.vtable.priced) return .priced;
     return if (e.alone) .lone else if (e.cfg.allocate_shared_drafts) .priced else .shared;
 }
 
-/// The first width: a lone or priced stream's cfg.first_copy; an unpriced shared stream's no wider than shared_first.
-pub fn first(e: *const Engine, s: *const Stream) u32 {
-    return if (kind(e, s) == .shared) @min(e.cfg.first_copy, shared_first) else e.cfg.first_copy;
-}
-
 /// The copies this round may propose.
 pub fn current(e: *const Engine, s: *const Stream) u32 {
-    const width: ?u32 = switch (kind(e, s)) {
-        .lone => s.copy_width.lone,
-        .shared => s.copy_width.shared,
-        .priced => null,
+    return switch (kind(e, s)) {
+        .lone => s.copy_width.lone orelse e.cfg.first_copy,
+        .shared => s.copy_width.share orelse e.cfg.first_copy,
+        .priced => e.cfg.first_copy,
     };
-    return width orelse first(e, s);
 }
 
-/// After a copy window: widen it when all its own rows landed, else back to the first width.
-pub fn observe(e: *const Engine, s: *Stream, whole: bool) void {
-    const next = if (whole) @min(e.cfg.max_copy, 2 * current(e, s) + 1) else first(e, s);
-    switch (kind(e, s)) {
-        .lone => s.copy_width.lone = next,
-        .shared => s.copy_width.shared = next,
-        .priced => {},
+/// The stream's copied rows' landing rate, drifting back to cfg.copy_rate while it copies nothing.
+pub fn rate(e: *const Engine, s: *const Stream) f64 {
+    const w = s.copy_width;
+    return (w.landed + prior_rows * e.cfg.copy_rate) / (w.offered + prior_rows);
+}
+
+/// After a copy window of `own` rows, `kept` landing: its rate's history, and the lone width doubled or reset.
+pub fn observe(e: *const Engine, s: *Stream, kept: usize, own: usize) void {
+    const k = kind(e, s);
+    if (k == .priced) return;
+    const w = &s.copy_width;
+    w.landed = copy_decay * w.landed + @as(f64, @floatFromInt(kept));
+    w.offered = copy_decay * w.offered + @as(f64, @floatFromInt(own));
+    if (k == .lone) w.lone = if (kept == own) @min(e.cfg.max_copy, 2 * current(e, s) + 1) else e.cfg.first_copy;
+}
+
+/// A round's copy rows: the measured shared width less each stream's pending row, else one window's.
+pub fn budget(e: *const Engine, streams: usize, sampled: bool) u64 {
+    const most = streams * (1 + @as(u64, e.cfg.max_copy));
+    const measured = @min(e.rule.row_cost.leastRows(streams, sampled), most);
+    return if (measured > streams) measured - streams else e.cfg.max_copy;
+}
+
+/// Each copying stream's part of this round's budget by landing rate, none past cfg.max_copy; the others' none.
+pub fn share(e: *Engine, round: []const *Stream, sampled: bool) !void {
+    const a = e.arena.allocator();
+    var copying: std.ArrayList(*Stream) = .empty;
+    for (round) |s| {
+        s.copy_width.share = null;
+        s.copy_width.landed *= round_decay;
+        s.copy_width.offered *= round_decay;
+        if (s.drafts and kind(e, s) == .shared) try copying.append(a, s);
+    }
+    if (copying.items.len == 0) return;
+    const weights = try a.alloc(f64, copying.items.len);
+    for (weights, copying.items) |*w, s| w.* = rate(e, s);
+    const parts = try a.alloc(u32, copying.items.len);
+    split(budget(e, round.len, sampled), weights, e.cfg.max_copy, parts);
+    for (copying.items, parts) |s, p| s.copy_width.share = p;
+}
+
+/// `total` by `weights`, no part past `most` (its excess to the rest), the leftover rows by largest remainder.
+pub fn split(total: u64, weights: []const f64, most: u32, out: []u32) void {
+    @memset(out, 0);
+    var left = total;
+    var capped = true;
+    while (capped and left > 0) {
+        capped = false;
+        const sum = openWeight(weights, out, most);
+        if (sum <= 0) return;
+        for (weights, out) |w, *o| if (o.* < most and @as(f64, @floatFromInt(left)) * w / sum >= @as(f64, @floatFromInt(most))) {
+            o.* = most;
+            left -= most;
+            capped = true;
+        };
+    }
+    const sum = openWeight(weights, out, most);
+    if (sum <= 0 or left == 0) return;
+    const pool: f64 = @floatFromInt(left);
+    for (weights, out) |w, *o| if (o.* < most) {
+        o.* = @intFromFloat(@floor(pool * w / sum));
+        left -= o.*;
+    };
+    while (left > 0) : (left -= 1) {
+        var best: ?usize = null;
+        var gap: f64 = -std.math.inf(f64);
+        for (weights, out, 0..) |w, o, i| if (o < most and pool * w / sum - @as(f64, @floatFromInt(o)) > gap) {
+            gap = pool * w / sum - @as(f64, @floatFromInt(o));
+            best = i;
+        };
+        out[best orelse return] += 1;
     }
 }
+
+fn openWeight(weights: []const f64, out: []const u32, most: u32) f64 {
+    var sum: f64 = 0;
+    for (weights, out) |w, o| if (o < most) {
+        sum += w;
+    };
+    return sum;
+}
