From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Wed, 18 Nov 2026 15:19:16 +0700
Subject: [PATCH 14/22] lane host: a family's default decode share; qwen3_5
 CUDA takes 0.5

A family may declare decode_share; the lane host applies it beside a
filling prompt when more than one stream serves and neither
--decode-share nor TENSORFOLD_PREFILL_SHARE is set. qwen3_5 CUDA
declares 0.5, the share G uses: a reply decoding beside a 35K-token
prompt went from ~0.4 to ~7.4 tok/s on a GB10.
---
 zig/src/core/engine_api.zig              |  2 ++
 zig/src/core/lane_host.zig               |  2 +-
 zig/src/core/lane_host_env.zig           | 11 +++++++++++
 zig/src/core/lane_host_fill.zig          | 10 +++++-----
 zig/src/families/qwen3_5/cuda_native.zig |  1 +
 zig/src/native/cuda.zig                  |  1 +
 6 files changed, 21 insertions(+), 6 deletions(-)

diff --git a/zig/src/core/engine_api.zig b/zig/src/core/engine_api.zig
index 86c9a6b8b..f25f0535d 100644
--- a/zig/src/core/engine_api.zig
+++ b/zig/src/core/engine_api.zig
@@ -217,6 +217,8 @@ pub const Info = struct {
     prompt_cache_plan: ?PromptCachePlan = null,
     /// --decode-share: the reply's share of a fill step's wall time beside live decoders; null: the engine's default.
     decode_share: ?f64 = null,
+    /// The family's reply share beside a filling prompt, absent --decode-share and TENSORFOLD_PREFILL_SHARE.
+    family_decode_share: ?f64 = null,
     /// The engine scores decisions (`score`) and writes no text: the server refuses text requests.
     decides: bool = false,
     /// The engine is a reranker (it scores through `score`): the server answers POST /v1/rerank only when set.
diff --git a/zig/src/core/lane_host.zig b/zig/src/core/lane_host.zig
index c0cf72313..042cf6eca 100644
--- a/zig/src/core/lane_host.zig
+++ b/zig/src/core/lane_host.zig
@@ -107,7 +107,7 @@ pub const LaneHost = struct {
     pub fn init(gpa: Allocator, io: std.Io, core: *lanes.Engine, info_: Info) LaneHost {
         var shown = info_.ofLanes();
         shown.draft_sources = shown.draft_sources.ofLanes(core.cfg, shown.lanes);
-        return .{ .gpa = gpa, .io = io, .core = core, .info_ = shown, .share = .withDecode(info_.decode_share), .decode_cap = info_.decode_share != null, .prefix = .fromEnv(), .pressure = .fromEnv(), .srpt = .fromEnv(), .kv = ledger.of(info_) };
+        return .{ .gpa = gpa, .io = io, .core = core, .info_ = shown, .share = .withDecode(info_.decode_share, if (info_.lanes > 1) info_.family_decode_share else null), .decode_cap = info_.decode_share != null, .prefix = .fromEnv(), .pressure = .fromEnv(), .srpt = .fromEnv(), .kv = ledger.of(info_) };
     }
 
     /// A paged family's pool counts in this host's ledger, the only test its promises pass (#1943); before `start`.
diff --git a/zig/src/core/lane_host_env.zig b/zig/src/core/lane_host_env.zig
index 20787fecc..0dc8de8bb 100644
--- a/zig/src/core/lane_host_env.zig
+++ b/zig/src/core/lane_host_env.zig
@@ -79,3 +79,14 @@ test "prefill variables: a value its reader would turn into a default is refused
     try std.testing.expectEqual(Share.default_tokens, Share.tokensOf("2k"));
     try std.testing.expectEqual(@as(u64, 0), Share.budget("+5"));
 }
+
+test "a family's decode share applies only when neither --decode-share nor TENSORFOLD_PREFILL_SHARE is set" {
+    const env = @import("sys").env;
+    _ = env.unsetenv("TENSORFOLD_PREFILL_SHARE");
+    try std.testing.expectEqual(@as(f64, 0.5), Share.withDecode(null, 0.5).p);
+    try std.testing.expectEqual(@as(f64, 1), Share.withDecode(null, null).p);
+    try std.testing.expectEqual(@as(f64, 0.75), Share.withDecode(0.25, 0.5).p);
+    _ = env.setenv("TENSORFOLD_PREFILL_SHARE", "0.9", 1);
+    defer _ = env.unsetenv("TENSORFOLD_PREFILL_SHARE");
+    try std.testing.expectEqual(@as(f64, 0.9), Share.withDecode(null, 0.5).p);
+}
diff --git a/zig/src/core/lane_host_fill.zig b/zig/src/core/lane_host_fill.zig
index a1253dd14..e439888e2 100644
--- a/zig/src/core/lane_host_fill.zig
+++ b/zig/src/core/lane_host_fill.zig
@@ -83,15 +83,15 @@ pub const Share = struct {
         return .{ .p = @max(1 - x, min_share) };
     }
 
-    /// The env's share, with --decode-share's p in its place when given; the row budget always comes from the env.
-    pub fn withDecode(decode_share: ?f64) Share {
-        var s = fromEnv();
+    /// The env's share, else `family`'s, with --decode-share's p in its place when given; the env sets the row budget.
+    pub fn withDecode(decode_share: ?f64, family: ?f64) Share {
+        var s = fromEnv(family);
         if (decode_share) |x| s.p = fromDecode(x).p;
         return s;
     }
 
-    pub fn fromEnv() Share {
-        var s: Share = if (std.c.getenv("TENSORFOLD_PREFILL_SHARE")) |text| fromText(std.mem.span(text)) else .{};
+    pub fn fromEnv(family: ?f64) Share {
+        var s: Share = if (std.c.getenv("TENSORFOLD_PREFILL_SHARE")) |text| fromText(std.mem.span(text)) else if (family) |x| fromDecode(x) else .{};
         if (std.c.getenv("TENSORFOLD_PREFILL_BUDGET")) |text| s.rows = budget(std.mem.span(text));
         if (std.c.getenv("TENSORFOLD_PREFILL_POLICY")) |text| s.policy = policyOf(std.mem.span(text));
         if (std.c.getenv("TENSORFOLD_PREFILL_TOKENS")) |text| s.tokens = tokensOf(std.mem.span(text));
diff --git a/zig/src/families/qwen3_5/cuda_native.zig b/zig/src/families/qwen3_5/cuda_native.zig
index b8c0b84dd..b9d9d01ce 100644
--- a/zig/src/families/qwen3_5/cuda_native.zig
+++ b/zig/src/families/qwen3_5/cuda_native.zig
@@ -31,6 +31,7 @@ pub const linked = slide.linked;
 pub const model_type = "qwen3_5";
 pub const formats: []const []const u8 = &.{ "mlx-q4g64", "exl3" };
 pub const default_context: i64 = 32768;
+pub const decode_share: f64 = 0.5;
 /// A plain BF16 checkpoint's preflight counts its text tensors, not the tower and MTP in its shards.
 pub const textWeightBytes = @import("cuda_bf16_bytes.zig").textWeightBytes;
 pub const visionBytes = @import("cuda_bf16_bytes.zig").visionBytes;
diff --git a/zig/src/native/cuda.zig b/zig/src/native/cuda.zig
index 12855f5cf..38a14fc67 100644
--- a/zig/src/native/cuda.zig
+++ b/zig/src/native/cuda.zig
@@ -487,6 +487,7 @@ const toGib = family_memory.toGib;
 fn familyInfo(comptime F: type, host: api.Info) api.Info {
     var info = host;
     info.reasoning = reasoning(F);
+    if (@hasDecl(F, "decode_share")) info.family_decode_share = F.decode_share;
     return info;
 }
 
