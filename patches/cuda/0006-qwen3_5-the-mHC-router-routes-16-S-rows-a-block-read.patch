+// A block routes 16/S rows: the router's weights and each row are read once, the row's norm scales the dots after.
+template <int S>
+__device__ __forceinline__ void mhc_branch_rows(Geo geo, const __nv_bfloat16* __restrict__ HS, const float* __restrict__ W,
+                                                const float* __restrict__ B, __nv_bfloat16* __restrict__ BRANCH,
+                                                float* __restrict__ STATE, int rows, int iters, float pre_scale) {
+    constexpr int RB = 16 / S, N = 2 * S + S * S, V = N + 1, WARPS = 8;
+    const int H = geo.hid, D = S * H, r0 = (int)blockIdx.x * RB;
+    const int nr = min(RB, rows - r0);
+    if (nr <= 0) return;
+    __shared__ float part[WARPS][RB * V];
+    __shared__ float sums[RB * V];
+    float acc[RB][V];
+#pragma unroll
+    for (int r = 0; r < RB; r++)
+#pragma unroll
+        for (int v = 0; v < V; v++) acc[r][v] = 0.f;
     for (int i = threadIdx.x; i < D; i += blockDim.x) {
-        const float x = bf(HS[base + i]);
-        acc += x * x;
+        float w[N];
+#pragma unroll
+        for (int n = 0; n < N; n++) w[n] = W[(size_t)n * D + i];
+#pragma unroll
+        for (int r = 0; r < RB; r++) {
+            if (r < nr) {
+                const float x = bf(HS[(size_t)(r0 + r) * D + i]);
+                acc[r][N] += x * x;
+#pragma unroll
+                for (int n = 0; n < N; n++) acc[r][n] += w[n] * x;
+            }
+        }
     }
-    const float inv = rsqrtf(mhc_block_sum(acc, red) / (float)D + 1e-6f);
-    for (int n = 0; n < N; n++) {
-        const float* w = W + (size_t)n * D;
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+#pragma unroll
+    for (int r = 0; r < RB; r++)
+#pragma unroll
+        for (int v = 0; v < V; v++) {
+            float a = acc[r][v];
+            for (int o = 16; o > 0; o >>= 1) a += __shfl_xor_sync(0xffffffffu, a, o);
+            if (lane == 0) part[warp][r * V + v] = a;
+        }
+    __syncthreads();
+    for (int k = threadIdx.x; k < RB * V; k += blockDim.x) {
         float a = 0.f;
-        for (int i = threadIdx.x; i < D; i += blockDim.x) a += w[i] * (bf(HS[base + i]) * inv);
-        a = mhc_block_sum(a, red);
-        if (threadIdx.x == 0) logits[n] = a + (B == nullptr ? 0.f : B[n]);
-        __syncthreads();
+        for (int p = 0; p < WARPS; p++) a += part[p][k];
+        sums[k] = a;
     }
-    if (threadIdx.x == 0) {
-        float* st = STATE + (size_t)r * N;
+    __syncthreads();
+    if ((int)threadIdx.x < nr) {
+        const int r = threadIdx.x;
+        const float inv = rsqrtf(sums[r * V + N] / (float)D + 1e-6f);
+        float logits[N];
+        for (int n = 0; n < N; n++) logits[n] = sums[r * V + n] * inv + (B == nullptr ? 0.f : B[n]);
+        float* st = STATE + (size_t)(r0 + r) * N;
         for (int s = 0; s < S; s++) {
             st[s] = 1.f / (1.f + expf(-logits[s]));
             st[S + s] = 2.f / (1.f + expf(-logits[S + s]));
         }
-        float m[16];
+        float m[S * S];
         for (int i = 0; i < S * S; i++) m[i] = logits[2 * S + i];
         for (int it = 0; it < iters; it++) {
             for (int row = 0; row < S; row++) {
@@ -69,15 +84,27 @@ extern "C" __global__ void __launch_bounds__(256) tf_q35_mhc_branch(Geo geo, con
         for (int i = 0; i < S * S; i++) st[2 * S + i] = expf(m[i]);
     }
     __syncthreads();
-    const float* st = STATE + (size_t)r * N;
-    for (int d = threadIdx.x; d < H; d += blockDim.x) {
-        float b = 0.f;
-        for (int s = 0; s < S; s++) b += rbf(st[s]) * bf(HS[base + (size_t)s * H + d]);
-        if (pre_scale != 1.f) b *= pre_scale;
-        BRANCH[(size_t)r * H + d] = __float2bfloat16_rn(b);
+    for (int r = 0; r < nr; r++) {
+        const size_t base = (size_t)(r0 + r) * D;
+        const float* st = STATE + (size_t)(r0 + r) * N;
+        for (int d = threadIdx.x; d < H; d += blockDim.x) {
+            float b = 0.f;
+            for (int s = 0; s < S; s++) b += rbf(st[s]) * bf(HS[base + (size_t)s * H + d]);
+            if (pre_scale != 1.f) b *= pre_scale;
+            BRANCH[(size_t)(r0 + r) * H + d] = __float2bfloat16_rn(b);
+        }
     }
 }
 
+// The router: STATE holds a row's S pre, S post and S*S mix logits as f32, and h the branch the sublayer runs on.
+extern "C" __global__ void __launch_bounds__(256) tf_q35_mhc_branch(Geo geo, const __nv_bfloat16* __restrict__ HS,
+                                                                  const float* __restrict__ W, const float* __restrict__ B,
+                                                                  __nv_bfloat16* __restrict__ BRANCH, float* __restrict__ STATE,
+                                                                  int rows, int streams, int iters, float pre_scale) {
+    if (streams == 2) mhc_branch_rows<2>(geo, HS, W, B, BRANCH, STATE, rows, iters, pre_scale);
+    else mhc_branch_rows<4>(geo, HS, W, B, BRANCH, STATE, rows, iters, pre_scale);
+}
+
 // streams = mix @ streams + post * branch, a thread a (row, column), so no row reads what another thread rewrote.
