+
+// ---- mHC: manifold-constrained hyper-connections over a looped range. Two (or four) residual streams; a router
+// reads their row-normalised flattening, and a Sinkhorn-normalised map mixes them at each sublayer boundary. ----
+
+__device__ __forceinline__ float mhc_block_sum(float v, float* red) {
+    red[threadIdx.x] = v;
+    __syncthreads();
+    for (int s = 128; s > 0; s >>= 1) {
+        if (threadIdx.x < s) red[threadIdx.x] += red[threadIdx.x + s];
+        __syncthreads();
+    }
+    return red[0];
+}
+
+// The router: pre/post/mix from the streams, and the single branch (pre . streams) the sublayer then runs on.
+// STATE holds a row's S pre, S post and S*S mix logits as f32; it is the merge kernels' input.
+extern "C" __global__ void __launch_bounds__(256) tf_q35_mhc_branch(Geo geo, const __nv_bfloat16* __restrict__ HS,
+                                                                  const float* __restrict__ W, const float* __restrict__ B,
+                                                                  __nv_bfloat16* __restrict__ BRANCH, float* __restrict__ STATE,
+                                                                  int rows, int streams, int iters, float pre_scale) {
+    const int r = (int)blockIdx.x;
+    if (r >= rows) return;
+    const int H = geo.hid, S = streams, D = S * H, N = 2 * S + S * S;
+    const size_t base = (size_t)r * D;
+    __shared__ float red[256];
+    __shared__ float logits[24];
+    float acc = 0.f;
+    for (int i = threadIdx.x; i < D; i += blockDim.x) {
+        const float x = bf(HS[base + i]);
+        acc += x * x;
+    }
+    const float inv = rsqrtf(mhc_block_sum(acc, red) / (float)D + 1e-6f);
+    for (int n = 0; n < N; n++) {
+        const float* w = W + (size_t)n * D;
+        float a = 0.f;
+        for (int i = threadIdx.x; i < D; i += blockDim.x) a += w[i] * (bf(HS[base + i]) * inv);
+        a = mhc_block_sum(a, red);
+        if (threadIdx.x == 0) logits[n] = a + (B == nullptr ? 0.f : B[n]);
+        __syncthreads();
+    }
+    if (threadIdx.x == 0) {
+        float* st = STATE + (size_t)r * N;
+        for (int s = 0; s < S; s++) {
+            st[s] = 1.f / (1.f + expf(-logits[s]));
+            st[S + s] = 2.f / (1.f + expf(-logits[S + s]));
+        }
+        float m[16];
+        for (int i = 0; i < S * S; i++) m[i] = logits[2 * S + i];
+        for (int it = 0; it < iters; it++) {
+            for (int row = 0; row < S; row++) {
+                float mx = -INFINITY;
+                for (int c = 0; c < S; c++) mx = fmaxf(mx, m[row * S + c]);
+                float sum = 0.f;
+                for (int c = 0; c < S; c++) sum += expf(m[row * S + c] - mx);
+                const float lz = mx + logf(sum);
+                for (int c = 0; c < S; c++) m[row * S + c] -= lz;
+            }
+            for (int c = 0; c < S; c++) {
+                float mx = -INFINITY;
+                for (int row = 0; row < S; row++) mx = fmaxf(mx, m[row * S + c]);
+                float sum = 0.f;
+                for (int row = 0; row < S; row++) sum += expf(m[row * S + c] - mx);
+                const float lz = mx + logf(sum);
+                for (int row = 0; row < S; row++) m[row * S + c] -= lz;
+            }
+        }
+        for (int i = 0; i < S * S; i++) st[2 * S + i] = expf(m[i]);
+    }
+    __syncthreads();
+    const float* st = STATE + (size_t)r * N;
+    for (int d = threadIdx.x; d < H; d += blockDim.x) {
+        float b = 0.f;
+        for (int s = 0; s < S; s++) b += rbf(st[s]) * bf(HS[base + (size_t)s * H + d]);
+        if (pre_scale != 1.f) b *= pre_scale;
+        BRANCH[(size_t)r * H + d] = __float2bfloat16_rn(b);
+    }
+}
+
+// streams = mix @ streams + post * branch, one thread a (row, column): the S outputs of a column read the same
+// S inputs, so no thread writes a value another still has to read.
+extern "C" __global__ void __launch_bounds__(256) tf_q35_mhc_merge(Geo geo, const __nv_bfloat16* __restrict__ BRANCH,
+                                                                 const float* __restrict__ STATE, __nv_bfloat16* __restrict__ HS,
+                                                                 int rows, int streams) {
+    const int H = geo.hid, S = streams, N = 2 * S + S * S;
+    const size_t work = (size_t)rows * H;
+    for (size_t i = (size_t)blockIdx.x * blockDim.x + threadIdx.x; i < work; i += (size_t)gridDim.x * blockDim.x) {
+        const int r = (int)(i / H), d = (int)(i % H);
+        const float* st = STATE + (size_t)r * N;
+        const __nv_bfloat16* row = HS + (size_t)r * S * H + d;
+        const float b = bf(BRANCH[(size_t)r * H + d]);
+        float out[4];
+        for (int s = 0; s < S; s++) {
+            float a = 0.f;
+            for (int t = 0; t < S; t++) a += rbf(st[2 * S + s * S + t]) * bf(row[(size_t)t * H]);
+            out[s] = a + rbf(st[S + s]) * b;
+        }
+        for (int s = 0; s < S; s++) HS[(size_t)r * S * H + (size_t)s * H + d] = __float2bfloat16_rn(out[s]);
+    }
+}
+
+// h into every stream (the window's first execution), and the streams' mean back into h (its last).
+// R (may be null) is the previous layer's output, still unfolded: the window's first execution folds it in, as the
+// norm that would have run there does.
+extern "C" __global__ void __launch_bounds__(256) tf_q35_mhc_enter(Geo geo, const __nv_bfloat16* __restrict__ H,
+                                                                 const __nv_bfloat16* __restrict__ R, __nv_bfloat16* __restrict__ HS,
+                                                                 int rows, int streams) {
+    const int Hd = geo.hid, S = streams;
+    const size_t work = (size_t)rows * Hd;
+    for (size_t i = (size_t)blockIdx.x * blockDim.x + threadIdx.x; i < work; i += (size_t)gridDim.x * blockDim.x) {
+        const int r = (int)(i / Hd), d = (int)(i % Hd);
+        const float v = bf(H[i]) + (R == nullptr ? 0.f : bf(R[i]));
+        const __nv_bfloat16 o = __float2bfloat16_rn(v);
+        for (int s = 0; s < S; s++) HS[(size_t)r * S * Hd + (size_t)s * Hd + d] = o;
+    }
+}
+
+extern "C" __global__ void __launch_bounds__(256) tf_q35_mhc_leave(Geo geo, const __nv_bfloat16* __restrict__ HS,
+                                                                 __nv_bfloat16* __restrict__ H, int rows, int streams) {
+    const int Hd = geo.hid, S = streams;
+    const size_t work = (size_t)rows * Hd;
+    for (size_t i = (size_t)blockIdx.x * blockDim.x + threadIdx.x; i < work; i += (size_t)gridDim.x * blockDim.x) {
+        const int r = (int)(i / Hd), d = (int)(i % Hd);
+        float a = 0.f;
+        for (int s = 0; s < S; s++) a += bf(HS[(size_t)r * S * Hd + (size_t)s * Hd + d]);
+        H[i] = __float2bfloat16_rn(a / (float)S);
+    }
+}
