+/// h into every stream: the mHC window's first execution.
+fn mhcEnter(e: *E.Engine, rows: usize, streams: usize, fold: bool) !void {
+    const geo = e.geo;
+    try launch(e, e.fns.mhc_enter, sig.mhc_enter, .{ (rows * e.g.hidden + 255) / 256, 1, 1 }, .{ 256, 1, 1 }, .{ geo, e.h, if (fold) e.r else @as(u64, 0), e.hs, @as(c_int, @intCast(rows)), @as(c_int, @intCast(streams)) });
+}
+
+/// The streams' mean into h: the window's last execution.
+fn mhcLeave(e: *E.Engine, rows: usize, streams: usize) !void {
+    const geo = e.geo;
+    try launch(e, e.fns.mhc_leave, sig.mhc_leave, .{ (rows * e.g.hidden + 255) / 256, 1, 1 }, .{ 256, 1, 1 }, .{ geo, e.hs, e.h, @as(c_int, @intCast(rows)), @as(c_int, @intCast(streams)) });
+}
+
+/// A sublayer's branch out of the streams (into h), with its pre/post/mix kept for the merge.
+fn mhcBranch(e: *E.Engine, w: u64, b: u64, rows: usize, m: geometry.Mhc) !void {
+    const geo = e.geo;
+    try launch(e, e.fns.mhc_branch, sig.mhc_branch, .{ rows, 1, 1 }, .{ 256, 1, 1 }, .{ geo, e.hs, w, b, e.h, e.mhc_state, @as(c_int, @intCast(rows)), @as(c_int, @intCast(m.streams)), @as(c_int, @intCast(m.iterations)), @as(f32, m.pre_scale) });
+}
+
+/// The sublayer's output (r) back into the streams.
+fn mhcMerge(e: *E.Engine, rows: usize, streams: usize) !void {
+    const geo = e.geo;
+    try launch(e, e.fns.mhc_merge, sig.mhc_merge, .{ (rows * e.g.hidden + 255) / 256, 1, 1 }, .{ 256, 1, 1 }, .{ geo, e.r, e.mhc_state, e.hs, @as(c_int, @intCast(rows)), @as(c_int, @intCast(streams)) });
+}
