diff --git a/zig/src/families/qwen3_5/cuda_loop_plan.zig b/zig/src/families/qwen3_5/cuda_loop_plan.zig
new file mode 100644
index 000000000..e1285c6e9
--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_loop_plan.zig
@@ -0,0 +1,83 @@
+//! A Qwen3.5 looped checkpoint's root blocks: the shared-weight loop and its manifold-constrained streams.
+const std = @import("std");
+const geometry = @import("cuda_geometry.zig");
+
+/// A JSON object, or the refusal every one of these blocks shares.
+fn object(v: std.json.Value) !std.json.ObjectMap {
+    return if (v == .object) v.object else error.UnsupportedQwenGeometry;
+}
+
+/// A positive whole field.
+fn integer(o: std.json.ObjectMap, key: []const u8) !usize {
+    const v = o.get(key) orelse return error.UnsupportedQwenGeometry;
+    if (v != .integer or v.integer < 1) return error.UnsupportedQwenGeometry;
+    return @intCast(v.integer);
+}
+
+/// A number, integer or float.
+fn number(o: std.json.ObjectMap, key: []const u8) !f64 {
+    return switch (o.get(key) orelse return error.UnsupportedQwenGeometry) {
+        .integer => |i| @floatFromInt(i),
+        .float => |f| f,
+        else => error.UnsupportedQwenGeometry,
+    };
+}
+
+/// `loop_settings`: the shared-weight loop, as the reference's `execution_plan` reads it. Absent: every layer once.
+pub fn read(g: *geometry.Geometry, root: std.json.ObjectMap) !void {
+    try loopPlan(g, root);
+    try mhcSettings(g, root);
+}
+
+fn loopPlan(g: *geometry.Geometry, root: std.json.ObjectMap) !void {
+    const v = root.get("loop_settings") orelse return;
+    const o = try object(v);
+    const start = try integer(o, "start");
+    const end = try integer(o, "end");
+    const count = try integer(o, "eval_count");
+    if (start >= end or end > g.layers or count < 1) return error.UnsupportedQwenGeometry;
+    // the reference runs fixed-count loop checkpoints only: `counts` is exactly [eval_count] when present
+    if (o.get("counts")) |c| {
+        if (c != .array or c.array.items.len != 1) return error.UnsupportedQwenGeometry;
+        if (c.array.items[0] != .integer or c.array.items[0].integer != @as(i64, @intCast(count))) return error.UnsupportedQwenGeometry;
+    }
+    const steps = start + count * (end - start) + (g.layers - end);
+    if (steps > geometry.max_steps) return error.UnsupportedQwenGeometry;
+    g.loop_start = start;
+    g.loop_end = end;
+    g.loop_count = count;
+}
+
+/// `mhc`: manifold-constrained hyper-connections over one loop phase, as the reference's plan validator reads them.
+fn mhcSettings(g: *geometry.Geometry, root: std.json.ObjectMap) !void {
+    const v = root.get("mhc") orelse return;
+    const o = try object(v);
+    const start = try integer(o, "start");
+    const end = try integer(o, "end");
+    const streams = try integer(o, "streams");
+    const iterations = try integer(o, "iterations");
+    if (start >= end or end > g.layers or (streams != 2 and streams != 4) or iterations < 1 or iterations > 64)
+        return error.UnsupportedQwenGeometry;
+    var fixed = false;
+    if (o.get("fixed_identity")) |f| {
+        if (f != .bool) return error.UnsupportedQwenGeometry;
+        fixed = f.bool;
+    }
+    var pre: f32 = 1;
+    if (o.get("pre_scale")) |s| {
+        _ = s;
+        pre = @floatCast(try number(o, "pre_scale"));
+        if (!std.math.isFinite(pre) or pre <= 0) return error.UnsupportedQwenGeometry;
+    }
+    // the window cannot cross a loop phase boundary: the streams would have to survive a collapse
+    const phases = [_][2]usize{ .{ 0, g.loop_start }, .{ g.loop_start, g.loop_end }, .{ g.loop_end, g.layers } };
+    var inside = false;
+    for (phases) |p| if (p[0] <= start and end <= p[1]) {
+        inside = true;
+    };
+    if (!inside) return error.UnsupportedQwenGeometry;
+    // the kernels mix with the learned map only: an identity map would have to skip the Sinkhorn
+    if (fixed) return error.UnsupportedQwenGeometry;
+    g.mhc = .{ .start = start, .end = end, .streams = streams, .iterations = iterations, .fixed_identity = fixed, .pre_scale = pre };
+}
+
