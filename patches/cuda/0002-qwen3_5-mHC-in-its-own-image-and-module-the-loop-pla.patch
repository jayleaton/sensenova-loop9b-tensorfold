index 000000000..421d7e6b2
--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_loop_plan_test.zig
@@ -0,0 +1,38 @@
+//! The loop plan and mHC validation, at SenseNova-Loop-9B's own shape.
+const std = @import("std");
+const parse = @import("cuda_geometry.zig").parse;
+
+test "SenseNova-Loop-9B: [4,28) twice over 32 layers is 56 executions, 14 attention slots and 42 delta slots" {
+    const a = std.testing.allocator;
+    var json: std.ArrayList(u8) = .empty;
+    defer json.deinit(a);
+    try json.appendSlice(a, "{\"model_type\":\"sensenova_loop\",\"quantization\":{\"group_size\":64,\"bits\":8,\"mode\":\"affine\"},\"tie_word_embeddings\":false,\"loop_settings\":{\"counts\":[2],\"end\":28,\"eval_count\":2,\"start\":4},\"mhc\":{\"end\":28,\"fixed_identity\":false,\"iterations\":20,\"pre_scale\":1.0,\"start\":4,\"streams\":2},\"text_config\":{\"model_type\":\"qwen3_5_text\",\"attention_bias\":false,\"attn_output_gate\":true,\"hidden_act\":\"silu\",\"head_dim\":256,\"linear_key_head_dim\":128,\"linear_value_head_dim\":128,\"linear_conv_kernel_dim\":4,\"hidden_size\":4096,\"intermediate_size\":12288,\"num_hidden_layers\":32,\"vocab_size\":248320,\"linear_num_key_heads\":16,\"linear_num_value_heads\":32,\"num_attention_heads\":16,\"num_key_value_heads\":4,\"rms_norm_eps\":1e-06,\"max_position_embeddings\":524288,\"layer_types\":[");
+    for (0..32) |i| {
+        if (i != 0) try json.append(a, ',');
+        try json.appendSlice(a, if ((i + 1) % 4 == 0) "\"full_attention\"" else "\"linear_attention\"");
+    }
+    try json.appendSlice(a, "],\"rope_parameters\":{\"rope_type\":\"yarn\",\"rope_theta\":10000000,\"partial_rotary_factor\":0.25,\"factor\":2.0,\"original_max_position_embeddings\":262144}}}");
+    const g = try parse(a, json.items);
+    try std.testing.expectEqual(@as(usize, 56), g.steps());
+    try std.testing.expectEqual(@as(usize, 14), g.attentions());
+    try std.testing.expectEqual(@as(usize, 42), g.deltas());
+    try std.testing.expectEqual(@as(usize, 3), g.physical(3));
+    try std.testing.expectEqual(@as(usize, 4), g.physical(4));
+    try std.testing.expectEqual(@as(usize, 27), g.physical(27));
+    try std.testing.expectEqual(@as(usize, 4), g.physical(28)); // the loop's second pass restarts at 4
+    try std.testing.expectEqual(@as(usize, 27), g.physical(51));
+    try std.testing.expectEqual(@as(usize, 28), g.physical(52));
+    try std.testing.expectEqual(@as(usize, 31), g.physical(55));
+    // a token's keys and values: 14 executions of 4 KV heads of 256, K and V, bf16
+    try std.testing.expectEqual(@as(usize, 14 * 4096), g.kvBytes(1, false));
+    try std.testing.expectEqual(@as(usize, 42 * (32 * 128 * 128 * 4 + 3 * 8192 * 2)), g.stateBytes());
+    const m = g.mhc.?;
+    try std.testing.expectEqual(@as(usize, 8), m.outputs());
+    try std.testing.expect(m.holds(4) and m.holds(27) and !m.holds(3) and !m.holds(28));
+    // a looped model has no physical stage slice, and a learned identity map is not what the kernels run
+    try std.testing.expectError(error.BadStageRange, g.stage(0, 16, false));
+    const fixed = try std.mem.replaceOwned(u8, a, json.items, "\"fixed_identity\":false", "\"fixed_identity\":true");
+    defer a.free(fixed);
+    try std.testing.expectError(error.UnsupportedQwenGeometry, parse(a, fixed));
+}
+
diff --git a/zig/src/families/qwen3_5/cuda_mhc.zig b/zig/src/families/qwen3_5/cuda_mhc.zig
