index 000000000..c99b22c26
--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_mhc.zig
@@ -0,0 +1,40 @@
+//! SenseNova-Loop's mHC: its own kernel image, and the four launches the forward makes through it.
+const E = @import("cuda_engine.zig");
+const geometry = @import("cuda_geometry.zig");
+const sig = @import("cuda_signatures.zig");
+const launch = @import("cuda_forward.zig").launch;
+
+/// The kernels' image (module 19), under the family's symbol prefix.
+pub fn install(e: *E.Engine) !void {
+    inline for (kernels) |name| @field(e.fns, name) = try e.mods[19].function("tf_q35_" ++ name);
+}
+
+/// The bf16 tiles' two buffers, which the shared-memory opt-in must declare.
+pub const tiles = @import("cuda_forward.zig").attn_tiles;
+
+const kernels = .{ "mhc_branch", "mhc_merge", "mhc_enter", "mhc_leave" };
+
+/// h into every stream at the window's entry, folding the previous layer's output when it is still pending.
+pub fn enter(e: *E.Engine, rows: usize, m: geometry.Mhc, fold: bool) !void {
+    const geo = e.geo;
+    const r: u64 = if (fold) e.r else 0;
+    try launch(e, e.fns.mhc_enter, sig.mhc_enter, .{ (rows * e.g.hidden + 255) / 256, 1, 1 }, .{ 256, 1, 1 }, .{ geo, e.h, r, e.hs, @as(c_int, @intCast(rows)), @as(c_int, @intCast(m.streams)) });
+}
+
+/// The streams' mean into h: the window's last execution.
+pub fn leave(e: *E.Engine, rows: usize, m: geometry.Mhc) !void {
+    const geo = e.geo;
+    try launch(e, e.fns.mhc_leave, sig.mhc_leave, .{ (rows * e.g.hidden + 255) / 256, 1, 1 }, .{ 256, 1, 1 }, .{ geo, e.hs, e.h, @as(c_int, @intCast(rows)), @as(c_int, @intCast(m.streams)) });
+}
+
+/// A sublayer's branch out of the streams (into h), with its pre/post/mix kept for the merge.
+pub fn branch(e: *E.Engine, w: u64, b: u64, rows: usize, m: geometry.Mhc) !void {
+    const geo = e.geo;
+    try launch(e, e.fns.mhc_branch, sig.mhc_branch, .{ rows, 1, 1 }, .{ 256, 1, 1 }, .{ geo, e.hs, w, b, e.h, e.mhc_state, @as(c_int, @intCast(rows)), @as(c_int, @intCast(m.streams)), @as(c_int, @intCast(m.iterations)), @as(f32, m.pre_scale) });
+}
+
+/// The sublayer's output (r) back into the streams.
+pub fn merge(e: *E.Engine, rows: usize, m: geometry.Mhc) !void {
+    const geo = e.geo;
+    try launch(e, e.fns.mhc_merge, sig.mhc_merge, .{ (rows * e.g.hidden + 255) / 256, 1, 1 }, .{ 256, 1, 1 }, .{ geo, e.r, e.mhc_state, e.hs, @as(c_int, @intCast(rows)), @as(c_int, @intCast(m.streams)) });
+}
