+"""The norm mapping that makes SenseNova-Loop-9B load with the right scale."""
+import numpy as np
+import torch
+
+from sensenova_loop_mlx import zero_centered
+
+
+def test_the_gated_norm_is_not_zero_centred():
+    assert not zero_centered("language_model.model.layers.0.linear_attn.norm.weight")
+
+
+def test_every_qwen3_5rmsnorm_weight_is_zero_centred():
+    for name in (
+        "language_model.model.layers.0.input_layernorm.weight",
+        "language_model.model.layers.0.post_attention_layernorm.weight",
+        "language_model.model.norm.weight",
+        "language_model.model.layers.3.self_attn.q_norm.weight",
+        "language_model.model.layers.3.self_attn.k_norm.weight",
+    ):
+        assert zero_centered(name), name
+
+
+def test_projections_and_the_embedding_are_left_alone():
+    for name in (
+        "language_model.model.embed_tokens.weight",
+        "language_model.model.layers.0.mlp.down_proj.weight",
+        "language_model.model.layers.0.linear_attn.in_proj_qkv.weight",
+        "language_model.lm_head.weight",
+    ):
+        assert not zero_centered(name), name
+
+
+def test_folding_one_turns_a_zero_centred_norm_into_a_multiplier():
+    # the released checkpoint's layer-0 input norm has rms 0.0492 and mean 0.0331; `1 + w` must land near one
+    w = torch.tensor([0.0331] * 4096)
+    assert abs(float((w.float() + 1.0).pow(2).mean().sqrt()) - 1.0336) < 1e-3
+    assert abs(float((w.float()).pow(2).mean().sqrt()) - 0.0331) < 1e-3
