         const all = (@as(u16, 1) << @intCast(t.count)) - 1;
-        if (t.seen != all) return error.IncompleteTaps;
+        // a run may ask for the narrow tape's seams alone: then the streams tape legitimately holds none
+        if (t.seen != all and !(t.seen == 0 and t.half_seen != 0)) return error.IncompleteTaps;
     }
 
