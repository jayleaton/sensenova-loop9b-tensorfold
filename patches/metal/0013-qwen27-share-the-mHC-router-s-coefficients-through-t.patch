From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Wed, 18 Nov 2026 03:58:12 +0800
Subject: [PATCH 13/44] qwen27: share the mHC router's coefficients through
 threadgroup memory

The branch kernel wrote pre/post/mix to device memory from lane 0 and then read
them in the other lanes behind a mem_threadgroup barrier, which orders nothing
about device writes. The coefficients now go through a threadgroup array, the
barrier orders them, and lane 0 copies them to device afterwards for the merge
that reads them next.

Also fixes the tap routing: a seam id at or past seam_base goes to the narrow
tape and a layer id to the streams tape, and a run may ask for either alone.
---
 zig/kernels/metal/qwen27/mhc.metal  | 16 +++++++++++-----
 zig/src/families/qwen27/forward.zig | 16 ++++++++++------
 zig/src/families/qwen27/mhc.zig     |  6 +++---
 zig/src/families/qwen27/taps.zig    | 17 ++++++++++++++++-
 4 files changed, 40 insertions(+), 15 deletions(-)

diff --git a/zig/kernels/metal/qwen27/mhc.metal b/zig/kernels/metal/qwen27/mhc.metal
index 650eefa71..f1006745c 100644
--- a/zig/kernels/metal/qwen27/mhc.metal
+++ b/zig/kernels/metal/qwen27/mhc.metal
@@ -20,6 +20,8 @@ static inline float tf_mhc_rbf(float v) {
   const uint S = a.streams, n = a.outs, H = a.hidden, D = S * H;
   if (S == 0u || S > 4u || n > 8u) return;
   threadgroup float mean;
+  // the coefficients lane 0 computes, shared through threadgroup memory: a barrier orders that space, not device
+  threadgroup float coef[24];
   // the row's mean square over the flattened streams, then one simdgroup an output's dot product
   float acc = 0.f;
   for (uint s = 0; s < S; ++s) for (uint i = lane; i < H; i += 32u) {
@@ -42,11 +44,10 @@ static inline float tf_mhc_rbf(float v) {
     logits[o] = s + (B == nullptr ? 0.f : B[o]);
   }
   // the coefficients: pre sigmoid, post 2 sigmoid, mix Sinkhorn-normalized in log space
-  float* st = STATE + uint64_t(row) * n;
   if (lane == 0) {
     for (uint s = 0; s < S; ++s) {
-      st[s] = 1.f / (1.f + exp(-logits[s]));
-      st[S + s] = 2.f / (1.f + exp(-logits[S + s]));
+      coef[s] = 1.f / (1.f + exp(-logits[s]));
+      coef[S + s] = 2.f / (1.f + exp(-logits[S + s]));
     }
     float m[16];
     for (uint i = 0; i < S * S; ++i) m[i] = logits[2 * S + i];
@@ -68,12 +69,17 @@ static inline float tf_mhc_rbf(float v) {
         for (uint r = 0; r < S; ++r) m[r * S + c] -= lz;
       }
     }
-    for (uint i = 0; i < S * S; ++i) st[2 * S + i] = exp(m[i]);
+    for (uint i = 0; i < S * S; ++i) coef[2 * S + i] = exp(m[i]);
   }
   threadgroup_barrier(mem_flags::mem_threadgroup);
+  // the merge kernel reads these later, so device memory gets its own copy after the shared ones are final
+  if (lane == 0) {
+    float* st = STATE + uint64_t(row) * n;
+    for (uint i = 0; i < n; ++i) st[i] = coef[i];
+  }
   for (uint d = lane; d < H; d += 32u) {
     float b = 0.f;
-    for (uint s = 0; s < S; ++s) b += tf_mhc_rbf(st[s]) * float(HS[row * S * H + s * H + d]);
+    for (uint s = 0; s < S; ++s) b += tf_mhc_rbf(coef[s]) * float(HS[row * S * H + s * H + d]);
     if (a.pre_scale != 1.f) b *= a.pre_scale;
     BRANCH[row * H + d] = bfloat(b);
   }
