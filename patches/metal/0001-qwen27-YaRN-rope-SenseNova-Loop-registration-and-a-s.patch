diff --git a/zig/src/core/loop_schedule.zig b/zig/src/core/loop_schedule.zig
new file mode 100644
index 000000000..f3d03eb4b
--- /dev/null
+++ b/zig/src/core/loop_schedule.zig
@@ -0,0 +1,301 @@
+//! A shared-weight layer schedule and the mHC range inside it: which physical layer each execution runs.
+const std = @import("std");
+
+/// Each refusal names the key at fault.
+pub const Error = error{
+    MissingLoopSettings,
+    BadLoopInterval,
+    OnlyFixedCountLoops,
+    NoFullAttention,
+    BadMhcRange,
+    BadMhcStreams,
+    BadMhcIterations,
+    BadMhcFlag,
+    BadMhcScale,
+    UnknownMhcField,
+    MhcCrossesPhaseBoundary,
+};
+
+pub const max_layers = 128;
+pub const max_visits = 4;
+
+/// The executions in order: physical layers `[0,start)`, then `[start,end)` `passes` times, then `[end,layers)`.
+pub const Plan = struct {
+    order: [max_layers * max_visits]u16 = @splat(0),
+    /// The mixer's index among executions of its own kind: the state pool's layer slot, per execution.
+    slots: [max_layers * max_visits]u16 = @splat(0),
+    len: usize = 0,
+    layers: usize = 0,
+    start: usize = 0,
+    end: usize = 0,
+    passes: usize = 1,
+    linear: usize = 0,
+    attention: usize = 0,
+
+    /// A model without a loop runs every layer once.
+    pub fn loops(p: Plan) bool {
+        return p.passes != 1;
+    }
+
+    /// The physical layer execution `exec` runs.
+    pub fn physical(p: Plan, exec: usize) usize {
+        return p.order[exec];
+    }
+
+    /// The state-pool layer slot of execution `exec`, in its own kind's numbering.
+    pub fn slot(p: Plan, exec: usize) usize {
+        return p.slots[exec];
+    }
+
+    /// Which visit of its physical layer execution `exec` is: 0 for the first, 1 for a loop's second.
+    pub fn visit(p: Plan, exec: usize) usize {
+        const phys = p.order[exec];
+        var seen: usize = 0;
+        var i: usize = 0;
+        while (i < exec) : (i += 1) {
+            if (p.order[i] == phys) seen += 1;
+        }
+        return seen;
+    }
+
+    /// Fills `slots`, `linear` and `attention` for a model whose full-attention layers `is_attention` names.
+    pub fn count(p: *Plan, is_attention: []const bool) void {
+        var linear: usize = 0;
+        var attention: usize = 0;
+        var exec: usize = 0;
+        while (exec < p.len) : (exec += 1) {
+            if (is_attention[p.order[exec]]) {
+                p.slots[exec] = @intCast(attention);
+                attention += 1;
+            } else {
+                p.slots[exec] = @intCast(linear);
+                linear += 1;
+            }
+        }
+        p.linear = linear;
+        p.attention = attention;
+    }
+};
+
+/// The two-stream (or four) mHC wrapping: its range, streams, Sinkhorn iterations and pre-scale.
+pub const Mhc = struct {
+    start: usize,
+    end: usize,
+    streams: u8,
+    iterations: u8,
+    fixed_identity: bool,
+    pre_scale: f32,
+
+    /// Whether a physical layer this execution runs carries the wrapping.
+    pub fn holds(m: Mhc, phys: usize) bool {
+        return phys >= m.start and phys < m.end;
+    }
+};
+
+/// Reads `loop_settings` into `plan`: absent keeps one pass over every layer; a loop repeats `[start,end)`.
+pub fn read(plan: *Plan, value: ?std.json.Value, layers: usize, any_full: bool) Error!void {
+    if (layers == 0 or layers > max_layers) return error.BadLoopInterval;
+    if (!any_full) return error.NoFullAttention;
+    const absent = value orelse .null;
+    if (absent == .null) {
+        plan.* = .{ .len = layers, .layers = layers, .end = layers };
+        for (0..layers) |i| plan.order[i] = @intCast(i);
+        return;
+    }
+    if (absent != .object) return error.MissingLoopSettings;
+    const o = absent.object;
+    const start = try whole(o.get("start"));
+    const end = try whole(o.get("end"));
+    const count = try whole(o.get("eval_count"));
+    if (start >= end or end > layers or count < 1) return error.BadLoopInterval;
+    if (start + (end - start) * count + (layers - end) > plan.order.len) return error.BadLoopInterval;
+    // only a fixed count is supported: one entry in `counts`, equal to `eval_count`
+    const counts = o.get("counts") orelse return error.OnlyFixedCountLoops;
+    if (counts != .array or counts.array.items.len != 1) return error.OnlyFixedCountLoops;
+    if (try whole(counts.array.items[0]) != count) return error.OnlyFixedCountLoops;
+    plan.* = .{ .layers = layers, .start = start, .end = end, .passes = count };
+    var n: usize = 0;
+    for (0..start) |i| {
+        plan.order[n] = @intCast(i);
+        n += 1;
+    }
+    for (0..count) |_| for (start..end) |i| {
+        plan.order[n] = @intCast(i);
+        n += 1;
+    };
+    for (end..layers) |i| {
+        plan.order[n] = @intCast(i);
+        n += 1;
+    }
+    plan.len = n;
+}
+
+/// Reads `mhc`: absent or null means no wrapping; its range must sit inside one Loop phase.
+pub fn readMhc(value: ?std.json.Value, plan: Plan) Error!?Mhc {
+    const v = value orelse .null;
+    if (v == .null) return null;
+    if (v != .object) return error.BadMhcRange;
+    const o = v.object;
+    for (o.keys()) |k| {
+        if (std.mem.eql(u8, k, "start") or std.mem.eql(u8, k, "end") or std.mem.eql(u8, k, "streams")) continue;
+        if (std.mem.eql(u8, k, "iterations") or std.mem.eql(u8, k, "fixed_identity") or std.mem.eql(u8, k, "pre_scale")) continue;
+        return error.UnknownMhcField;
+    }
+    const start = try whole(o.get("start"));
+    const end = try whole(o.get("end"));
+    const streams = try whole(o.get("streams"));
+    if (start >= end or end > plan.layers) return error.BadMhcRange;
+    if (streams != 2 and streams != 4) return error.BadMhcStreams;
+    const iterations = try whole(o.get("iterations"));
+    if (iterations < 1 or iterations > 255) return error.BadMhcIterations;
+    const identity = o.get("fixed_identity") orelse return error.BadMhcFlag;
+    if (identity != .bool) return error.BadMhcFlag;
+    const scaled: std.json.Value = o.get("pre_scale") orelse .{ .float = 1.0 };
+    const s: f32 = switch (scaled) {
+        .integer => |i| @floatFromInt(i),
+        .float => |f| @floatCast(f),
+        else => return error.BadMhcScale,
+    };
+    if (!std.math.isFinite(s) or s <= 0) return error.BadMhcScale;
+    if (!withinPhase(start, end, plan)) return error.MhcCrossesPhaseBoundary;
+    return .{
+        .start = start,
+        .end = end,
+        .streams = @intCast(streams),
+        .iterations = @intCast(iterations),
+        .fixed_identity = identity.bool,
+        .pre_scale = s,
+    };
+}
+
+/// Whether `[start,end)` sits inside one Loop phase: before it, inside it, or after it.
+fn withinPhase(start: usize, end: usize, plan: Plan) bool {
+    const bounds = [_][2]usize{
+        .{ 0, plan.start },
+        .{ plan.start, plan.end },
+        .{ plan.end, plan.layers },
+    };
+    if (plan.layers == 0) return false;
+    for (bounds) |b| {
+        if (b[0] < b[1] and start >= b[0] and end <= b[1]) return true;
+    }
+    return false;
+}
+
+/// A JSON whole number; anything else is refused by the caller's name.
+fn whole(v: ?std.json.Value) Error!usize {
+    const x = v orelse return error.BadLoopInterval;
+    return switch (x) {
+        .integer => |i| if (i < 0) error.BadLoopInterval else std.math.cast(usize, i) orelse error.BadLoopInterval,
+        else => error.BadLoopInterval,
+    };
+}
+
+const t = std.testing;
+
+fn planOf(text: []const u8, layers: usize) !Plan {
+    const doc = try std.json.parseFromSlice(std.json.Value, t.allocator, text, .{});
+    defer doc.deinit();
+    var p: Plan = .{};
+    try read(&p, doc.value.object.get("loop_settings"), layers, true);
+    return p;
+}
+
+fn mhcOf(text: []const u8, plan: Plan) !?Mhc {
+    const doc = try std.json.parseFromSlice(std.json.Value, t.allocator, text, .{});
+    defer doc.deinit();
+    return readMhc(doc.value, plan);
+}
+
+test "the released checkpoint's loop_settings: 56 executions from 32 layers, three phases in order" {
+    const p = try planOf("{\"loop_settings\":{\"counts\":[2],\"end\":28,\"eval_count\":2,\"start\":4}}", 32);
+    try t.expectEqual(@as(usize, 56), p.len);
+    try t.expectEqual(@as(usize, 2), p.passes);
+    try t.expectEqual(@as(usize, 4), p.physical(4));
+    try t.expectEqual(@as(usize, 27), p.physical(27));
+    try t.expectEqual(@as(usize, 4), p.physical(28));
+    try t.expectEqual(@as(usize, 27), p.physical(51));
+    try t.expectEqual(@as(usize, 28), p.physical(52));
+    try t.expectEqual(@as(usize, 31), p.physical(55));
+    try t.expectEqual(@as(usize, 0), p.visit(5));
+    try t.expectEqual(@as(usize, 1), p.visit(29));
+    try t.expectEqual(@as(usize, 0), p.visit(52));
+    try t.expect(p.loops());
+}
+
+test "no loop_settings, or null: one pass over every layer, and no plan is asked of an empty model" {
+    for ([_][]const u8{ "{}", "{\"loop_settings\":null}" }) |text| {
+        const p = try planOf(text, 32);
+        try t.expectEqual(@as(usize, 32), p.len);
+        try t.expectEqual(@as(usize, 31), p.physical(31));
+        try t.expect(!p.loops());
+    }
+    var p: Plan = .{};
+    try t.expectError(error.BadLoopInterval, read(&p, null, 0, true));
+}
+
+test "a loop's interval and count are whole numbers inside the model; counts must be that one count" {
+    var p: Plan = .{};
+    const cases = [_]struct { []const u8, Error }{
+        .{ "{\"start\":4,\"end\":28,\"eval_count\":2}", error.OnlyFixedCountLoops },
+        .{ "{\"counts\":[2,2],\"start\":4,\"end\":28,\"eval_count\":2}", error.OnlyFixedCountLoops },
+        .{ "{\"counts\":[3],\"start\":4,\"end\":28,\"eval_count\":2}", error.OnlyFixedCountLoops },
+        .{ "{\"counts\":[2],\"start\":28,\"end\":4,\"eval_count\":2}", error.BadLoopInterval },
+        .{ "{\"counts\":[2],\"start\":4,\"end\":33,\"eval_count\":2}", error.BadLoopInterval },
+        .{ "{\"counts\":[0],\"start\":4,\"end\":28,\"eval_count\":0}", error.BadLoopInterval },
+        .{ "{\"counts\":[2],\"start\":4.0,\"end\":28,\"eval_count\":2}", error.BadLoopInterval },
+        .{ "{\"counts\":[2],\"start\":\"4\",\"end\":28,\"eval_count\":2}", error.BadLoopInterval },
+        .{ "{\"counts\":[2],\"end\":28,\"eval_count\":2}", error.BadLoopInterval },
+    };
+    for (cases) |c| {
+        const text = try std.fmt.allocPrint(t.allocator, "{{\"loop_settings\":{s}}}", .{c[0]});
+        defer t.allocator.free(text);
+        const doc = try std.json.parseFromSlice(std.json.Value, t.allocator, text, .{});
+        defer doc.deinit();
+        try t.expectError(c[1], read(&p, doc.value.object.get("loop_settings"), 32, true));
+    }
+    try t.expectError(error.MissingLoopSettings, read(&p, .{ .integer = 2 }, 32, true));
+    try t.expectError(error.NoFullAttention, read(&p, null, 32, false));
+}
+
+test "mHC: two streams, 20 iterations, inside one Loop phase; a range crossing a phase boundary is refused" {
+    const p = try planOf("{\"loop_settings\":{\"counts\":[2],\"end\":28,\"eval_count\":2,\"start\":4}}", 32);
+    const ok = (try mhcOf("{\"start\":4,\"end\":28,\"streams\":2,\"iterations\":20,\"fixed_identity\":false,\"pre_scale\":1.0}", p)).?;
+    try t.expectEqual(@as(usize, 4), ok.start);
+    try t.expectEqual(@as(usize, 28), ok.end);
+    try t.expectEqual(@as(u8, 2), ok.streams);
+    try t.expectEqual(@as(u8, 20), ok.iterations);
+    try t.expect(ok.holds(27) and !ok.holds(28) and !ok.holds(3));
+    try t.expectEqual(@as(?Mhc, null), try readMhc(null, p));
+
+    const bad = [_]struct { []const u8, Error }{
+        .{ "{\"start\":2,\"end\":6,\"streams\":2,\"iterations\":20,\"fixed_identity\":false}", error.MhcCrossesPhaseBoundary },
+        .{ "{\"start\":4,\"end\":30,\"streams\":2,\"iterations\":20,\"fixed_identity\":false}", error.MhcCrossesPhaseBoundary },
+        .{ "{\"start\":4,\"end\":28,\"streams\":3,\"iterations\":20,\"fixed_identity\":false}", error.BadMhcStreams },
+        .{ "{\"start\":4,\"end\":28,\"streams\":2,\"iterations\":0,\"fixed_identity\":false}", error.BadMhcIterations },
+        .{ "{\"start\":4,\"end\":28,\"streams\":2,\"iterations\":20,\"fixed_identity\":1}", error.BadMhcFlag },
+        .{ "{\"start\":4,\"end\":28,\"streams\":2,\"iterations\":20,\"fixed_identity\":false,\"pre_scale\":0}", error.BadMhcScale },
+        .{ "{\"start\":4,\"end\":28,\"streams\":2,\"iterations\":20,\"fixed_identity\":false,\"pre_scale\":\"1\"}", error.BadMhcScale },
+        .{ "{\"start\":4,\"end\":28,\"streams\":2,\"iterations\":20,\"fixed_identity\":false,\"depth\":2}", error.UnknownMhcField },
+        .{ "{\"start\":4,\"end\":28,\"streams\":2,\"iterations\":20}", error.BadMhcFlag },
+        .{ "{\"start\":28,\"end\":4,\"streams\":2,\"iterations\":20,\"fixed_identity\":false}", error.BadMhcRange },
+    };
+    for (bad) |b| try t.expectError(b[1], mhcOf(b[0], p));
+}
+
+test "mixer slots number each kind on its own: the state pool's layer index, per execution" {
+    var p = try planOf("{\"loop_settings\":{\"counts\":[2],\"end\":28,\"eval_count\":2,\"start\":4}}", 32);
+    var full: [32]bool = undefined;
+    for (&full, 0..) |*f, i| f.* = (i + 1) % 4 == 0;
+    p.count(&full);
+    try t.expectEqual(@as(usize, 42), p.linear);
+    try t.expectEqual(@as(usize, 14), p.attention);
+    try t.expectEqual(@as(usize, 0), p.slot(0));
+    try t.expectEqual(@as(usize, 0), p.slot(3));
+    try t.expectEqual(@as(usize, 3), p.slot(4));
+    try t.expectEqual(@as(usize, 6), p.slot(27));
+    try t.expectEqual(@as(usize, 21), p.slot(28));
+    try t.expectEqual(@as(usize, 12), p.slot(51));
+    try t.expectEqual(@as(usize, 39), p.slot(52));
+    try t.expectEqual(@as(usize, 13), p.slot(55));
+}
diff --git a/zig/src/core/rope_yarn.zig b/zig/src/core/rope_yarn.zig
index c3a6c32db..6e66f7ec5 100644
--- a/zig/src/core/rope_yarn.zig
+++ b/zig/src/core/rope_yarn.zig
@@ -37,3 +37,31 @@ test "Qwen3.6's YaRN table (theta 1e7, factor 4 over 262,144) equals transformer
     for (y.freq, torch) |got, want| try std.testing.expectEqual(want, @as(u32, @bitCast(got)));
     try std.testing.expectEqual(@as(f32, @floatCast(1.138629436111989)), y.scale);
 }
+
+/// The GPU argument: `on` 0 keeps theta powers, 1 reads `freq`; cos and sin carry `scale`.
+pub const Params = extern struct {
+    on: u32 = 0,
+    scale: f32 = 1,
+    freq: [32]f32 = @splat(0),
+
+    /// A YaRN table at `factor` over `trained` positions, `get_mscale`'s attention factor for a factor above one.
+    pub fn of(theta: f64, factor: f64, trained: usize) Params {
+        const y = yarn(theta, factor, trained);
+        return .{ .on = 1, .scale = if (factor > 1) y.scale else 1, .freq = y.freq };
+    }
+};
+
+test "SenseNova-Loop-9B's YaRN table (theta 1e7, factor 2 over 262,144) equals transformers 5.18.0's, word for word" {
+    // transformers 5.18.0's _compute_yarn_parameters under torch 2.15.0, fp32 words and its 1.0693147180559945 factor
+    const torch = [32]u32{
+        0x3f800000, 0x3f1ab32b, 0x3ebaf81b, 0x3e61f835, 0x3e088d77, 0x3da50956, 0x3d47763f, 0x3cf11177,
+        0x3c91ad39, 0x3c301052, 0x3bd4ca15, 0x3b80967d, 0x3b1b690d, 0x3abbd3ed, 0x3a6301e2, 0x3a009b22,
+        0x399111f4, 0x3922ce9d, 0x38b5a1aa, 0x384939ae, 0x37dd1727, 0x37707cc9, 0x37012dab, 0x369c1fc4,
+        0x363cb0c1, 0x35e40cc6, 0x3589cf4a, 0x35268e4c, 0x34c94c57, 0x3473499d, 0x3413048e, 0x33b1af44,
+    };
+    const p = Params.of(10000000, 2, 262144);
+    for (p.freq, torch) |got, want| try std.testing.expectEqual(want, @as(u32, @bitCast(got)));
+    try std.testing.expectEqual(@as(u32, 0x3f88df4e), @as(u32, @bitCast(p.scale)));
+    try std.testing.expectEqual(@as(u32, 1), p.on);
+    try std.testing.expectEqual(@as(usize, 136), @sizeOf(Params));
+}
