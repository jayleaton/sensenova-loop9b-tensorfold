-    /// Records `hidden` into the narrow tape, at the same plane index the streams tape uses.
-    pub fn recordHalfW(t: *Taps, glue: Glue, e: mtl.ComputeEncoder, layer: usize, hidden: Ref, rows: u32, width: u32) !void {
-        const buf = t.half orelse return;
