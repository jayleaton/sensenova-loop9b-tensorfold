 zig/src/families/qwen27/decode_round.zig |  5 +-
 zig/src/families/qwen27/forward.zig      |  5 +-
 zig/src/families/qwen27/taps.zig         | 70 +++++++++++++++---------
 zig/tests/qwen27/run.zig                 | 11 +++-
 4 files changed, 60 insertions(+), 31 deletions(-)

