+    /// Declares that the run will record these seams, so completion can insist on each of them.
+    pub fn wantSeams(t: *Taps, ids: []const usize) !void {
+        t.half_want = 0;
+        for (ids) |id| {
+            if (id < seam_base) continue;
+            const index = try halfPlane(id);
+            t.half_want |= @as(u16, 1) << @intCast(index);
+        }
+    }
+
     /// The narrower tape, for a plane that is one layer wide inside a streams-wide window.
     pub fn useHalf(t: *Taps, device: mtl.Device, width: u32) !void {
         if (width == 0 or width == t.width) return;
