+    /// The narrow tape's plane for a seam id: one plane a seam, numbered from `seam_base`, never `count` of them.
+    pub fn halfPlane(seam: usize) !usize {
+        if (seam < seam_base) return error.NotASeam;
+        const index = seam - seam_base;
+        if (index >= max_seams) return error.SeamOutOfRange;
+        return index;
+    }
+
+    /// Records a seam's plane at its own slot; an unknown or out-of-range seam is refused, never skipped.
+    pub fn recordHalfW(t: *Taps, glue: Glue, e: mtl.ComputeEncoder, seam: usize, hidden: Ref, rows: u32, width: u32) !void {
+        const buf = t.half orelse return error.NoNarrowTape;
+        if (width == 0 or width > t.half_width) return error.BadSeamWidth;
+        const index = try halfPlane(seam);
+        if (rows == 0 or rows > t.capacity) return error.BadTapShape;
+        if (t.half_rows != 0 and rows != t.half_rows) return error.BadTapShape;
         const bit = @as(u16, 1) << @intCast(index);
-        if (t.half_seen & bit != 0) return;
+        if (t.half_seen & bit != 0) return; // a loop revisits a seam: the first visit is the one compared
         try glue.unstack(e, hidden, .{ .buffer = buf, .offset = index * @as(usize, t.capacity) * t.half_width * 2 }, .{ .rows = rows, .width = width, .stride = width, .offset = 0 });
         e.barrier();
         t.half_seen |= bit;
         t.half_rows = rows;
     }
 
+    /// A layer's plane on the narrow tape, for a model whose state is one layer wide.
     pub fn recordHalf(t: *Taps, glue: Glue, e: mtl.ComputeEncoder, layer: usize, hidden: Ref, rows: u32) !void {
-        const buf = t.half orelse return;
-        if (rows == 0 or rows > t.capacity) return error.BadTapShape;
-        const index = if (layer >= seam_base) layer - seam_base else std.mem.indexOfScalar(usize, t.ids[0..t.count], layer) orelse return;
-        if (index >= t.count) return;
-        if (t.half_seen != 0 and rows != t.half_rows) return error.BadTapShape;
-        const bit = @as(u16, 1) << @intCast(index);
-        // a loop visits a physical layer twice: the narrow tape keeps the first visit, as a seam to compare
-        if (t.half_seen & bit != 0) return;
-        try glue.unstack(e, hidden, .{ .buffer = buf, .offset = index * @as(usize, t.capacity) * t.half_width * 2 }, .{ .rows = rows, .width = t.half_width, .stride = t.half_width, .offset = 0 });
-        e.barrier();
-        t.half_seen |= bit;
-        t.half_rows = rows;
+        if (layer >= seam_base) return t.recordHalfW(glue, e, layer, hidden, rows, t.half_width);
+        const index = std.mem.indexOfScalar(usize, t.ids[0..t.count], layer) orelse return;
+        return t.recordHalfW(glue, e, seam_base + index, hidden, rows, t.half_width);
     }
 
-    /// A seam id at or past this is one layer wide; a layer id is the carried state, streams wide in a window.
-    pub const seam_base = 1000;
 
     /// One hook, two tapes: a layer's carried state goes to the streams tape, a seam's plane to the narrow one.
     pub fn recordOne(t: *Taps, glue: Glue, e: mtl.ComputeEncoder, layer: usize, hidden: Ref, rows: u32) !void {
-        if (t.half != null and (layer >= seam_base or t.width == t.half_width)) return t.recordHalf(glue, e, layer, hidden, rows);
+        if (t.half != null and (layer >= seam_base or t.width == t.half_width)) {
+            // a seam over the streams tape's plane is sliced to one layer's width by its own record
+            return t.recordHalfW(glue, e, layer, hidden, rows, if (layer >= seam_base) t.half_width else t.half_width);
+        }
         return t.record(glue, e, layer, hidden, rows);
     }
 
@@ -130,8 +146,10 @@ pub const Taps = struct {
         if (t.seen != all and !(t.seen == 0 and t.half_seen != 0)) return error.IncompleteTaps;
     }
 
-    /// The narrow tape is optional, so it completes on its own: every requested plane, or none at all.
-    pub fn completeHalf(_: Taps) !void {}
+    /// Every seam the run asked for must have a plane: a silent no-op is a failed measurement, not a skip.
+    pub fn completeHalf(t: Taps) !void {
+        if (t.half_want != 0 and t.half_seen & t.half_want != t.half_want) return error.IncompleteSeams;
+    }
 
     pub fn accepted(t: Taps, glue: Glue, e: mtl.ComputeEncoder, path: []const u32, kept: Ref, out: Ref) !void {
         try t.complete();
