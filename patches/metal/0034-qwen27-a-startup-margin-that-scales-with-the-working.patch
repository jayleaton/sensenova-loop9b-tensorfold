From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Wed, 18 Nov 2026 10:43:21 +0800
Subject: [PATCH 34/44] qwen27: a startup margin that scales with the working
 set, a looped model's every execution charged

The fixed 8 GiB margin refused every 16 GB and 8 GB Mac whatever the weights. The margin is now an eighth of
Metal's working set, 1 GiB at least and 8 GiB from a 64 GiB set, so the largest Macs keep theirs; a served request
measured 0.53 GiB of footprint beyond the device's own count. The fit counts KV and recurrent state per execution,
and a frame that cannot fit 512 rows steps down to 128 before it refuses.
---
 zig/src/families/qwen27/prompt_memory.zig | 23 ++++---
 zig/src/native/qwen27_served.zig          |  6 +-
 zig/src/qwen27_memory_test.zig            | 81 +++++++++++++++++------
 3 files changed, 78 insertions(+), 32 deletions(-)

diff --git a/zig/src/families/qwen27/prompt_memory.zig b/zig/src/families/qwen27/prompt_memory.zig
index 2de2cbb07..16adbf08a 100644
--- a/zig/src/families/qwen27/prompt_memory.zig
+++ b/zig/src/families/qwen27/prompt_memory.zig
@@ -5,7 +5,11 @@ const frame = @import("gpu_frame.zig");
 const planning = @import("attention_plan.zig");
 const Budget = @import("gdn_pool.zig").Budget;
 
-const margin: usize = 8 << 30;
+pub fn margin(set: usize) usize {
+    return std.math.clamp(set / 8, 1 << 30, 8 << 30);
+}
+
+pub const least_rows: u32 = 128;
 /// RAM a suggested wired limit leaves outside the GPU for macOS and other processes.
 const floor: usize = 4 << 30;
 
@@ -22,8 +26,8 @@ pub fn frameBytes(c: Config, rows: u32) usize {
 /// Frame bytes already belong to the model; these are the runner's future bytes at its peak (`planes`: its tap planes).
 pub fn runnerBytes(c: Config, context: u32, slots: u32, rows: u32, shared: bool, ring: usize, planes: usize) !usize {
     var attention: usize = 0;
-    for (0..c.layers) |i| attention += @intFromBool(c.kind(i) == .attention);
-    const linear = c.layers - attention;
+    for (0..c.steps()) |e| attention += @intFromBool(c.kind(c.physical(e)) == .attention);
+    const linear = c.steps() - attention;
     const g = try planning.Geometry.fromConfig(c, shared);
     const limits = .{ .rows = rows, .streams = slots, .keys = context, .shared_prefix = shared, .geometry = g };
     const scratch = @import("attention_memory.zig").Layout.init(limits);
@@ -51,8 +55,10 @@ pub const Fit = struct {
     }
 
     pub fn choose(f: Fit, requested: u32, explicit: bool) !u32 {
-        if (explicit or requested <= 512) return requested;
-        return if (try f.cost(requested, f.slots) <= f.left) requested else 512;
+        if (explicit) return requested;
+        var rows = if (requested <= 512 or try f.cost(requested, f.slots) <= f.left) requested else 512;
+        while (rows > least_rows and try f.cost(rows, f.slots) > f.left) rows /= 2;
+        return @max(rows, @min(requested, least_rows));
     }
 
     pub fn streams(f: Fit, rows: u32, fixed: bool) !u32 {
@@ -75,12 +81,13 @@ pub fn workingSet(real: usize, text: ?[]const u8) !usize {
 
 /// The same margin guards startup, cache growth and the first use of a later slot.
 pub fn room(real: usize, used: usize, cap: ?[]const u8) !usize {
-    return (try workingSet(real, cap)) -| used -| margin;
+    const set = try workingSet(real, cap);
+    return set -| used -| margin(set);
 }
 
 /// The iogpu.wired_limit_mb that fits `need` beside `used` and the margin while leaving the floor; null if RAM cannot.
 pub fn wiredRaise(used: usize, need: usize, ram: usize) ?usize {
-    const total = used +| need +| margin;
+    const total = used +| need +| margin(ram -| floor);
     const mb = std.math.divCeil(usize, total, 1 << 20) catch unreachable;
     return if (mb *| (1 << 20) <= ram -| floor) mb else null;
 }
@@ -103,7 +110,7 @@ pub const Advice = union(enum) {
 /// What a refusal should advise for one stream, from the set and margin the startup room counted.
 pub fn advice(real: usize, used: usize, cap: ?[]const u8, one: usize, ram: ?usize) Advice {
     const set = workingSet(real, cap) catch return .lower;
-    if (set != real or one <= set -| used -| margin) return .lower;
+    if (set != real or one <= set -| used -| margin(set)) return .lower;
     if (ram) |r| if (wiredRaise(used, one, r)) |mb| return .{ .raise = .{ .set = set, .mb = mb } };
     return .{ .no_raise = ram };
 }
