+//! A looped checkpoint's two-stream mHC: the router's branch, the streams' merge and the window boundaries.
+const std = @import("std");
+const mtl = @import("metal");
+const source = @import("qwen_runtime_sources");
+const schedule = @import("loop_schedule");
+const projection = @import("projection.zig");
+const Ref = projection.Ref;
+
+/// qwen27/mhc.metal's argument struct: the widths a boundary reads and the stride between stream planes.
+pub const Params = extern struct { hidden: u32, streams: u32, outs: u32, iters: u32, plane: u32, pre_scale: f32 };
+
+pub const Kernels = struct {
+    br: mtl.Pipeline,
+    mg: mtl.Pipeline,
+    en: mtl.Pipeline,
+    lv: mtl.Pipeline,
+
+    pub fn init(device: mtl.Device) !Kernels {
+        const lib = try mtl.Library.fromSource(device, source.mhc, mtl.CompileOptions.mlx());
+        defer lib.deinit();
+        const br = try mtl.Pipeline.init(device, lib, "tf_mhc_branch", false);
+        errdefer br.deinit();
+        const mg = try mtl.Pipeline.init(device, lib, "tf_mhc_merge", false);
+        errdefer mg.deinit();
+        const en = try mtl.Pipeline.init(device, lib, "tf_mhc_enter", false);
+        errdefer en.deinit();
+        const lv = try mtl.Pipeline.init(device, lib, "tf_mhc_leave", false);
+        return .{ .br = br, .mg = mg, .en = en, .lv = lv };
+    }
+
+    pub fn deinit(k: Kernels) void {
+        inline for (.{ k.br, k.mg, k.en, k.lv }) |p| p.deinit();
+    }
+};
+
+/// The buffers a boundary needs: the streams, the coefficients, and the branch the sublayer reads.
+pub const Buffers = struct {
+    streams: Ref,
+    state: Ref,
+    branch: Ref,
+    /// One row's outputs: pre, post, then the stream-mixing logits.
+    outs: u32,
+    /// Elements between stream planes: `capacity * hidden` (the shader indexes bfloat rows).
+    plane: u32,
+
+    pub fn params(b: Buffers, s: schedule.Mhc, hidden: u32, plane: u32) Params {
+        return .{ .hidden = hidden, .streams = s.streams, .outs = b.outs, .iters = s.iterations, .plane = plane, .pre_scale = s.pre_scale };
+    }
+};
+
+/// Bytes one row of the windows' state takes: the router's outputs as f32.
+pub fn stateBytes(outs: u32, rows: u32) !usize {
+    return std.math.mul(usize, try std.math.mul(usize, outs, rows), @sizeOf(f32));
+}
+
+/// `h` into every stream: the window's first execution, folding the previous layer's pending output when set.
+pub fn enter(e: mtl.ComputeEncoder, k: Kernels, b: Buffers, p: Params, rows: u32, from: Ref, pending: ?Ref) void {
+    e.setPipeline(k.en);
+    e.setBuffer(from.buffer, from.offset, 0);
+    if (pending) |r| e.setBuffer(r.buffer, r.offset, 1) else e.setNullBuffer(1);
+    e.setBuffer(b.streams.buffer, b.streams.offset, 2);
+    e.setValue(p, 3);
+    e.dispatchThreads(mtl.Size.of(p.hidden, rows, 1), mtl.Size.of(threads(p.hidden), 1, 1));
+}
+
+/// Threads a width wants: a whole number of 32-lane groups, at most 256.
+fn threads(width: u32) u32 {
+    return @min(@max(width + 31 & ~@as(u32, 31), 32), 256);
+}
+
+/// The streams' mean into `h`: the window's last execution.
+pub fn leave(e: mtl.ComputeEncoder, k: Kernels, b: Buffers, p: Params, rows: u32, out: Ref) void {
+    e.setPipeline(k.lv);
+    e.setBuffer(b.streams.buffer, b.streams.offset, 0);
+    e.setBuffer(out.buffer, out.offset, 1);
+    e.setValue(p, 2);
+    e.dispatchThreads(mtl.Size.of(p.hidden, rows, 1), mtl.Size.of(threads(p.hidden), 1, 1));
+}
+
+/// A sublayer's branch out of the streams, with its pre/post/mix kept for `merge`.
+pub fn branch(e: mtl.ComputeEncoder, k: Kernels, b: Buffers, p: Params, rows: u32, weight: mtl.Buffer, bias: mtl.Buffer) void {
+    e.setPipeline(k.br);
+    e.setBuffer(b.streams.buffer, b.streams.offset, 0);
+    e.setBuffer(weight, 0, 1);
+    e.setBuffer(bias, 0, 2);
+    e.setBuffer(b.branch.buffer, b.branch.offset, 3);
+    e.setBuffer(b.state.buffer, b.state.offset, 4);
+    e.setValue(p, 5);
+    e.dispatchGroups(mtl.Size.of(rows, 1, 1), mtl.Size.of(32, 1, 1));
+}
+
+/// The sublayer's output back into the streams.
+pub fn merge(e: mtl.ComputeEncoder, k: Kernels, b: Buffers, p: Params, rows: u32, from: Ref) void {
+    e.setPipeline(k.mg);
+    e.setBuffer(from.buffer, from.offset, 0);
+    e.setBuffer(b.state.buffer, b.state.offset, 1);
+    e.setBuffer(b.streams.buffer, b.streams.offset, 2);
+    e.setValue(p, 3);
+    e.dispatchThreads(mtl.Size.of(p.hidden, rows, 1), mtl.Size.of(threads(p.hidden), 1, 1));
+}
+
+test "the mHC argument is 24 bytes and every field sits where the shader reads it" {
+    try std.testing.expectEqual(@as(usize, 24), @sizeOf(Params));
+    try std.testing.expectEqual(@as(usize, 16), @offsetOf(Params, "plane"));
+    try std.testing.expectEqual(@as(usize, 20), @offsetOf(Params, "pre_scale"));
+    try std.testing.expectEqual(@as(usize, 4), @offsetOf(Params, "streams"));
+}
+
+test "a width's thread count is whole 32-lane groups, never above 256" {
+    try std.testing.expectEqual(@as(u32, 32), threads(1));
+    try std.testing.expectEqual(@as(u32, 32), threads(4096 % 32));
+    try std.testing.expectEqual(@as(u32, 128), threads(128));
+    try std.testing.expectEqual(@as(u32, 256), threads(4096));
+    try std.testing.expectEqual(@as(u32, 256), threads(16384));
+}
+
+test "the windows' router state is one f32 an output a row" {
+    try std.testing.expectEqual(@as(usize, 8 * 128 * 4), try stateBytes(8, 128));
+    try std.testing.expectError(error.Overflow, stateBytes(std.math.maxInt(u32), std.math.maxInt(u32)));
+}
