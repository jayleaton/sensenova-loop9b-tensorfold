new file mode 100644
index 000000000..f068a5419
--- /dev/null
+++ b/zig/kernels/metal/qwen27/mhc.metal
@@ -0,0 +1,128 @@
+using namespace metal;
+// Hyper-connections (mHC): the router's branch, the streams' merge, and the two window boundaries.
+// The coefficients are bf16-rounded before use, as the reference casts them; Sinkhorn runs in log space.
+// Streams are stored stream-major: plane `s` is `streams + s * rows * hidden`, so an operator takes one row range.
+
+struct TfMhc { uint hidden, streams, outs, iters, plane; float pre_scale; };
+
+// A coefficient rounded to bf16 before use, as the reference casts it (`pre.to(dtype)`, `mix.to(dtype)`).
+static inline float tf_mhc_rbf(float v) {
+  return float(bfloat(v));
+}
+
+// One row's router: `outs` mixes of the flattened streams, Sinkhorn over the S x S map, then the branch
+// `pre . streams` the sublayer runs on. STATE keeps S pre, S post and S*S mix as f32 for the merge.
+[[max_total_threads_per_threadgroup(32)]] kernel void tf_mhc_branch(device const bfloat* HS [[buffer(0)]],
+                          device const float* W [[buffer(1)]],
+                          device const float* B [[buffer(2)]],
+                          device bfloat* BRANCH [[buffer(3)]],
+                          device float* STATE [[buffer(4)]],
+                          constant TfMhc& a [[buffer(5)]],
+                          uint row [[threadgroup_position_in_grid]],
+                          uint lane [[thread_index_in_simdgroup]]) {
+  const uint S = a.streams, n = a.outs, H = a.hidden, D = S * H;
+  if (S == 0u || S > 4u || n > 8u) return;
+  threadgroup float mean;
+  // the row's mean square over the flattened streams, then one simdgroup an output's dot product
+  float acc = 0.f;
+  for (uint s = 0; s < S; ++s) for (uint i = lane; i < H; i += 32u) {
+    const float x = float(HS[s * a.plane + row * H + i]);
+    acc += x * x;
+  }
+  acc = simd_sum(acc);
+  if (lane == 0) mean = rsqrt(acc / float(D) + 1e-6f);
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  const float inv = mean;
+
+  float logits[8];
+  for (uint o = 0; o < n; ++o) {
+    const device float* w = W + uint64_t(o) * D;
+    float s = 0.f;
+    for (uint t = 0; t < S; ++t) for (uint i = lane; i < H; i += 32u) {
+      s += w[t * H + i] * (float(HS[t * a.plane + row * H + i]) * inv);
+    }
+    s = simd_sum(s);
+    logits[o] = s + (B == nullptr ? 0.f : B[o]);
+  }
+  // the coefficients: pre sigmoid, post 2 sigmoid, mix Sinkhorn-normalized in log space
+  float* st = STATE + uint64_t(row) * n;
+  if (lane == 0) {
+    for (uint s = 0; s < S; ++s) {
+      st[s] = 1.f / (1.f + exp(-logits[s]));
+      st[S + s] = 2.f / (1.f + exp(-logits[S + s]));
+    }
+    float m[16];
+    for (uint i = 0; i < S * S; ++i) m[i] = logits[2 * S + i];
+    for (uint it = 0; it < a.iters; ++it) {
+      for (uint r = 0; r < S; ++r) {
+        float mx = -INFINITY;
+        for (uint c = 0; c < S; ++c) mx = fmax(mx, m[r * S + c]);
+        float sum = 0.f;
+        for (uint c = 0; c < S; ++c) sum += exp(m[r * S + c] - mx);
+        const float lz = mx + log(sum);
+        for (uint c = 0; c < S; ++c) m[r * S + c] -= lz;
+      }
+      for (uint c = 0; c < S; ++c) {
+        float mx = -INFINITY;
+        for (uint r = 0; r < S; ++r) mx = fmax(mx, m[r * S + c]);
+        float sum = 0.f;
+        for (uint r = 0; r < S; ++r) sum += exp(m[r * S + c] - mx);
+        const float lz = mx + log(sum);
+        for (uint r = 0; r < S; ++r) m[r * S + c] -= lz;
+      }
+    }
+    for (uint i = 0; i < S * S; ++i) st[2 * S + i] = exp(m[i]);
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  for (uint d = lane; d < H; d += 32u) {
+    float b = 0.f;
+    for (uint s = 0; s < S; ++s) b += tf_mhc_rbf(st[s]) * float(HS[s * a.plane + row * H + d]);
+    if (a.pre_scale != 1.f) b *= a.pre_scale;
+    BRANCH[row * H + d] = bfloat(b);
+  }
+}
+
+// streams = mix . streams + post * branch, a thread a (row, column): the outputs of a column read its inputs.
+kernel void tf_mhc_merge(device const bfloat* BRANCH [[buffer(0)]],
+                         device const float* STATE [[buffer(1)]],
+                         device bfloat* HS [[buffer(2)]],
+                         constant TfMhc& a [[buffer(3)]],
+                         uint2 at [[thread_position_in_grid]]) {
+  const uint row = at.y, d = at.x, S = a.streams, H = a.hidden;
+  if (d >= H) return;
+  const float* st = STATE + uint64_t(row) * a.outs;
+  const float b = float(BRANCH[row * H + d]);
+  float ins[4];
+  for (uint t = 0; t < S; ++t) ins[t] = float(HS[t * a.plane + row * H + d]);
+  for (uint s = 0; s < S; ++s) {
+    float v = 0.f;
+    for (uint t = 0; t < S; ++t) v += tf_mhc_rbf(st[2 * S + s * S + t]) * ins[t];
+    HS[s * a.plane + row * H + d] = bfloat(v + tf_mhc_rbf(st[S + s]) * b);
+  }
+}
+
+// h into every stream (a window's first execution); R, when present, is the previous layer's pending output.
+kernel void tf_mhc_enter(device const bfloat* H [[buffer(0)]],
+                         device const bfloat* R [[buffer(1)]],
+                         device bfloat* HS [[buffer(2)]],
+                         constant TfMhc& a [[buffer(3)]],
+                         uint2 at [[thread_position_in_grid]]) {
+  const uint d = at.x, row = at.y, Hd = a.hidden;
+  if (d >= Hd) return;
+  const uint out = row * Hd + d;
+  const float v = float(H[out]) + (R == nullptr ? 0.f : float(R[out]));
+  const bfloat o = bfloat(v);
+  for (uint s = 0; s < a.streams; ++s) HS[s * a.plane + out] = o;
+}
+
+// The streams' mean back into h: a window's last execution.
+kernel void tf_mhc_leave(device const bfloat* HS [[buffer(0)]],
+                         device bfloat* H [[buffer(1)]],
+                         constant TfMhc& a [[buffer(2)]],
+                         uint2 at [[thread_position_in_grid]]) {
+  const uint d = at.x, row = at.y, Hd = a.hidden;
+  if (d >= Hd) return;
+  float s = 0.f;
+  for (uint i = 0; i < a.streams; ++i) s += float(HS[i * a.plane + row * Hd + d]);
+  H[row * Hd + d] = bfloat(s / float(a.streams));
+}
