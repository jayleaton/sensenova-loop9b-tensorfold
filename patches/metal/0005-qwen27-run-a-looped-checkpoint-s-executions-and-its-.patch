diff --git a/zig/tests/qwen27/mhc_check.zig b/zig/tests/qwen27/mhc_check.zig
new file mode 100644
index 000000000..f3735dcad
--- /dev/null
+++ b/zig/tests/qwen27/mhc_check.zig
@@ -0,0 +1,241 @@
+//! The mHC kernels against a CPU reference of the same arithmetic: the gate a new boundary must pass.
+const std = @import("std");
+const mtl = @import("metal");
+const q = @import("qwen27");
+const mhc = q.mhc;
+
+const hidden = 256;
+const streams = 2;
+const outs = 8;
+const iterations = 20;
+const rows = 1;
+
+fn bf(x: f32) f32 {
+    const bits: u32 = @bitCast(x);
+    const rounded = if (std.math.isNan(x)) (bits >> 16) | 0x40 else (bits + 0x7fff + ((bits >> 16) & 1)) >> 16;
+    return @bitCast(@as(u32, rounded) << 16);
+}
+
+fn sigmoid(x: f32) f32 {
+    return 1.0 / (1.0 + @exp(-x));
+}
+
+/// The reference's router: rms over the flattened streams, `outs` dot products, sigmoid/two-sigmoid, Sinkhorn.
+fn reference(hs: []const f32, w: []const f32, b: []const f32, state: *[outs]f32, branch: *[hidden]f32) void {
+    var acc: f32 = 0;
+    for (hs) |x| acc += x * x;
+    const inv = 1.0 / @sqrt(acc / @as(f32, @floatFromInt(streams * hidden)) + 1e-6);
+    var logits: [outs]f32 = undefined;
+    // the kernel reads the stream's bf16 value and its fp32 product
+    for (0..outs) |o| {
+        var s: f32 = 0;
+        for (hs, 0..) |x, i| s += w[o * streams * hidden + i] * (x * inv);
+        logits[o] = s + b[o];
+    }
+    for (0..streams) |s| {
+        state[s] = sigmoid(logits[s]);
+        state[streams + s] = 2.0 * sigmoid(logits[streams + s]);
+    }
+    var m: [16]f32 = undefined;
+    for (0..streams * streams) |i| m[i] = logits[2 * streams + i];
+    for (0..iterations) |_| {
+        for (0..streams) |r| {
+            var mx: f32 = -std.math.inf(f32);
+            for (0..streams) |c| mx = @max(mx, m[r * streams + c]);
+            var sum: f32 = 0;
+            for (0..streams) |c| sum += @exp(m[r * streams + c] - mx);
+            const lz = mx + @log(sum);
+            for (0..streams) |c| m[r * streams + c] -= lz;
+        }
+        for (0..streams) |c| {
+            var mx: f32 = -std.math.inf(f32);
+            for (0..streams) |r| mx = @max(mx, m[r * streams + c]);
+            var sum: f32 = 0;
+            for (0..streams) |r| sum += @exp(m[r * streams + c] - mx);
+            const lz = mx + @log(sum);
+            for (0..streams) |r| m[r * streams + c] -= lz;
+        }
+    }
+    for (0..streams * streams) |i| state[2 * streams + i] = @exp(m[i]);
+    // the branch: the bf16-rounded pre weights times the streams
+    for (0..hidden) |d| {
+        var v: f32 = 0;
+        for (0..streams) |s| v += bf(state[s]) * hs[s * hidden + d];
+        branch[d] = bf(v);
+    }
+}
+
+fn referenceMerge(branch: []const f32, state: []const f32, hs: []f32) void {
+    var ins: [4]f32 = undefined;
+    for (0..streams) |t| for (0..hidden) |d| {
+        _ = d;
+        _ = t;
+    };
+    for (0..hidden) |d| {
+        for (0..streams) |t| ins[t] = hs[t * hidden + d];
+        for (0..streams) |s| {
+            var v: f32 = 0;
+            for (0..streams) |t| v += bf(state[2 * streams + s * streams + t]) * ins[t];
+            hs[s * hidden + d] = bf(v + bf(state[streams + s]) * branch[d]);
+        }
+    }
+}
+
+fn fill(x: []f32, seed: u64) void {
+    var s = seed;
+    for (x) |*v| {
+        s = s *% 6364136223846793005 +% 1442695040888963407;
+        const u: f32 = @floatFromInt((s >> 40) & 0xffff);
+        v.* = (u / 65535.0 - 0.5) * 0.5;
+    }
+}
+
+fn toBf(dst: []u16, src: []const f32) void {
+    for (dst, src) |*d, v| {
+        const bits: u32 = @bitCast(v);
+        d.* = @intCast((bits + 0x7fff + ((bits >> 16) & 1)) >> 16);
+    }
+}
+
+fn ofBf(src: []const u16) f32 {
+    return @bitCast(@as(u32, src[0]) << 16);
+}
+
+pub fn main(init: std.process.Init) !void {
+    const a = init.arena.allocator();
+    const args = try init.minimal.args.toSlice(a);
+    var device = try mtl.Device.init();
+    defer device.deinit();
+    const k = try mhc.Kernels.init(device);
+    defer k.deinit();
+
+    // one row in the fixture: a plane is one hidden row of elements
+    const plane: u32 = hidden;
+    var hs: [streams * hidden]f32 = undefined;
+    fill(&hs, 7);
+    var w: [outs * streams * hidden]f32 = undefined;
+    var b: [outs]f32 = undefined;
+    fill(&w, 11);
+    // a second argument zeroes the weights: the logits are the bias alone, isolating the reduction
+    if (args.len > 1) @memset(&w, 0);
+    fill(&b, 13);
+
+    var hs16: [streams * hidden]u16 = undefined;
+    toBf(&hs16, &hs);
+
+    // a plane is `hidden` bfloat elements: the buffer is bytes, the shader's stride is elements
+    const streams_buf = try device.buffer(@as(usize, streams) * plane * @sizeOf(u16), mtl.ResourceOptions.shared | mtl.ResourceOptions.untracked);
+    defer streams_buf.deinit();
+    const state_buf = try device.buffer(rows * outs * 4, mtl.ResourceOptions.shared | mtl.ResourceOptions.untracked);
+    defer state_buf.deinit();
+    const branch_buf = try device.buffer(rows * hidden * 2, mtl.ResourceOptions.shared | mtl.ResourceOptions.untracked);
+    defer branch_buf.deinit();
+    const w_buf = try device.buffer(w.len * 4, mtl.ResourceOptions.shared | mtl.ResourceOptions.untracked);
+    defer w_buf.deinit();
+    const b_buf = try device.buffer(outs * 4, mtl.ResourceOptions.shared | mtl.ResourceOptions.untracked);
+    defer b_buf.deinit();
+
+    @memcpy(w_buf.slice(f32, w.len), &w);
+    @memcpy(b_buf.slice(f32, outs), &b);
+    // rows: each `rows` slice of the streams is a row; this fixture uses one row for the router and one for the merge
+    const hs_slice = streams_buf.slice(u16, streams * hidden);
+    @memcpy(hs_slice, &hs16);
+    @memset(state_buf.contents()[0 .. rows * outs * 4], 0);
+
+    const q2 = try device.queue();
+    defer q2.deinit();
+    const cb = q2.commandBuffer();
+    const e = cb.compute(.serial);
+    const params = mhc.Params{ .hidden = hidden, .streams = streams, .outs = outs, .iters = iterations, .plane = plane, .pre_scale = 1.0 };
+    const bufs = mhc.Buffers{ .streams = .{ .buffer = streams_buf }, .state = .{ .buffer = state_buf }, .branch = .{ .buffer = branch_buf }, .outs = outs, .plane = plane };
+    mhc.branch(e, k, bufs, params, 1, w_buf, b_buf);
+    e.end();
+    cb.commit();
+    cb.wait();
+    if (cb.failure()) |f| {
+        std.debug.print("branch failed: {s}\n", .{f});
+        return error.GpuFailed;
+    }
+
+    var want_state: [outs]f32 = undefined;
+    var want_branch: [hidden]f32 = undefined;
+    var flat: [streams * hidden]f32 = undefined;
+    for (0..streams) |s| {
+        for (0..hidden) |d| flat[s * hidden + d] = ofBf(hs16[s * hidden + d ..]);
+    }
+    reference(&flat, &w, &b, &want_state, &want_branch);
+
+    const got_state = state_buf.slice(f32, outs);
+    var worst_state: f32 = 0;
+    var worst_branch: f32 = 0;
+    for (0..outs) |i| {
+        worst_state = @max(worst_state, @abs(got_state[i] - want_state[i]));
+    }
+    const got_branch = branch_buf.slice(u16, hidden);
+    for (0..hidden) |i| {
+        worst_branch = @max(worst_branch, @abs(ofBf(got_branch[i..]) - want_branch[i]));
+    }
+    std.debug.print("mhc branch: state max|d| {e:.3}, branch max|d| {e:.3}\n", .{ worst_state, worst_branch });
+    for (0..outs) |i| std.debug.print("  state[{d}] got {d:.6} want {d:.6}\n", .{ i, got_state[i], want_state[i] });
+    std.debug.print("  branch[0..4] bits {d} {d} {d} {d}\n", .{ got_branch[0], got_branch[1], got_branch[2], got_branch[3] });
+    std.debug.print("  branch[0] got {d:.6} want {d:.6}\n", .{ ofBf(got_branch[0..]), want_branch[0] });
+    // the state is a sigmoid of a dot product and the branch a bf16 sum: a permuted fp32 reduction
+    // of 512 terms moves these, and the released router is fp32 with coefficients far from 0 or 1
+    if (worst_state > 2e-3 or worst_branch > 1e-2) return error.MhcBranchMismatch;
+
+    // the merge, from the router's own coefficients
+    const c2 = q2.commandBuffer();
+    const e2 = c2.compute(.serial);
+    mhc.merge(e2, k, bufs, params, 1, .{ .buffer = branch_buf });
+    e2.end();
+    c2.commit();
+    c2.wait();
+    if (c2.failure()) |f| {
+        std.debug.print("merge failed: {s}\n", .{f});
+        return error.GpuFailed;
+    }
+    var want_hs = flat;
+    referenceMerge(&want_branch, &want_state, &want_hs);
+    const got = streams_buf.slice(u16, streams * hidden);
+    var worst: f32 = 0;
+    for (0..streams) |s| {
+        for (0..hidden) |d| worst = @max(worst, @abs(ofBf(got[s * hidden + d ..]) - want_hs[s * hidden + d]));
+    }
+    std.debug.print("mhc merge: max|d| {e:.3}\n", .{worst});
+    if (worst > 1e-3) return error.MhcMergeMismatch;
+    // the boundaries: h into every stream, then the streams' mean back into h
+    const h_buf = try device.buffer(@as(usize, hidden) * @sizeOf(u16), mtl.ResourceOptions.shared | mtl.ResourceOptions.untracked);
+    defer h_buf.deinit();
+    var h16: [hidden]u16 = undefined;
+    toBf(&h16, flat[0..hidden]);
+    @memcpy(h_buf.slice(u16, hidden), &h16);
+    // the fixture's h is bf16, so enter's output is that same bf16 value: compare in bf16
+    var rounded: [hidden]f32 = undefined;
+    for (0..hidden) |d| rounded[d] = ofBf(h16[d..]);
+    const c3 = q2.commandBuffer();
+    const e3 = c3.compute(.serial);
+    mhc.enter(e3, k, bufs, params, 1, .{ .buffer = h_buf }, null);
+    e3.end();
+    c3.commit();
+    c3.wait();
+    const entered = streams_buf.slice(u16, streams * hidden);
+    var worst_enter: f32 = 0;
+    for (0..streams) |s| {
+        for (0..hidden) |d| worst_enter = @max(worst_enter, @abs(ofBf(entered[s * hidden + d ..]) - rounded[d]));
+    }
+    const c4 = q2.commandBuffer();
+    const e4 = c4.compute(.serial);
+    mhc.leave(e4, k, bufs, params, 1, .{ .buffer = h_buf });
+    e4.end();
+    c4.commit();
+    c4.wait();
+    var want_mean: f32 = 0;
+    for (0..hidden) |d| {
+        var sum: f32 = 0;
+        for (0..streams) |s| sum += ofBf(entered[s * hidden + d ..]);
+        want_mean = @max(want_mean, @abs(ofBf(h_buf.slice(u16, hidden)[d..]) - bf(sum / @as(f32, streams))));
+    }
+    std.debug.print("mhc enter: max|d| {e:.3}, leave: max|d| {e:.3}\n", .{ worst_enter, want_mean });
+    if (worst_enter != 0 or want_mean != 0) return error.MhcBoundaryMismatch;
+    std.debug.print("PASS mhc: branch, merge, enter and leave match the CPU reference\n", .{});
+}
