+def pack(code, bits, rows, k):
+    """MLX's little-endian bitstream: code j sits at bit j*bits, so 3, 5 and 6-bit codes cross word edges."""
+    blocks = code.reshape(rows, k // 32, 32).astype(np.uint64)
+    words = np.zeros((rows, k // 32, bits), dtype=np.uint64)
+    for j in range(32):
+        word, shift = divmod(j * bits, 32)
+        words[:, :, word] |= (blocks[:, :, j] << np.uint64(shift)) & np.uint64(0xFFFFFFFF)
+        if shift + bits > 32:
+            words[:, :, word + 1] |= blocks[:, :, j] >> np.uint64(32 - shift)
+    return words.reshape(rows, k * bits // 32).astype(np.uint32)
+
+
+def unpack(words, bits, k):
+    rows = words.shape[0]
+    blocks = words.reshape(rows, k // 32, bits).astype(np.uint64)
+    codes = np.zeros((rows, k // 32, 32), dtype=np.uint64)
+    mask = np.uint64(2**bits - 1)
+    for j in range(32):
+        word, shift = divmod(j * bits, 32)
+        v = blocks[:, :, word] >> np.uint64(shift)
+        if shift + bits > 32:
+            v |= blocks[:, :, word + 1] << np.uint64(32 - shift)
+        codes[:, :, j] = v & mask
+    return codes.reshape(rows, k).astype(np.uint32)
 
 
