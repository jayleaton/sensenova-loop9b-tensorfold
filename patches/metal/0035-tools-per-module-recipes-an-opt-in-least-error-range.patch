+def test_every_width_packs_as_an_mlx_bitstream_and_unpacks_to_the_same_codes():
+    from sensenova_loop_mlx import pack, unpack
+    rng = np.random.default_rng(0)
+    for bits in (2, 3, 4, 5, 6, 8):
+        codes = rng.integers(0, 2**bits, (3, 128)).astype(np.uint32)
+        words = pack(codes, bits, 3, 128)
+        assert words.shape == (3, 128 * bits // 32)
+        assert np.array_equal(unpack(words, bits, 128), codes), bits
+        stream = int.from_bytes(words[0].astype("<u4").tobytes(), "little")
+        assert all((stream >> (j * bits)) & (2**bits - 1) == codes[0, j] for j in range(128)), bits
