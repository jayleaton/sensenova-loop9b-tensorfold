+def group_codes(g, lo, hi, bits):
+    """One candidate range per group: signed scale, bias and codes, in bf16 as the engine reads them."""
+    step = np.maximum((hi - lo) / (2**bits - 1), 1e-7)
+    low_edge = np.abs(lo) > np.abs(hi)
+    signed = np.where(low_edge, step, -step)
+    edge = np.where(low_edge, lo, hi)
+    q0 = round_away(edge / signed)
+    s = np.where(q0 == 0, signed, edge / np.where(q0 == 0, 1.0, q0))
