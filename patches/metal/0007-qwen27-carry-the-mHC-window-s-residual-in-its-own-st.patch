+// A row's streams are interleaved, `row * streams * hidden + stream * hidden + column`, as the reference flattens them.
 
-struct TfMhc { uint hidden, streams, outs, iters, plane; float pre_scale; };
+struct TfMhc { uint hidden, streams, outs, iters; float pre_scale; };
 
 // A coefficient rounded to bf16 before use, as the reference casts it.
 static inline float tf_mhc_rbf(float v) {
@@ -23,7 +24,7 @@ static inline float tf_mhc_rbf(float v) {
