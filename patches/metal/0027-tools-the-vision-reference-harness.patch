Subject: [PATCH 27/44] tools: the vision reference harness

Captures what a vision port must match: the tower's own output, the pixels the
processor made, the image grid, and 64 greedy tokens, over a chart, a photo and
an OCR prompt, on the checkpoint's own processor so the pixels are the model
card's.
---
 tools/vision_golden.py | 125 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 125 insertions(+)
 create mode 100644 tools/vision_golden.py

diff --git a/tools/vision_golden.py b/tools/vision_golden.py
new file mode 100644
index 000000000..9f85af28a
--- /dev/null
+++ b/tools/vision_golden.py
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""SenseNova-Loop-9B vision reference: the tower's output, the merged rows and 64 greedy tokens.
+
+Images go through the checkpoint's own processor, so the pixels the tower sees are the model card's. The tower's
+output is captured separately from the merged embeddings: the first proves the tower, the second proves the
+scatter into the language model's rows.
+"""
+import argparse
+import hashlib
+import json
+import os
+
+import numpy as np
+import torch
+
+REV = "329a65f701ba8c48b73c30d0cbaa6f0449733673"
+
+PROMPTS = [
+    ("v0-chart", "chart.png", "What does this chart compare? Name two of the models shown.", 64),
+    ("v1-photo", "photo.png", "Describe this scene in one sentence.", 64),
+    ("v2-ocr", "chart.png", "Read out the title or any labels you can see in this image.", 64),
+]
+
+
+def sha(a):
+    return hashlib.sha256(np.ascontiguousarray(a).tobytes()).hexdigest()
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--model", required=True, help="the gated checkpoint at the pinned revision")
+    ap.add_argument("--images", default="work/img", help="a directory holding chart.png and photo.png")
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--device", default="mps")
+    ap.add_argument("--max-new", type=int, default=64)
+    ap.add_argument("--skip-hidden", action="store_true")
+    args = ap.parse_args()
+
+    from transformers import AutoModelForCausalLM, AutoProcessor
+
+    proc = AutoProcessor.from_pretrained(args.model, trust_remote_code=True, revision=REV)
+    model = AutoModelForCausalLM.from_pretrained(
+        args.model, trust_remote_code=True, revision=REV, dtype=torch.bfloat16,
+        attn_implementation="sdpa", low_cpu_mem_usage=True,
+    ).eval().to(args.device)
+
+    tower_out = {}
+    tower = model.model.visual
+
+    def grab(_m, _i, out):
+        tower_out["last"] = out.detach().float().cpu().numpy() if not isinstance(out, tuple) else out[0].detach().float().cpu().numpy()
+
+    handle = tower.register_forward_hook(grab)
+
+    os.makedirs(args.out, exist_ok=True)
+    manifest = {
+        "revision": REV,
+        "device": args.device,
+        "vision_config": model.config.vision_config.to_dict(),
+        "prompts": [],
+    }
+
+    from PIL import Image
+
+    for name, path, text, count in PROMPTS:
+        image = Image.open(os.path.join(args.images, path)).convert("RGB")
+        messages = [{"role": "user", "content": [{"type": "image"}, {"type": "text", "text": text}]}]
+        chat = proc.apply_chat_template(messages, add_generation_prompt=True)
+        inputs = proc(text=chat, images=[image], return_tensors="pt").to(args.device)
+
+        with torch.no_grad():
+            out = model(**inputs, use_cache=True, output_hidden_states=True)
+            ids = inputs["input_ids"]
+            n_prompt = ids.shape[1]
+            logits = out.logits[0, -1].float().cpu().numpy()
+            first = int(np.argmax(logits))
+            toks = [first]
+            step_logits = [logits]
+            grid = inputs.get("image_grid_thw")
+            cache = out.past_key_values
+            nxt = torch.tensor([[first]], device=args.device)
+            for _ in range(count - 1):
+                o = model(input_ids=nxt, past_key_values=cache, use_cache=True)
+                cache = o.past_key_values
+                lg = o.logits[0, -1].float().cpu().numpy()
+                step_logits.append(lg)
+                t = int(np.argmax(lg))
+                toks.append(t)
+                nxt = torch.tensor([[t]], device=args.device)
+
+        arrays = {
+            "input_ids": ids[0].cpu().numpy().astype(np.int64),
+            "greedy": np.asarray(toks, dtype=np.int64),
+            "step_logits": np.stack(step_logits).astype(np.float32),
+            "tower": tower_out["last"].astype(np.float32),
+        }
+        if grid is not None:
+            arrays["image_grid_thw"] = grid.cpu().numpy().astype(np.int64)
+        for k in ("pixel_values",):
+            if k in inputs:
+                arrays[k] = inputs[k].float().cpu().numpy()
+        np.savez_compressed(os.path.join(args.out, f"{name}.npz"), **arrays)
+
+        tok = proc.tokenizer
+        manifest["prompts"].append({
+            "name": name,
+            "image": path,
+            "text": text,
+            "n_prompt": int(n_prompt),
+            "input_ids_sha256": sha(ids[0].cpu().numpy()),
+            "image_grid_thw": grid.cpu().numpy().tolist() if grid is not None else None,
+            "tower_shape": list(tower_out["last"].shape),
+            "tower_sha256": sha(tower_out["last"]),
+            "greedy": toks,
+            "greedy_sha256": sha(np.asarray(toks)),
+            "greedy_text": tok.decode(toks, skip_special_tokens=False),
+        })
+        print(f"[{name}] tower {tower_out['last'].shape} -> {manifest['prompts'][-1]['greedy_text'][:70]!r}", flush=True)
+
+    handle.remove()
+    json.dump(manifest, open(os.path.join(args.out, "manifest.json"), "w"), indent=2)
+
+
+if __name__ == "__main__":
+    main()
