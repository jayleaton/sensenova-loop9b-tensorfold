+    copy: mtl.Pipeline,
 
-    const names = .{ .{ "embed", "qwv_embed" }, .{ "norm", "qwv_layer_norm" }, .{ "qkv", "qwv_qkv" }, .{ "softmax", "qwv_softmax" }, .{ "heads", "qwv_heads" }, .{ "gelu", "qwv_bias_gelu" }, .{ "residual", "qwv_residual" }, .{ "bias", "qwv_bias" } };
+    const names = .{ .{ "embed", "qwv_embed" }, .{ "norm", "qwv_layer_norm" }, .{ "qkv", "qwv_qkv" }, .{ "softmax", "qwv_softmax" }, .{ "heads", "qwv_heads" }, .{ "gelu", "qwv_bias_gelu" }, .{ "residual", "qwv_residual" }, .{ "bias", "qwv_bias" }, .{ "copy", "qwv_copy_bf16" } };
 
     fn load(gpa: std.mem.Allocator, device: mtl.Device) !Kernels {
         const src = try frags.source(device, gpa, sources.core_qwen_vision);
@@ -103,6 +104,10 @@ pub fn planBytes(gpa: std.mem.Allocator, c: Config, max_tokens: u32) !usize {
 
 pub const Tower = struct {
     gpa: std.mem.Allocator,
+    /// Kept for a parity dump's buffers: nothing else needs the device after load.
+    device: mtl.Device,
+    /// TF_QWEN_VISION_BLOCKS: a block's output copied aside, one buffer a block; empty when off.
+    dump: []?mtl.Buffer = &.{},
     c: Config,
     k: Kernels,
     w: wts.Weights,
@@ -136,6 +141,7 @@ pub const Tower = struct {
         const t = try gpa.create(Tower);
         errdefer gpa.destroy(t);
         t.gpa = gpa;
+        t.device = device;
         t.c = c;
         t.k = try Kernels.load(gpa, device);
         errdefer t.k.deinit();
@@ -156,6 +162,14 @@ pub const Tower = struct {
             view.* = .{ .buf = t.scratch, .off = at };
             at += std.mem.alignForward(usize, n, 256);
         }
+        if (@import("sys").environment.read(bool, "TF_QWEN_VISION_BLOCKS", false) catch false) {
+            const blocks = try gpa.alloc(?mtl.Buffer, c.depth);
+            @memset(blocks, null);
+            errdefer gpa.free(blocks);
+            const bytes = P * c.hidden * 2;
+            for (blocks) |*b| b.* = try device.buffer(bytes, mtl.ResourceOptions.shared | mtl.ResourceOptions.untracked);
+            t.dump = blocks;
+        }
         t.bytes = plan.bytes() + t.w.buf.length();
         return t;
     }
@@ -224,7 +238,10 @@ pub const Tower = struct {
         e.setValue(h, 5);
         e.setBuffer(t.x.buf, t.x.off, 6);
         e.dispatchThreads(mtl.Size.of(h, P, 1), mtl.Size.of(256, 1, 1));
-        for (t.w.blocks) |b| t.block(e, b, P);
+        for (t.w.blocks, 0..) |b, bi| {
+            t.block(e, b, P);
+            if (bi < t.dump.len) if (t.dump[bi]) |dst| t.copyOut(e, t.x, dst, @as(usize, P) * h);
+        }
         t.norm(e, t.x, t.w.norm_w, t.w.norm_b, t.xn, P, h);
         // the merge: four neighbouring patches' rows, in merge order, are one row of xn read as [T, merged]
         t.linear(e, t.xn, t.w.fc1_w, t.att, T, c.merged(), c.merged());
@@ -237,6 +254,22 @@ pub const Tower = struct {
         e.dispatchThreads(mtl.Size.of(c.out_hidden, T, 1), mtl.Size.of(256, 1, 1));
     }
 
+    /// A block's dumped residual, bf16, for a parity comparison; empty when the dump is off.
+    pub fn blockDump(t: *const Tower, index: usize) []const u8 {
+        if (index >= t.dump.len) return &.{};
+        const b = t.dump[index] orelse return &.{};
+        return b.contents()[0..b.length()];
+    }
+
+    /// The dump of a block's residual: bf16, the tower keeps `x` in fp32 so this reads it as the norm would.
+    fn copyOut(t: *Tower, e: mtl.ComputeEncoder, x: Ref, dst: mtl.Buffer, cells: usize) void {
+        e.setBuffer(x.buf, x.off, 0);
+        e.setBuffer(dst, 0, 1);
+        e.setValue(@as(u32, @intCast(cells)), 2);
+        e.setPipeline(t.k.copy);
+        e.dispatchThreads(mtl.Size.of(@intCast(cells), 1, 1), mtl.Size.of(256, 1, 1));
+    }
+
     fn block(t: *Tower, e: mtl.ComputeEncoder, b: wts.Block, P: u32) void {
         const c = t.c;
         const h = c.hidden;
diff --git a/zig/src/native/qwen27_images.zig b/zig/src/native/qwen27_images.zig
index 839960544..2cd32a99b 100644
--- a/zig/src/native/qwen27_images.zig
+++ b/zig/src/native/qwen27_images.zig
@@ -104,6 +104,14 @@ pub fn encode(v: *Vision, queue: mtl.Queue, s: *const lanes.Stream, slot: u32) !
         if (img.at + img.tokens <= from) continue;
         if (row + img.tokens > v.capacity) return error.ImageTooLarge;
         try v.tower.image(queue, img.pixels, img.gh, img.gw, .{ .buf = v.rows, .off = @as(usize, row) * width * 2 });
+        // TF_QWEN_VISION_BLOCKS: each block's residual beside the server, for a growth curve against a reference
+        for (0..v.c.depth) |bi| {
+            const data = v.tower.blockDump(bi);
+            if (data.len == 0) break;
+            const path = try std.fmt.allocPrint(v.gpa, "vision-block-{d:0>2}.bin", .{bi});
+            defer v.gpa.free(path);
+            try std.Io.Dir.cwd().writeFile(v.io, .{ .sub_path = path, .data = data });
+        }
         const at_row: usize = @as(usize, row) * width * 2;
         const all = v.rows.contents();
         try dump(v, v.io, all[at_row .. at_row + @as(usize, img.tokens) * width * 2], img.tokens, img.gh, img.gw);
