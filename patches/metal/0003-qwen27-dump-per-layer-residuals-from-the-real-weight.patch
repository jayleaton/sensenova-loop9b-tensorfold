diff --git a/zig/tests/qwen27/run.zig b/zig/tests/qwen27/run.zig
index 46420bb9e..6d452742a 100644
--- a/zig/tests/qwen27/run.zig
+++ b/zig/tests/qwen27/run.zig
@@ -47,6 +47,25 @@ fn emit(a: std.mem.Allocator, io: std.Io, dir: []const u8) !void {
         try write(a, io, dir, try std.fmt.allocPrint(a, "lane-{d}.metal", .{i}), text);
     }
 }
+/// The tapped residual of every requested layer for the prompt's rows: a header, then one plane a layer.
+fn dumps(a: std.mem.Allocator, io: std.Io, r: *q.decode_round.Runner, rows: usize, path: []const u8) !void {
+    const t = r.taps;
+    const row_bytes = @as(usize, t.width) * 2;
+    var out: std.ArrayList(u8) = .empty;
+    defer out.deinit(a);
+    var header: [16]u8 = undefined;
+    @memcpy(header[0..4], std.mem.asBytes(&@as(u32, @intCast(t.count))));
+    @memcpy(header[4..8], std.mem.asBytes(&@as(u32, @intCast(rows))));
+    @memcpy(header[8..12], std.mem.asBytes(&@as(u32, t.width)));
+    @memcpy(header[12..16], std.mem.asBytes(&@as(u32, @intCast(t.capacity))));
+    try out.appendSlice(a, &header);
+    for (0..t.count) |plane| {
+        const offset = plane * @as(usize, t.capacity) * row_bytes;
+        try out.appendSlice(a, t.buffer.contents()[offset..][0 .. rows * row_bytes]);
+    }
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = path, .data = out.items });
+}
+
 const Difference = struct { position: usize, expected: ?u32, actual: u32, top2: q.session.TopTwo };
 const Generated = struct { tokens: []u32, first_difference: ?Difference, top2: ?[]q.session.TopTwo };
 fn generated(a: std.mem.Allocator, s: q.session.Session, count: usize, force: bool, expected: ?[]const u32, trace: ?*profile.Trace, profile_steps: usize, teacher: bool) !Generated {
