+/// A window layer's branch plane, one layer wide: recorded on the narrow tape beside the streams.
+pub const branch_tap = 1003;
 /// A verified head's dependent readback work stays in its final command buffer.
 pub const Tail = struct { ptr: *anyopaque, encode: *const fn (*anyopaque, mtl.ComputeEncoder) anyerror!void };
 pub const Stages = struct {
@@ -136,20 +140,27 @@ pub const Stages = struct {
             const b = s.hc(f);
             // only the window's first layer expands h into the streams; after it the residual is the streams
             if (m.config.physical(index) == mh.start) {
+                // the window's input is the layer-3 residual with its pending output folded in exactly once
+                const from = f.get(.hidden);
                 if (s.pending) |pending| {
-                    // the previous layer's output is still pending: fold it in, as the norm that would run here does
-                    m.glue.residual(e, s.hidden, pending, s.hidden, h, s.rows);
+                    m.glue.residual(e, from, pending, from, h, s.rows);
                     e.barrier();
-                    if (s.hooks.tap) |tap| try tap(s.hooks.ptr, e, index - 1, s.hidden, s.rows);
+                    if (s.hooks.tap) |tap| try tap(s.hooks.ptr, e, index - 1, from, s.rows);
                 }
-                mhc_mod.enter(e, m.mhc.?, b, b.params(mh, h), s.rows, s.hidden, null);
+                // the norm's residual may have been swapped: stage it so enter reads one buffer
+                if (s.hidden.buffer.id != from.buffer.id or s.hidden.offset != from.offset) {
+                    try m.glue.unstack(e, from, s.hidden, .{ .rows = s.rows, .width = h, .stride = h, .offset = 0 });
