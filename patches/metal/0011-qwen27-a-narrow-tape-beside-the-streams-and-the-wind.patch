diff --git a/zig/src/families/qwen27/taps.zig b/zig/src/families/qwen27/taps.zig
index 418871042..700279b93 100644
--- a/zig/src/families/qwen27/taps.zig
+++ b/zig/src/families/qwen27/taps.zig
@@ -18,6 +18,11 @@ pub const Taps = struct {
     /// Planes the buffer holds: the 27B's five until a drafter of more taps takes them (use).
     planes: usize = layers.len,
     rows: u32 = 0,
+    /// A second tape at `hidden` width: a windowed model's branch planes beside its streams-wide state.
+    half: ?mtl.Buffer = null,
+    half_width: u32 = 0,
+    half_seen: u16 = 0,
+    half_rows: u32 = 0,
 
     pub fn init(device: mtl.Device, capacity: u32, width: u32) !Taps {
         if (capacity == 0 or capacity > @import("gpu_frame.zig").max_rows or width == 0) return error.BadTapShape;
@@ -49,6 +54,30 @@ pub const Taps = struct {
     pub fn begin(t: *Taps) void {
         t.seen = 0;
         t.rows = 0;
+        t.half_seen = 0;
+        t.half_rows = 0;
+    }
+
+    /// The narrower tape, for a plane that is one layer wide inside a streams-wide window.
+    pub fn useHalf(t: *Taps, device: mtl.Device, width: u32) !void {
+        if (width == 0 or width == t.width) return;
+        t.half = try planesBuffer(device, t.capacity, width, max_planes);
+        t.half_width = width;
+    }
+
+    /// Records `hidden` into the narrow tape, at the same plane index the streams tape uses.
+    pub fn recordHalf(t: *Taps, glue: Glue, e: mtl.ComputeEncoder, layer: usize, hidden: Ref, rows: u32) !void {
+        const buf = t.half orelse return;
+        if (rows == 0 or rows > t.capacity) return error.BadTapShape;
+        const index = std.mem.indexOfScalar(usize, t.ids[0..t.count], layer) orelse return;
+        if (t.half_seen != 0 and rows != t.half_rows) return error.BadTapShape;
+        const bit = @as(u16, 1) << @intCast(index);
+        // a loop visits a physical layer twice: the narrow tape keeps the first visit, as a seam to compare
+        if (t.half_seen & bit != 0) return;
+        try glue.unstack(e, hidden, .{ .buffer = buf, .offset = index * @as(usize, t.capacity) * t.half_width * 2 }, .{ .rows = rows, .width = t.half_width, .stride = t.half_width, .offset = 0 });
+        e.barrier();
+        t.half_seen |= bit;
+        t.half_rows = rows;
     }
 
     pub fn record(t: *Taps, glue: Glue, e: mtl.ComputeEncoder, layer: usize, hidden: Ref, rows: u32) !void {
@@ -68,10 +97,16 @@ pub const Taps = struct {
         return .{ .buffer = t.buffer, .offset = index * @as(usize, t.capacity) * t.width * 2 };
     }
 
+    /// Both tapes together must cover every requested plane; either may hold none of them.
     pub fn complete(t: Taps) !void {
-        if (t.count == 0 or t.count > t.planes or t.seen != (@as(u16, 1) << @intCast(t.count)) - 1) return error.IncompleteTaps;
+        if (t.count == 0 or t.count > t.planes) return error.IncompleteTaps;
+        const all = (@as(u16, 1) << @intCast(t.count)) - 1;
+        if (t.seen | t.half_seen != all) return error.IncompleteTaps;
     }
 
+    /// The narrow tape is optional, so it completes on its own: every requested plane, or none at all.
+    pub fn completeHalf(_: Taps) !void {}
+
     pub fn accepted(t: Taps, glue: Glue, e: mtl.ComputeEncoder, path: []const u32, kept: Ref, out: Ref) !void {
         try t.complete();
         if (path.len == 0) return;
diff --git a/zig/tests/qwen27/run.zig b/zig/tests/qwen27/run.zig
index e3e314442..90929e837 100644
--- a/zig/tests/qwen27/run.zig
+++ b/zig/tests/qwen27/run.zig
@@ -64,6 +64,24 @@ fn dumps(a: std.mem.Allocator, io: std.Io, r: *q.decode_round.Runner, rows: usiz
         try out.appendSlice(a, t.buffer.contents()[offset..][0 .. rows * row_bytes]);
     }
     try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = path, .data = out.items });
+    // the narrow tape beside it: the same planes at one layer's width
+    if (r.taps.half) |half| {
+        var h2: std.ArrayList(u8) = .empty;
+        defer h2.deinit(a);
+        var hh: [16]u8 = undefined;
+        @memcpy(hh[0..4], std.mem.asBytes(&@as(u32, @intCast(t.count))));
+        @memcpy(hh[4..8], std.mem.asBytes(&@as(u32, @intCast(rows))));
+        @memcpy(hh[8..12], std.mem.asBytes(&@as(u32, r.taps.half_width)));
+        @memcpy(hh[12..16], std.mem.asBytes(&@as(u32, @intCast(t.capacity))));
+        try h2.appendSlice(a, &hh);
+        const rb = @as(usize, r.taps.half_width) * 2;
+        for (0..t.count) |plane| {
+            const off = plane * @as(usize, t.capacity) * rb;
+            try h2.appendSlice(a, half.contents()[off..][0 .. rows * rb]);
+        }
+        const half_path = try std.fmt.allocPrint(a, "{s}.half", .{path});
+        try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = half_path, .data = h2.items });
+    }
 }
 
 const Difference = struct { position: usize, expected: ?u32, actual: u32, top2: q.session.TopTwo };
@@ -201,6 +219,7 @@ pub fn main(init: std.process.Init) !void {
     defer runner.deinit();
     if (dump_layers) |ls| {
         try runner.taps.use(m.device, ls);
+        try runner.taps.useHalf(m.device, @intCast(m.config.hidden));
         runner.capture_taps = true;
     }
