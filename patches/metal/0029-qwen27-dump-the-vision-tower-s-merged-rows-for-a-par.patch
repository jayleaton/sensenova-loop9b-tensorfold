+/// TF_QWEN_VISION_DUMP: the tower's merged rows, so a vision port can be compared with its reference.
+pub fn dump(v: *const Vision, io: std.Io, out: []const u8, rows: u32, gh: u32, gw: u32) !void {
+    if (!(@import("sys").environment.read(bool, "TF_QWEN_VISION_DUMP", false) catch false)) return;
+    const width: usize = @as(usize, rows) * v.c.out_hidden * 2;
+    if (out.len < width) return error.VisionShape;
+    const path = try std.fmt.allocPrint(v.gpa, "vision-tower-{d}x{d}.bin", .{ gh, gw });
+    defer v.gpa.free(path);
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = path, .data = out[0..width] });
+    std.log.info("qwen vision: wrote {s} ({d} rows of {d})", .{ path, rows, v.c.out_hidden });
+}
+
 /// `s`'s rows' M-RoPE layout: empty for text, its placeholders checked against its images otherwise.
 pub fn layout(v: ?*const Vision, s: *const lanes.Stream) !vl.rope.Layout {
     if (s.images.len == 0) return .{};
@@ -92,6 +104,9 @@ pub fn encode(v: *Vision, queue: mtl.Queue, s: *const lanes.Stream, slot: u32) !
         if (img.at + img.tokens <= from) continue;
         if (row + img.tokens > v.capacity) return error.ImageTooLarge;
         try v.tower.image(queue, img.pixels, img.gh, img.gw, .{ .buf = v.rows, .off = @as(usize, row) * width * 2 });
+        const at_row: usize = @as(usize, row) * width * 2;
+        const all = v.rows.contents();
+        try dump(v, v.io, all[at_row .. at_row + @as(usize, img.tokens) * width * 2], img.tokens, img.gh, img.gw);
         try v.spans.append(v.gpa, .{ .at = img.at, .n = img.tokens, .row = row });
         row += img.tokens;
     }
