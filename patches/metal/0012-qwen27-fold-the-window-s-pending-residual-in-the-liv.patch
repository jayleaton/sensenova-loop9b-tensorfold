From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jay Leaton <58495321+jayleaton@users.noreply.github.com>
Date: Wed, 18 Nov 2026 03:51:48 +0800
Subject: [PATCH 12/44] qwen27: fold the window's pending residual in the live
 buffer

The fold staged into frame.hidden even after the norm's swap had made the live
residual frame.residual, so it folded pending into a stale row and then let enter
read that. Folding in place, where s.hidden actually points, and consuming
pending make the window's input measure 0.125 against the reference, the same
accuracy the plain path has, instead of 5.94.

Taps now route by seam id at or past seam_base to the narrow tape and a layer id
to the streams tape, so one hook records both widths.
---
 zig/src/families/qwen27/decode_round.zig |  3 +--
 zig/src/families/qwen27/forward.zig      | 21 ++++++++++-----------
 zig/src/families/qwen27/taps.zig         | 17 ++++++++++++++---
 zig/tests/qwen27/run.zig                 |  1 -
 4 files changed, 25 insertions(+), 17 deletions(-)

diff --git a/zig/src/families/qwen27/decode_round.zig b/zig/src/families/qwen27/decode_round.zig
index 76fc38ad6..03620113d 100644
--- a/zig/src/families/qwen27/decode_round.zig
+++ b/zig/src/families/qwen27/decode_round.zig
@@ -558,8 +558,7 @@ pub const Runner = struct {
 
     fn tap(ptr: *anyopaque, e: mtl.ComputeEncoder, layer: usize, hidden: @import("projection.zig").Ref, rows: u32) !void {
         const r: *Runner = @ptrCast(@alignCast(ptr));
-        try r.taps.record(r.model.glue, e, layer, hidden, rows);
-        try r.taps.recordHalf(r.model.glue, e, layer, hidden, rows);
+        try r.taps.recordOne(r.model.glue, e, layer, hidden, rows);
     }
 };
 
diff --git a/zig/src/families/qwen27/forward.zig b/zig/src/families/qwen27/forward.zig
