+/// SenseNova-Loop-9B's config, `quant` naming its own table or exllamav3's quantization_config, 32 layers of four.
+fn sensenova(a: std.mem.Allocator, quant: []const u8) ![]u8 {
+    var json: std.ArrayList(u8) = .empty;
+    errdefer json.deinit(a);
+    try json.appendSlice(a, "{\"model_type\":\"sensenova_loop\",");
+    try json.appendSlice(a, quant);
+    try json.appendSlice(a, ",\"tie_word_embeddings\":false,\"loop_settings\":{\"counts\":[2],\"end\":28,\"eval_count\":2,\"start\":4},\"mhc\":{\"end\":28,\"fixed_identity\":false,\"iterations\":20,\"pre_scale\":1.0,\"start\":4,\"streams\":2},\"text_config\":{\"model_type\":\"qwen3_5_text\",\"attention_bias\":false,\"attn_output_gate\":true,\"hidden_act\":\"silu\",\"head_dim\":256,\"linear_key_head_dim\":128,\"linear_value_head_dim\":128,\"linear_conv_kernel_dim\":4,\"hidden_size\":4096,\"intermediate_size\":12288,\"num_hidden_layers\":32,\"vocab_size\":248320,\"linear_num_key_heads\":16,\"linear_num_value_heads\":32,\"num_attention_heads\":16,\"num_key_value_heads\":4,\"rms_norm_eps\":1e-06,\"max_position_embeddings\":524288,\"layer_types\":[");
+    for (0..32) |i| {
+        if (i != 0) try json.append(a, ',');
+        try json.appendSlice(a, if ((i + 1) % 4 == 0) "\"full_attention\"" else "\"linear_attention\"");
+    }
+    try json.appendSlice(a, "],\"rope_parameters\":{\"rope_type\":\"yarn\",\"rope_theta\":10000000,\"partial_rotary_factor\":0.25,\"factor\":2.0,\"original_max_position_embeddings\":262144}}}");
+    return json.toOwnedSlice(a);
+}
+
+test "SenseNova-Loop-9B's EXL3 config: the loop and mHC parse before the format branch, so the loader sees them" {
+    const a = std.testing.allocator;
+    const json = try sensenova(a, "\"quantization_config\":{\"quant_method\":\"exl3\",\"version\":\"1.5.4\",\"bits\":5.0,\"head_bits\":6,\"codebook\":\"mul1\"}");
+    defer a.free(json);
+    const g = try parse(a, json);
+    try std.testing.expect(g.exl3 and g.mhc != null);
+    try std.testing.expectEqual(@as(usize, 4), g.loop_start);
+    try std.testing.expectEqual(@as(usize, 28), g.loop_end);
+    try std.testing.expectEqual(@as(usize, 2), g.loop_count);
+    try std.testing.expectEqual(@as(usize, 56), g.steps());
+    const m = g.mhc.?;
+    try std.testing.expectEqual(@as(usize, 2), m.streams);
+    try std.testing.expectEqual(@as(usize, 20), m.iterations);
+    try std.testing.expectEqual(@as(usize, 8), m.outputs());
+    try std.testing.expect(m.holds(4) and m.holds(27) and !m.holds(3) and !m.holds(28));
+}
