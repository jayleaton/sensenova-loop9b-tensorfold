index 000000000..7b6bd768a
--- /dev/null
+++ b/tools/exl3_attach_sensenova.py
@@ -0,0 +1,186 @@
+#!/usr/bin/env python3
+"""Present a SenseNova-Loop-9B or stock Qwen3.5-9B BF16 checkpoint as exllamav3's `qwen3_5`, and attach its extras.
+
+Two steps around exllamav3's convert_model.py:
+
+  shim    a temp directory of symlinks: the source's shards, tokenizer and generation config, with the
+          text tower's config so `Qwen3_5ForCausalLM` traces it (no loop_settings, no mHC,
+          no vision_config, no quantization table)
+  attach  after conversion: the mHC and loop_gate tensors the traced model never sees, copied into their
+          own shard; SenseNova's config.json restored with the converter's quantization_config; the
+          tokenizer and chat template copied; every shard's size and sha256 reported
+
+Credit: EXL3 is exllamav3's format, quantizer and layout (turboderp,
+https://github.com/turboderp-org/exllamav3); the trellis codebooks are QTIP's (Tseng, Chee, Sun, Kuleshov,
+De Sa).
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import re
+import shutil
+import sys
+
+TEXT_ARCH = "Qwen3_5ForCausalLM"
+EXTRA_SHARD = "model-sensenova-extras.safetensors"
+TOKENIZER_FILES = (
+    "tokenizer.json",
+    "tokenizer_config.json",
+    "added_tokens.json",
+    "special_tokens_map.json",
+    "chat_template.jinja",
+    "chat_template.json",
+    "generation_config.json",
+)
+# SenseNova's own tensors: mHC's routers (f32 as shipped) and the loop gate, which Metal skips today.
+EXTRA = re.compile(r"\.(mhc_attn|mhc_ffn)\.(weight|bias)$|(^|\.)loop_gate\.")
+
+
+def read_json(path: str) -> dict:
+    with open(path, encoding="utf8") as f:
+        return json.load(f)
+
+
+def write_json(path: str, value: dict):
+    with open(path, "w", encoding="utf8") as f:
+        json.dump(value, f, indent=2)
+        f.write("\n")
+
+
+def shim(source: str, out: str, force: bool):
+    """A directory exllamav3 reads as a stock Qwen3.5: the text config and symlinks to every source file."""
+    if os.path.exists(out) and os.listdir(out):
+        if not force:
+            raise SystemExit(f"{out} is not empty; pass --force to replace its shim files")
+        shutil.rmtree(out)
+    os.makedirs(out, exist_ok=True)
+    source_config = read_json(os.path.join(source, "config.json"))
+    if "text_config" not in source_config:
+        raise SystemExit(f"{source}: no text_config; this is not a Qwen3.5-9B checkpoint")
+    # exllamav3's ConditionalGeneration config requires a vision_config; the CausalLM one reads the text keys at the
+    # root under the same model.language_model prefix, so the tower is traced without its vision or loop blocks
+    config = dict(source_config["text_config"])
+    for key in ("tie_word_embeddings", "bos_token_id", "eos_token_id", "pad_token_id", "image_token_id"):
+        if key in source_config and key not in config:
+            config[key] = source_config[key]
+    config["architectures"] = [TEXT_ARCH]
+    config["model_type"] = "qwen3_5_text"
+    write_json(os.path.join(out, "config.json"), config)
+    linked = 0
+    for name in sorted(os.listdir(source)):
+        if name == "config.json":
+            continue
+        src = os.path.join(source, name)
+        if not os.path.isfile(src) or name.startswith(("preprocessor_config", "video_preprocessor")):
+            continue
+        os.symlink(os.path.abspath(src), os.path.join(out, name))
+        linked += 1
+    print(f"shim: {out} ({linked} files linked, {len(config['architectures'])} architecture)")
+    print(f"      convert with: -i {out} -b BITS -hb HEAD -eb 16 -cb mul1 --hessians HESS --out_scales always")
+
+
+def source_tensors(source: str):
+    """{tensor name: (shard path, tensor)} for the extras, read through safe_open and left on disk."""
+    from safetensors import safe_open
+
+    found = {}
+    for name in sorted(os.listdir(source)):
+        if not name.endswith(".safetensors"):
+            continue
+        path = os.path.join(source, name)
+        with safe_open(path, framework="pt", device="cpu") as f:
+            for key in f.keys():
+                if EXTRA.search(key):
+                    found[key] = (path, f.get_tensor(key))
+    return found
+
+
+def attach(source: str, converted: str, recipe: str | None, cal_rows: int, cal_cols: int):
+    """SenseNova's config, extras shard, tokenizer and an index that names the extras; then the report."""
+    extras = source_tensors(source)
+    if extras:
+        from safetensors.torch import save_file
+
+        shard = os.path.join(converted, EXTRA_SHARD)
+        save_file({key: tensor for key, (_, tensor) in extras.items()}, shard)
+        os.chmod(shard, 0o644)  # safetensors creates it 0600; the pack is copied out by other users
+    converted_config = read_json(os.path.join(converted, "config.json"))
+    if "quantization_config" not in converted_config:
+        raise SystemExit(f"{converted}: no quantization_config; did convert_model.py finish?")
+    qa = dict(converted_config["quantization_config"])
+    qa["calibration"] = {"rows": cal_rows, "cols": cal_cols, "method": "sensenova-loop-hessian"}
+    config = read_json(os.path.join(source, "config.json"))
+    config["quantization_config"] = qa
+    if recipe:
+        config["tensorfold_recipe"] = recipe
+    write_json(os.path.join(converted, "config.json"), config)
+    for name in TOKENIZER_FILES:
+        src = os.path.join(source, name)
+        if os.path.isfile(src):
+            shutil.copyfile(src, os.path.join(converted, name))
+    if extras:
+        write_index(converted)
+    report(converted, extras)
+
+
+def write_index(converted: str):
+    """A complete `model.safetensors.index.json`: the converted shards' tensors and the extras, by file."""
+    from safetensors import safe_open
+
+    weight_map = {}
+    for name in sorted(os.listdir(converted)):
+        if not name.endswith(".safetensors"):
+            continue
+        with safe_open(os.path.join(converted, name), framework="pt", device="cpu") as f:
+            for key in f.keys():
+                weight_map[key] = name
+    total = sum(os.path.getsize(os.path.join(converted, name)) for name in set(weight_map.values()))
+    write_json(os.path.join(converted, "model.safetensors.index.json"), {"metadata": {"total_size": total}, "weight_map": weight_map})
+
+
+def report(converted: str, extras: dict):
+    """The shard list the Mac and CUDA gates check: file, bytes and sha256, plus the extras' names."""
+    shards = sorted(name for name in os.listdir(converted) if name.endswith(".safetensors"))
+    total = 0
+    print(f"attach: {converted}")
+    for name in shards:
+        path = os.path.join(converted, name)
+        size = os.path.getsize(path)
+        total += size
+        digest = hashlib.sha256()
+        with open(path, "rb") as f:
+            for chunk in iter(lambda: f.read(1 << 24), b""):
+                digest.update(chunk)
+        print(f"  {name}  {size} bytes  sha256 {digest.hexdigest()}")
+    print(f"  {total / 1e9:.2f} GB across {len(shards)} shards")
+    for key in sorted(extras):
+        print(f"  extra: {key}")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = parser.add_subparsers(dest="command", required=True)
+    make = sub.add_parser("shim", help="present the source as exllamav3's qwen3_5 in a temp directory")
+    make.add_argument("--source", required=True)
+    make.add_argument("--out", required=True)
+    make.add_argument("--force", action="store_true")
+    done = sub.add_parser("attach", help="add the mHC/loop tensors, config, tokenizer and report")
+    done.add_argument("--source", required=True, help="the BF16 checkpoint the extras come from")
+    done.add_argument("--converted", required=True, help="exllamav3's output directory")
+    done.add_argument("--recipe", default=None, help="the recipe name to record in config.json (sn-5.0, st-4.0, ...)")
+    done.add_argument("--cal-rows", type=int, default=250)
+    done.add_argument("--cal-cols", type=int, default=2048)
+    args = parser.parse_args()
+    if args.command == "shim":
+        shim(args.source, args.out, args.force)
+    else:
+        attach(args.source, args.converted, args.recipe, args.cal_rows, args.cal_cols)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
