 }
+
+/// A checkpoint of three eight-element vectors, one of each dtype SenseNova's and exllamav3's packs store.
+fn writeVectors(dir: std.Io.Dir) !void {
+    const at: [3]usize = .{ 0, 32, 48 };
+    const header = try std.fmt.allocPrint(t.allocator, "{{\"v.f32\":{{\"dtype\":\"F32\",\"shape\":[8],\"data_offsets\":[{d},{d}]}}," ++
+        "\"v.bf16\":{{\"dtype\":\"BF16\",\"shape\":[8],\"data_offsets\":[{d},{d}]}}," ++
+        "\"v.f16\":{{\"dtype\":\"F16\",\"shape\":[8],\"data_offsets\":[{d},{d}]}}}}", .{ at[0], at[1], at[1], at[2], at[2], 64 });
+    defer t.allocator.free(header);
+    const data = try t.allocator.alloc(u8, 8 + header.len + 64);
+    defer t.allocator.free(data);
+    @memset(data, 0);
+    std.mem.writeInt(u64, data[0..8], header.len, .little);
+    @memcpy(data[8..][0..header.len], header);
+    const body = data[8 + header.len ..];
+    const f32s = [_]f32{ 1.0, -2.5, 0.0, 3.25, -0.0, std.math.inf(f32), -std.math.nan(f32), 1e-30 };
+    for (f32s, 0..) |v, i| std.mem.writeInt(u32, body[4 * i ..][0..4], @bitCast(v), .little);
+    const bf16s: [8]u16 = .{ 0x3f80, 0xc020, 0x0000, 0x4050, 0x8000, 0x7f80, 0x7fc0, 0x0001 };
+    for (bf16s, 0..) |v, i| std.mem.writeInt(u16, body[32 + 2 * i ..][0..2], v, .little);
+    const f16s: [8]u16 = .{ 0x3c00, 0xc100, 0x0000, 0x4280, 0x8000, 0x7c00, 0x7e00, 0x0001 };
+    for (f16s, 0..) |v, i| std.mem.writeInt(u16, body[48 + 2 * i ..][0..2], v, .little);
+    try dir.writeFile(t.io, .{ .sub_path = "model.safetensors", .data = data });
+}
+
+test "EXL3 dtypes: f32, bf16 and f16 vectors pass admission with the old dtypes' bytes" {
+    const d = @import("cuda_exl3_dtype.zig");
+    var tmp = t.tmpDir(.{});
+    defer tmp.cleanup();
+    try writeVectors(tmp.dir);
+    const path = try pathOf(tmp);
+    defer t.allocator.free(path);
+    var ck = try core.Checkpoint.openModel(t.allocator, t.io, path);
+    defer ck.close();
+    const shape: []const usize = &.{8};
+    const f32t = try ck.get("v.f32");
+    const bf16t = try ck.get("v.bf16");
+    const f16t = try ck.get("v.f16");
+    try t.expectEqual(d.From.stored, try d.accept(f32t, .f32, shape));
+    try t.expectEqual(d.From.bf16, try d.accept(bf16t, .f32, shape));
+    try t.expectError(error.UnexpectedTensor, d.accept(f16t, .f32, shape));
+    try t.expectEqual(d.From.f32, try d.accept(f32t, .bf16, shape));
+    try t.expectEqual(d.From.stored, try d.accept(bf16t, .bf16, shape));
+    try t.expectEqual(d.From.f16, try d.accept(f16t, .bf16, shape));
+
+    // A_log as the loader widens it: the stored bf16 bits above each f32 word
+    var words: [8]u32 = undefined;
+    d.widen(&words, bf16t.bytes);
+    for (words, std.mem.bytesAsSlice(u16, bf16t.bytes)) |w, h| try t.expectEqual(@as(u32, h) << 16, w);
+    // dt_bias and the gated norm as the loader rounds them: f32 through bf16vec's spelling, f16 through bits()
+    var rows: [8]u16 = undefined;
+    d.round(&rows, f32t.bytes, .f32);
+    for (rows, std.mem.bytesAsSlice(f32, f32t.bytes)) |o, f| {
+        const b: u32 = @bitCast(f);
+        try t.expectEqual(@as(u16, @truncate((b +% 0x7fff +% ((b >> 16) & 1)) >> 16)), o);
+    }
+    d.round(&rows, f16t.bytes, .f16);
+    for (rows, std.mem.bytesAsSlice(u16, f16t.bytes)) |o, h| {
+        try t.expectEqual(core.bf16_round.bits(@floatCast(@as(f16, @bitCast(h)))), o);
+    }
+}
