new file mode 100755
index 000000000..abe197a5f
--- /dev/null
+++ b/tools/exl3_sensenova_chain.sh
@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+# exl3_sensenova_chain.sh: the whole SenseNova-Loop-9B EXL3 run (docs/exl3-sensenova-quantize.md) as one resumable chain:
+# shims, Hessians, task-gate references, one exllamav3 convert and attach per recipe in docs/exl3-recipes/, then the
+# stock Qwen3.5-9B control at the same recipes when EXL3_STOCK is set. SenseNova's packs come first.
+#
+#   EXL3_WORK=$WORK/exl3 EXL3_SOURCE=$WORK/bf16 EXLLAMAV3=$SRC/exllamav3 \
+#   EXL3_PY=$VENV/bin/python [EXL3_STOCK=$WORK/stock-qwen35-9b-bf16] [EXL3_GPU_LOCK=/tmp/gpu.lock] \
+#   tools/exl3_sensenova_chain.sh
+#
+# Each finished step leaves $EXL3_WORK/done/<step>, so a rerun resumes after the last one. A GPU step holds
+# EXL3_GPU_LOCK (flock) for itself alone and releases it between steps, so other GPU jobs on the node can slip in.
+# Every step refuses to start below EXL3_MIN_FREE_GIB of MemAvailable (default 40).
+set -uo pipefail
+w=${EXL3_WORK:?EXL3_WORK: the work directory for the chain}
+sn=${EXL3_SOURCE:?EXL3_SOURCE: SenseNova-Loop-9B BF16}
+x3=${EXLLAMAV3:?EXLLAMAV3: an exllamav3 checkout at the pinned commit, its extension built}
+st=${EXL3_STOCK:-}
+py=${EXL3_PY:-python3}
+lock=${EXL3_GPU_LOCK:-}
+min_free=${EXL3_MIN_FREE_GIB:-40}
+repo=$(cd "$(dirname "$0")/.." && pwd)
+mkdir -p "$w/done" "$w/logs" "$w/hess" "$w/packs" "$w/work" "$w/gate"
+log() { echo "$(date -u +%FT%TZ) $*" | tee -a "$w/logs/chain.log"; }
+fail() { echo "rc=$1 at $2" > "$w/CHAIN-END"; log "stop: rc=$1 at $2"; exit "$1"; }
+guard() {
+  local a; a=$(awk '/MemAvailable/{print int($2/1048576)}' /proc/meminfo)
+  [ "$a" -ge "$min_free" ] || { log "refuse $1: MemAvailable $a GiB < $min_free"; fail 4 "$1"; }
+}
+step() {  # step gpu|cpu NAME CMD...: niced and logged; skipped when done; the chain stops on the first failure
+  local kind=$1 name=$2; shift 2
+  [ -e "$w/done/$name" ] && { log "skip $name (done)"; return; }
+  if [ "$kind" = gpu ] && [ -n "$lock" ]; then
+    [ -e "$lock" ] || : > "$lock"
+    exec 8<"$lock"  # read-only: in a sticky /tmp, protected_regular refuses opening another user's file for writing
+    log "wait lock $name"; flock -w 7200 8 || fail 3 "$name (lock)"
+  fi
+  guard "$name"; log "start $name"
+  nice -n 19 ionice -c3 "$@" 8>&- > "$w/logs/$name.log" 2>&1; local rc=$?
+  [ "$kind" = gpu ] && [ -n "$lock" ] && { flock -u 8; exec 8>&-; }
+  log "end $name rc=$rc"; [ $rc -eq 0 ] || fail "$rc" "$name"
+  touch "$w/done/$name"
+}
+recipe() { "$py" -I -c 'import json,sys; r=json.load(open(sys.argv[1])); print(r["bits"], r["head_bits"], r["embed_bits"], r["codebook"], r["out_scales"])' "$1"; }
+model() {  # model TAG SOURCE: shim, Hessians, gate references, then a pack per recipe
+  local m=$1 src=$2 r bits head embed cb scales name
+  step cpu "shim-$m" "$py" -I "$repo/tools/exl3_attach_sensenova.py" shim --source "$src" --out "$w/shim-$m"
+  step gpu "hess-$m" "$py" -I "$repo/tools/exl3_hessians.py" --source "$src" --shim "$w/shim-$m" --out "$w/hess/$m" \
+    --exllamav3 "$x3"
+  step gpu "gate-$m" "$py" -I "$repo/tools/exl3_gate_ref.py" "$src" "$w/gate/$m"
+  for r in "$repo"/docs/exl3-recipes/*.json; do
+    read -r bits head embed cb scales < <(recipe "$r") || fail 2 "recipe $r"
+    name=$m-$(basename "$r" .json)
+    step gpu "conv-$name" "$py" -I "$x3/convert.py" -i "$w/shim-$m" -o "$w/packs/$name" -w "$w/work/$name" -b "$bits" \
+      -hb "$head" -eb "$embed" -cb "$cb" --hessians "$w/hess/$m" --out_scales "$scales" -d 0 --no_swap
+    log "uncalibrated tensors in $name: $(grep -c "No precomputed Hessian" "$w/logs/conv-$name.log")"
+    step cpu "attach-$name" "$py" -I "$repo/tools/exl3_attach_sensenova.py" attach --source "$src" \
+      --converted "$w/packs/$name" --recipe "$name"
+  done
+}
+export TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST:-12.1}
+model sn "$sn"
+[ -n "$st" ] && model st "$st"
+echo "rc=0 $(date -u +%FT%TZ)" > "$w/CHAIN-END"
+log "chain done"
