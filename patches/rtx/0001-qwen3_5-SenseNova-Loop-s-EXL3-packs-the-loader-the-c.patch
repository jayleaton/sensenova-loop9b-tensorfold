+++ b/tools/exl3_gate_ref.py
@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+"""exl3_gate_ref.py SOURCE OUT: the EXL3 task gate's BF16 references. Greedy, 64 new tokens each, on a prose, a code
+and a reasoning prompt, written to OUT/meta.json (prompt, ids, greedy, text) for teacher-forced top-1 against a pack."""
+import json
+import os
+import sys
+import time
+
+import torch
+from transformers import AutoModelForCausalLM, AutoTokenizer
+
+PROMPTS = [
+    ("prose", "Write a short paragraph describing a quiet morning in a mountain village."),
+    ("code", "Write a Python function fib(n) that returns the n-th Fibonacci number, then show an iterative version."),
+    ("reason", "A train leaves at 3:15 pm and travels 180 km at 72 km/h. At what time does it arrive? Think step by step."),
+]
+src, out = sys.argv[1], sys.argv[2]
+os.makedirs(out, exist_ok=True)
+tok = AutoTokenizer.from_pretrained(src)
+t0 = time.time()
+m = AutoModelForCausalLM.from_pretrained(src, dtype=torch.bfloat16, device_map={"": "cuda:0"}, trust_remote_code=True,
+                                         attn_implementation="sdpa").eval()
+res = {"source": src, "class": type(m).__name__, "load_s": time.time() - t0, "new_tokens": 64, "prompts": []}
+for name, p in PROMPTS:
+    text = tok.apply_chat_template([{"role": "user", "content": p}], tokenize=False, add_generation_prompt=True,
+                                   enable_thinking=False)
+    ids = tok(text, return_tensors="pt").input_ids.to("cuda")
+    with torch.no_grad():
+        g = m.generate(input_ids=ids, max_new_tokens=64, min_new_tokens=64, do_sample=False, use_cache=True)
+    new = g[0, ids.shape[1]:].tolist()
+    res["prompts"].append({"name": name, "prompt": p, "ids": ids[0].tolist(), "greedy": new,
+                           "text": tok.decode(new, skip_special_tokens=False)})
+    print(name, len(ids[0]), len(new), res["prompts"][-1]["text"][:80].replace("\n", " "), flush=True)
+json.dump(res, open(f"{out}/meta.json", "w"), indent=1)
+print("wrote", out)
diff --git a/tools/exl3_hessians.py b/tools/exl3_hessians.py
new file mode 100644
index 000000000..a8ee583af
--- /dev/null
+++ b/tools/exl3_hessians.py
@@ -0,0 +1,267 @@
+#!/usr/bin/env python3
+"""Capture exllamav3's per-tensor input Hessians from a BF16 reference model.
+
+Writes `{out}/{hf_tensor_name}.safetensors` holding `hin`, f32, as a packed upper triangle, which is
+`conversion/convert_model.py --hessians`' format (`unpack_sym`). Run it once per model: SenseNova-Loop-9B
+(looped layers [4, 28) and mHC streams) and stock Qwen3.5-9B (the control). Then convert each with
+exllamav3's own convert_model.py, which trusts these Hessians instead of tracing its own forward.
+
+The loop needs no special case: layers [4, 28) execute twice and the hook fires twice, so their Hessian is
+the sum over both visits. mHC needs none either: the hooks see each linear's real branch input, and the
+routers stay f32 and unquantized. Linears that share an input (q/k/v, in_proj_qkv/z, gate/up) share one
+capture and one conversion, written once per key.
+
+Credit: EXL3 is exllamav3's format and quantizer (turboderp, https://github.com/turboderp-org/exllamav3);
+the trellis codebooks are QTIP's (Tseng, Chee, Sun, Kuleshov, De Sa).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import sys
+
+import torch
+
+
+# The linears a SenseNova/exllamav3 pack quantizes, by their HF tensor name (suffix of the module path).
+LAYOUT = re.compile(
+    r"\.(self_attn\.(q|k|v|o)_proj"
+    r"|linear_attn\.(in_proj_qkv|in_proj_z|out_proj)"
+    r"|mlp\.(gate|up|down)_proj)$"
+)
+HEAD = "lm_head"
+
+# Members sharing one input and one Hessian: (member pattern, group suffix, anchor member).
+SHARED = (
+    (re.compile(r"\.self_attn\.(q|k|v)_proj$"), ".self_attn", "q_proj"),
+    (re.compile(r"\.linear_attn\.(in_proj_qkv|in_proj_z)$"), ".linear_attn", "in_proj_qkv"),
+    (re.compile(r"\.mlp\.(gate|up)_proj$"), ".mlp", "gate_proj"),
+)
+
+# The names exllamav3's qwen3_5 architecture never asks for; convert only needs the text tower.
+DROP = re.compile(r"^(model\.visual\.|model\.language_model\.visual\.|model\.mtp\.|mtp\.)")
+
+
+def linear_keys(source: str) -> list[str]:
+    """Every tensor name in `source` that ends this model's layout, without `.weight`; reads headers only."""
+    names: list[str] = []
+    index = os.path.join(source, "model.safetensors.index.json")
+    if os.path.exists(index):
+        with open(index, encoding="utf8") as f:
+            names = list(json.load(f)["weight_map"].keys())
+    else:
+        from safetensors import safe_open
+
+        for name in sorted(os.listdir(source)):
+            if not name.endswith(".safetensors"):
+                continue
+            with safe_open(os.path.join(source, name), framework="pt", device="cpu") as f:
+                names += list(f.keys())
+    keys = []
+    for name in names:
+        if DROP.match(name) or not name.endswith(".weight"):
+            continue
+        key = name[: -len(".weight")]
+        if key == HEAD or LAYOUT.search(key):
+            keys.append(key)
+    return sorted(set(keys))
+
+
+def group_of(key: str) -> tuple[str, str]:
+    """The capture a key belongs to, and the member whose output the capture replaces (the anchor)."""
+    for pattern, suffix, anchor in SHARED:
+        if pattern.search(key):
+            base = key[: pattern.search(key).start()]
+            return base + suffix, base + suffix + "." + anchor
+    return key, key
+
+
+def key_of(module_name: str, keys: set[str]) -> str | None:
+    """The checkpoint key a module path names, tolerating a wrapper prefix on either side."""
+    if module_name in keys:
+        return module_name
+    hits = [k for k in keys if k.endswith("." + module_name) or module_name.endswith("." + k)]
+    return hits[0] if len(hits) == 1 else None
+
+
+def calibration_rows(shim: str, rows: int, cols: int, extra: str | None) -> list[torch.Tensor]:
+    """exllamav3's default corpus through its own config and tokenizer of the shim, as convert_model.py builds them."""
+    if extra:
+        sys.path.insert(0, extra)
+    try:
+        from exllamav3 import Config, Tokenizer
+        from exllamav3.conversion.calibration_data import get_default_calibration
+    except ImportError as err:
+        raise SystemExit(f"exllamav3 is not importable ({err}); pass --exllamav3 DIR or use its venv") from err
+    tokenizer = Tokenizer.from_config(Config.from_directory(shim))
+    return get_default_calibration({"cal_rows": rows, "cal_cols": cols}, tokenizer)
+
+
+def load_model(source: str, device: str):
+    """The BF16 reference as its config names it, refusing any load that leaves a weight uninitialised."""
+    import transformers
+
+    with open(os.path.join(source, "config.json"), encoding="utf8") as f:
+        config = json.load(f)
+    if "AutoModelForCausalLM" in config.get("auto_map", {}):
+        cls = transformers.AutoModelForCausalLM  # SenseNova's own modeling file, through trust_remote_code
+    else:
+        cls = getattr(transformers, config["architectures"][0])
+    model, info = cls.from_pretrained(source, trust_remote_code=True, dtype=torch.bfloat16, device_map={"": device},
+                                      output_loading_info=True)
+    missing = [k for k in info.get("missing_keys", []) if "visual" not in k and "mtp" not in k]
+    if missing:
+        raise SystemExit(f"{len(missing)} weights were not in the checkpoint (first: {missing[0]}); refusing random ones")
+    model.eval()
+    return model
+
+
+def backbone_of(model):
+    """The text tower: the module holding embed_tokens, the layer list and the final norm (no LM head)."""
+    for _, module in model.named_modules():
+        if hasattr(module, "embed_tokens") and hasattr(module, "layers") and hasattr(module, "norm"):
+            return module
+    raise SystemExit("no text backbone found (embed_tokens + layers + norm): is this a Qwen3.5 checkpoint?")
+
+
+class Capture:
+    """One Hessian accumulator per group, fed by pre-hooks on the group's anchor and by the final norm."""
+
+    def __init__(self, groups: dict[str, list[tuple[str, str]]], widths: dict[str, int]):
+        self.groups = groups
+        self.widths = widths
+        self.H = {}
+        self.count = {}
+
+    def add(self, group: str, x: torch.Tensor):
+        x = x.reshape(-1, x.shape[-1])
+        if x.shape[-1] != self.widths[group]:
+            raise SystemExit(f"{group}: {x.shape[-1]} inputs, expected {self.widths[group]}")
+        x = x.float()
+        finite = torch.isfinite(x).all(dim=1)
+        if not finite.all():
+            x = x[finite]
+        if group not in self.H:
+            n = x.shape[-1]
+            self.H[group] = torch.zeros(n, n, dtype=torch.float32, device=x.device)
+            self.count[group] = 0
+        self.H[group].addmm_(x.T, x)
+        self.count[group] += x.shape[0]
+
+
+def capture(model, keys: list[str], batches: list[torch.Tensor], device: str) -> Capture:
+    modules = dict(model.named_modules())
+    groups: dict[str, list[tuple[str, str]]] = {}
+    anchors: dict[str, tuple[object, str]] = {}
+    widths: dict[str, int] = {}
+    for key in keys:
+        group, anchor_key = group_of(key)
+        groups.setdefault(group, []).append((key, anchor_key))
+    for group, members in groups.items():
+        anchor_key = members[0][1]
+        anchor_name = next((n for n in modules if key_of(n, {anchor_key})), None)
+        if anchor_name is None:
+            raise SystemExit(f"{anchor_key}: no module names this capture's anchor")
+        widths[group] = modules[anchor_name].in_features
+        if group == HEAD:
+            continue
+        anchors[group] = (modules[anchor_name], anchor_key)
+    backbone = backbone_of(model)
+    cap = Capture(groups, widths)
+
+    def pre_hook(group):
+        def hook(_module, args, kwargs):
+            x = args[0] if args else kwargs.get("hidden_states")
+            if x is None:
+                raise SystemExit(f"{group}: the hook saw no input")
+            cap.add(group, x)
+
+        return hook
+
+    def head_hook(_module, _args, output):
+        x = output[0] if isinstance(output, (tuple, list)) else output
+        cap.add(HEAD, x)
+
+    handles = [module.register_forward_pre_hook(pre_hook(group), with_kwargs=True) for group, (module, _) in anchors.items()]
+    if HEAD in groups:
+        handles.append(backbone.norm.register_forward_hook(head_hook))
+    try:
+        with torch.no_grad():
+            for i, ids in enumerate(batches):
+                backbone(input_ids=ids.to(device), use_cache=False)
+                print(f"  calibration batch {i + 1}/{len(batches)}", flush=True)
+    finally:
+        for handle in handles:
+            handle.remove()
+    return cap
+
+
+def write(cap: Capture, keys: list[str], out: str):
+    """`{out}/{key}.safetensors` for every key, the packed mean Hessian of its capture."""
+    from safetensors.torch import save_file
+
+    os.makedirs(out, exist_ok=True)
+    written: dict[str, str] = {}
+    total = 0
+    for key in keys:
+        group, _ = group_of(key)
+        if group not in cap.H:
+            raise SystemExit(f"{key}: no calibration reached {group}")
+        H, count = cap.H[group], cap.count[group]
+        if count == 0:
+            raise SystemExit(f"{key}: no finite activations")
+        path = os.path.join(out, key + ".safetensors")
+        if group not in written:
+            n = H.shape[0]
+            mask = torch.ones(n, n, dtype=torch.bool, device=H.device).triu()
+            packed = (H / count)[mask].to(torch.float32).cpu().contiguous()
+            save_file({"hin": packed}, path, metadata={"tokens": str(count), "calibration": "sensenova-loop-hessian"})
+            total += packed.numel() * 4
+            written[group] = path
+        else:
+            with open(written[group], "rb") as f:
+                data = f.read()
+            with open(path, "wb") as f:
+                f.write(data)
+        print(f"  {key}: {H.shape[0]}x{H.shape[0]}, {count} tokens")
+    return total
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--source", required=True, help="the BF16 model directory (SenseNova or stock Qwen3.5-9B)")
+    parser.add_argument("--shim", required=True, help="exl3_attach_sensenova.py's shim of --source (tokenizer, config)")
+    parser.add_argument("--out", required=True, help="the Hessian directory convert_model.py --hessians reads")
+    parser.add_argument("--device", default="cuda:0")
+    parser.add_argument("--cal-rows", type=int, default=250, help="exllamav3's default calibration rows")
+    parser.add_argument("--cal-cols", type=int, default=2048, help="exllamav3's default calibration columns")
+    parser.add_argument("--batch-rows", type=int, default=8, help="calibration rows per forward (memory)")
+    parser.add_argument("--exllamav3", default=None, help="an exllamav3 checkout to import (else the venv's)")
+    parser.add_argument("--plan-only", action="store_true", help="print the capture plan and exit without a model")
+    args = parser.parse_args()
+
+    keys = linear_keys(args.source)
+    if not keys:
+        raise SystemExit(f"no EXL3 linears in {args.source}'s tensors: is this a Qwen3.5 checkpoint?")
+    if args.plan_only:
+        for key in keys:
+            group, _ = group_of(key)
+            print(f"{key} <- {group}")
+        return 0
+
+    rows = calibration_rows(args.shim, args.cal_rows, args.cal_cols, args.exllamav3)
+    batches = [torch.cat(rows[i : i + args.batch_rows], dim=0) for i in range(0, len(rows), args.batch_rows)]
+    print(f"{len(keys)} tensors, {len(rows)} calibration rows of {args.cal_cols} tokens", flush=True)
+
+    model = load_model(args.source, args.device)
+    cap = capture(model, keys, batches, args.device)
+    total = write(cap, keys, args.out)
+    print(f"wrote {args.out}: {total / 1e9:.1f} GB of packed Hessians")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
