diff --git a/zig/src/families/qwen3_5/cuda_exl3_dtype.zig b/zig/src/families/qwen3_5/cuda_exl3_dtype.zig
new file mode 100644
index 000000000..11a71159e
--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_exl3_dtype.zig
@@ -0,0 +1,92 @@
+//! The dtypes an EXL3 checkpoint keeps beside its trellis: what each vector's kernels read, and the one conversion.
+const std = @import("std");
+const core = @import("core");
+
+const Tensor = core.checkpoint.Tensor;
+
+/// What the kernels read a vector as: f32 words (A_log) or bf16 (norms, dt_bias, in_proj_a/b).
+pub const Want = enum { f32, bf16 };
+
+/// Where a tensor's elements come from: bf16 widened to f32 words, f32 or f16 rounded to bf16, or as stored.
+pub const From = enum { stored, bf16, f32, f16 };
+
+/// How `t`, holding `shape`'s elements, serves `want`; `error.UnexpectedTensor` for any other dtype or shape.
+pub fn accept(t: Tensor, want: Want, shape: []const usize) !From {
+    return switch (want) {
+        .f32 => if (t.is(.f32, shape)) .stored else if (t.is(.bf16, shape)) .bf16 else error.UnexpectedTensor,
+        .bf16 => if (t.is(.bf16, shape)) .stored else if (t.is(.f32, shape)) .f32 else if (t.is(.f16, shape)) .f16 else error.UnexpectedTensor,
+    };
+}
+
+/// bf16 words as the f32 words the kernels read: a bit shift, exact.
+pub fn widen(out: []u32, bytes: []const u8) void {
+    for (out, std.mem.bytesAsSlice(u16, bytes)) |*w, h| w.* = @as(u32, h) << 16;
+}
+
+/// bf16 of `from`'s words: f32 through the load's rounding (bf16vec's), f16 through the cast's (bits()).
+pub fn round(out: []u16, bytes: []const u8, from: From) void {
+    switch (from) {
+        .f32 => core.bf16_round.words(out, bytes),
+        .f16 => for (out, std.mem.bytesAsSlice(u16, bytes)) |*o, h| {
+            o.* = core.bf16_round.bits(@floatCast(@as(f16, @bitCast(h))));
+        },
+        else => unreachable,
+    }
+}
+
+fn tensor(comptime dtype: core.checkpoint.DType, shape: []const usize, bytes: []const u8) Tensor {
+    var t: Tensor = std.mem.zeroes(Tensor);
+    t.dtype = dtype;
+    t.rank = @intCast(shape.len);
+    @memcpy(t.shape[0..shape.len], shape);
+    t.bytes = bytes;
+    return t;
+}
+
+test "EXL3 dtypes: accepted ones and the refusal of every other" {
+    var bytes: [8]u8 = @splat(0);
+    const shape: []const usize = &.{4};
+    try std.testing.expectEqual(From.stored, try accept(tensor(.f32, shape, &bytes), .f32, shape));
+    try std.testing.expectEqual(From.bf16, try accept(tensor(.bf16, shape, &bytes), .f32, shape));
+    try std.testing.expectError(error.UnexpectedTensor, accept(tensor(.f16, shape, &bytes), .f32, shape));
+    try std.testing.expectEqual(From.stored, try accept(tensor(.bf16, shape, &bytes), .bf16, shape));
+    try std.testing.expectEqual(From.f32, try accept(tensor(.f32, shape, &bytes), .bf16, shape));
+    try std.testing.expectEqual(From.f16, try accept(tensor(.f16, shape, &bytes), .bf16, shape));
+    // the shape and rank are part of the acceptance, not only the dtype
+    try std.testing.expectError(error.UnexpectedTensor, accept(tensor(.f32, shape, &bytes), .bf16, &.{ 2, 2 }));
+}
+
+test "EXL3 dtypes: the conversions equal the earlier spellings byte for byte" {
+    var prng = std.Random.DefaultPrng.init(1210);
+    const old = struct {
+        fn f32ToBf16(f: f32) u16 {
+            const b: u32 = @bitCast(f);
+            return @truncate((b +% 0x7fff +% ((b >> 16) & 1)) >> 16);
+        }
+        fn f16ToBf16(h: u16) u16 {
+            return core.bf16_round.bits(@floatCast(@as(f16, @bitCast(h))));
+        }
+    };
+    var wide: [256]f32 = undefined;
+    var half: [256]u16 = undefined;
+    var out: [256]u16 = undefined;
+    var words: [256]u32 = undefined;
+    for (0..4) |_| {
+        for (&wide, &half) |*w, *h| {
+            const u = prng.random().int(u32);
+            w.* = @bitCast(u);
+            h.* = @truncate(u);
+        }
+        round(&out, std.mem.sliceAsBytes(&wide), .f32);
+        for (out, wide) |o, f| try std.testing.expectEqual(old.f32ToBf16(f), o);
+        round(&out, std.mem.sliceAsBytes(&half), .f16);
+        for (out, half) |o, h| try std.testing.expectEqual(old.f16ToBf16(h), o);
+    }
+    // A_log's widening keeps the stored bits: bf16 -> f32 -> bf16 is the identity
+    widen(&words, std.mem.sliceAsBytes(&half));
+    for (half, words) |h, w| try std.testing.expectEqual(@as(u32, h) << 16, w);
+    // a negative NaN word stays NaN through the f16 cast, as bits() does
+    var one: [1]u16 = undefined;
+    round(&one, std.mem.sliceAsBytes(&[_]u16{0xfe00}), .f16);
+    try std.testing.expect(std.math.isNan(core.bf16_round.value(one[0])));
+}
